slider81:0<0,12,1{Free,1/32,1/16T,1/16,1/8T,1/8,1/4T,1/4,1/2T,1/2,1 bar,2 bars,4 bars}>-Spectral Gate: Auto Sweep Sync
slider82:3<0,24,0.1>-Spectral Gate: Hysteresis (dB)
slider83:40<0,1000,1>-Spectral Gate: Hold (ms)
slider84:0<0,6,1{Free,Sine,Triangle,Rectangle,Saw Up,Saw Down,Random Steps}>-Spectral Gate: Curve A Shape
slider85:0<0,6,1{Free,Sine,Triangle,Rectangle,Saw Up,Saw Down,Random Steps}>-Spectral Gate: Curve B Shape
slider86:0<-12,24,0.1>-Spectral Gate: Makeup (dB)
slider87:0<0,1,1{Filter,Gate}>-LFO 1: Target Bank
slider88:0<0,1,1{Filter,Gate}>-LFO 2: Target Bank
slider89:0<0,1,1{Filter,Gate}>-LFO 3: Target Bank
slider90:0<0,1,1{Filter,Gate}>-LFO 4: Target Bank
slider91:0<-24,24,0.1>-Spectral Gate: Detector Gain (dB)
slider92:0<0,1,1{Filter then Gate,Gate then Filter}>-Routing: Spectral Order

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:gfx_hz=60 no_meter
filename:0,JSchwartz_Emerald_Valley_16Bit_Natural_Rainbow.png

@init

  ext_noinit = 1;
  fftsize = -1;
  stft_hop_position = 0;
  stft_start_frame = 0;

  // FFT/IFFT blocks must not cross REAPER's 65,536-slot memory pages.
  // Four page-aligned complex frames per channel provide a fixed N/4 hop.
  stft_window = 0;
  stft_frame_stride = 65536;
  left_frames = 65536;
  right_frames = 327680;
  held_left = 589824;
  held_right = 655360;

  // Independent drawable curve pairs for the spectral filter and gate.
  shape_point_count = 512;
  shape_a = 720896;
  shape_b = shape_a + shape_point_count;
  left_magnitude = shape_b + shape_point_count;
  right_magnitude = left_magnitude + 16385;
  spectral_response_db = right_magnitude + 16385;
  spectral_response_velocity = spectral_response_db + 16385;
  gate_shape_a = spectral_response_velocity + 16385;
  gate_shape_b = gate_shape_a + shape_point_count;
  !shape_initialized ? (
    memset(shape_a, 0, shape_point_count);
    memset(shape_b, 0, shape_point_count);
    shape_initialized = 1;
  );
  !gate_shape_initialized ? (
    memset(gate_shape_a, 0, shape_point_count);
    memset(gate_shape_b, 0, shape_point_count);
    gate_shape_initialized = 1;
  );
  active_shape = 0;
  last_shape_mode_a = slider62 | 0;
  last_shape_mode_b = slider63 | 0;
  last_gate_shape_mode_a = slider84 | 0;
  last_gate_shape_mode_b = slider85 | 0;
  last_draw_index = -1;
  spectral_response_initialized = 0;
  spectral_warble_phase = 0;

  // Two stereo delay lines. Each frame stores interleaved left/right samples.
  // Up to eight seconds per stereo delay covers four bars at 120 BPM. Cap the
  // allocation so very high sample rates remain inside JSFX's memory ceiling.
  delay_buffer_frames = min(1500000, ceil(srate * 8.05) + 8);
  pre_delay_buffer = 851968;
  post_delay_buffer = pre_delay_buffer + 2*delay_buffer_frames + 8;
  diffusion_buffer_frames = ceil(srate * 0.06) + 8;
  pre_diffusion_a_buffer = post_delay_buffer + 2*delay_buffer_frames + 8;
  pre_diffusion_b_buffer = pre_diffusion_a_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_a_buffer = pre_diffusion_b_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_b_buffer = post_diffusion_a_buffer + 2*diffusion_buffer_frames + 8;
  pre_diffusion_c_buffer = post_diffusion_b_buffer + 2*diffusion_buffer_frames + 8;
  pre_diffusion_d_buffer = pre_diffusion_c_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_c_buffer = pre_diffusion_d_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_d_buffer = post_diffusion_c_buffer + 2*diffusion_buffer_frames + 8;
  memset(pre_delay_buffer, 0, 2*delay_buffer_frames);
  memset(post_delay_buffer, 0, 2*delay_buffer_frames);
  memset(pre_diffusion_a_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_b_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_a_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_b_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_c_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_d_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_c_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_d_buffer, 0, 2*diffusion_buffer_frames);
  pre_write_frame = 0;
  post_write_frame = 0;
  pre_diffusion_write_frame = 0;
  post_diffusion_write_frame = 0;
  pre_delay_left_current = 0;
  pre_delay_right_current = 0;
  post_delay_left_current = 0;
  post_delay_right_current = 0;
  pre_feedback_state_left = 0;
  pre_feedback_state_right = 0;
  post_feedback_state_left = 0;
  post_feedback_state_right = 0;
  pre_fx_character = 0;
  pre_fx_spread = 0;
  pre_fx_mix = 1;
  pre_fx_filter_left = 0;
  pre_fx_filter_right = 0;
  pre_fx_low_state_left = 0;
  pre_fx_low_state_right = 0;
  pre_fx_high_state_left = 0;
  pre_fx_high_state_right = 0;
  pre_fx_hold_counter_left = 0;
  pre_fx_hold_counter_right = 0;
  pre_fx_held_left = 0;
  pre_fx_held_right = 0;
  auto_sweep_phase = 0;
  gate_auto_sweep_phase = 0;
  lfo1_phase = 0;
  lfo2_phase = 0.25;
  lfo3_phase = 0.5;
  lfo4_phase = 0.75;
  lfo1_random = rand(2) - 1;
  lfo2_random = rand(2) - 1;
  lfo3_random = rand(2) - 1;
  lfo4_random = rand(2) - 1;
  lfo1_value = 0;
  lfo2_value = 0;
  lfo3_value = 0;
  lfo4_value = 0;
  ui_page = 0;
  // Help is UI-only. Keep it through transport-triggered @init calls without
  // adding a host parameter or storing it in projects and Lucky Slots.
  help_ui_sentinel != 52017 ? (
    help_mode = 0;
    help_ui_sentinel = 52017;
  );
  active_spectral_order = slider92 >= 0.5;
  tab_drag_id = 0;
  tab_drag_moved = 0;
  tab_drag_preview_order = active_spectral_order;
  preset_slot_count = 8;
  // Routing-aware Lucky Slots are appended in the unused gap below the delay
  // buffers. Keeping this sidecar separate preserves every older preset stride
  // and all existing gate-envelope addresses.
  routing_preset_data = gate_shape_b + shape_point_count + 64;
  routing_preset_valid = routing_preset_data + preset_slot_count;
  !routing_preset_initialized ? (
    memset(routing_preset_data, 0, preset_slot_count);
    memset(routing_preset_valid, 0, preset_slot_count);
    routing_preset_initialized = 1;
  );
  preset_parameter_count = 60;
  preset_stride = preset_parameter_count + shape_point_count*2;
  preset_data = post_diffusion_d_buffer + 2*diffusion_buffer_frames + 64;
  preset_valid = preset_data + preset_slot_count*preset_stride;
  // Preserve the legacy 1-60 preset block byte-for-byte. New parameters and
  // gate curves live in an appended, independently-valid extension bank.
  extended_preset_first = 61;
  extended_preset_parameter_count = 31;
  extended_preset_stride = extended_preset_parameter_count + shape_point_count*2;
  extended_preset_data = preset_valid + preset_slot_count + 64;
  extended_preset_valid = extended_preset_data
                          + preset_slot_count*extended_preset_stride;
  !extended_preset_initialized ? (
    memset(extended_preset_data, 0,
           preset_slot_count*extended_preset_stride);
    memset(extended_preset_valid, 0, preset_slot_count);
    extended_preset_initialized = 1;
  );

  // Six per-bin arrays support independent L/R envelopes, hold counters, and
  // non-destructive spectral smoothing targets at the maximum 32768 FFT size.
  gate_gain_left = extended_preset_valid + preset_slot_count + 64;
  gate_gain_right = gate_gain_left + 16385;
  gate_hold_left = gate_gain_right + 16385;
  gate_hold_right = gate_hold_left + 16385;
  gate_target_left = gate_hold_right + 16385;
  gate_target_right = gate_target_left + 16385;
  !gate_state_initialized ? (
    memset(gate_gain_left, 0, 16385);
    memset(gate_gain_right, 0, 16385);
    memset(gate_hold_left, 0, 16385);
    memset(gate_hold_right, 0, 16385);
    memset(gate_target_left, 0, 16385);
    memset(gate_target_right, 0, 16385);
    gate_state_initialized = 1;
  );
  // Numeric string slots 100-107 hold names; audio/preset data stays in RAM.
  preset_names = 100;
  preset_selected = 0;
  preset_editing_name = 0;
  preset_name_select_all = 0;
  preset_edit_just_focused = 0;
  preset_name_max_length = 31;
  #preset_name_input = "Lucky Charm";
  last_knob_click_index = -1;
  last_knob_click_time = -10;

  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  function smooth_step(value) local(x) (
    x = min(1, max(0, value));
    x*x*(3 - 2*x);
  );

  function lfo_wave(shape, phase_value, random_value) local(wave_value) (
    shape == 0 ? wave_value = sin(2*$pi*phase_value);
    shape == 1 ? wave_value = 1 - 4*abs(phase_value - 0.5);
    shape == 2 ? (
      phase_value < 0.5 ? wave_value = 1 : wave_value = -1;
    );
    shape == 3 ? wave_value = phase_value*2 - 1;
    shape == 4 ? wave_value = 1 - phase_value*2;
    shape == 5 ? wave_value = random_value;
    wave_value;
  );

  // Generated curves span three cycles across the logarithmic 20 Hz-20 kHz
  // graph. FREE (mode 0) deliberately leaves the existing hand-drawn data.
  function generate_spectral_shape(buffer, mode)
    local(index, normalized, phase_value, wave_value, step_index,
          previous_step, random_value) (
    mode > 0 ? (
      index = 0;
      previous_step = -1;
      random_value = 0;
      loop(shape_point_count,
        normalized = index/max(1, shape_point_count - 1);
        phase_value = normalized*3;
        phase_value -= floor(phase_value);
        mode == 1 ? wave_value = sin(2*$pi*phase_value);
        mode == 2 ? wave_value = 1 - 4*abs(phase_value - 0.5);
        mode == 3 ? (phase_value < 0.5 ? wave_value = 1 : wave_value = -1;);
        mode == 4 ? wave_value = phase_value*2 - 1;
        mode == 5 ? wave_value = 1 - phase_value*2;
        mode == 6 ? (
          step_index = floor(min(0.999999, normalized)*16);
          step_index != previous_step ? (
            random_value = rand(2) - 1;
            previous_step = step_index;
          );
          wave_value = random_value;
        );
        buffer[index] = min(12, max(-60, -18 + wave_value*24));
        index += 1;
      );
    );
  );

  // Returns the selected note length in quarter notes. Zero means free time.
  function sync_quarters(mode) (
    mode == 1 ? 0.125 : mode == 2 ? 1/6 : mode == 3 ? 0.25 :
    mode == 4 ? 1/3 : mode == 5 ? 0.5 : mode == 6 ? 2/3 :
    mode == 7 ? 1 : mode == 8 ? 4/3 : mode == 9 ? 2 :
    mode == 10 ? 4 : mode == 11 ? 8 : mode == 12 ? 16 : 0;
  );

  function sync_seconds(mode) local(q) (
    q = sync_quarters(mode);
    q > 0 ? q*60/max(1, tempo) : 0;
  );

  function sync_rate(mode, free_rate) local(seconds) (
    seconds = sync_seconds(mode);
    seconds > 0 ? 1/seconds : free_rate;
  );

  function nearest_sync_mode(seconds) local(mode, best_mode, distance, best_distance) (
    best_mode = 1;
    best_distance = 1000000;
    mode = 1;
    loop(12,
      distance = abs(sync_seconds(mode) - seconds);
      distance < best_distance ? (best_distance = distance; best_mode = mode;);
      mode += 1;
    );
    best_mode;
  );

  // Mirrors the defaults declared in the slider header for every rotary
  // control. Selectors and toggle buttons retain their own interaction model.
  function knob_factory_default(index) local(default_value) (
    default_value = 0;
    index == 1 ? default_value = 30;
    index == 2 ? default_value = 18000;
    index == 3 ? default_value = 1;
    index == 6 ? default_value = 1;
    index == 14 ? default_value = 0.2;
    index == 15 ? default_value = 220;
    index == 16 ? default_value = 330;
    index == 17 ? default_value = 35;
    index == 18 ? default_value = 50;
    index == 19 ? default_value = 20;
    index == 21 ? default_value = 375;
    index == 22 ? default_value = 500;
    index == 23 ? default_value = 40;
    index == 24 ? default_value = 70;
    index == 25 ? default_value = 25;
    index == 31 ? default_value = 6;
    index == 32 ? default_value = 12;
    index == 33 ? default_value = 6;
    index == 36 ? default_value = 0.5;
    index == 40 ? default_value = 0.33;
    index == 44 ? default_value = 0.2;
    index == 48 ? default_value = 0.125;
    index == 61 ? default_value = 100;
    index == 65 ? default_value = -48;
    index == 66 ? default_value = 60;
    index == 67 ? default_value = 10;
    index == 68 ? default_value = 180;
    index == 69 ? default_value = 6;
    index == 70 ? default_value = 20;
    index == 71 ? default_value = 20000;
    index == 72 ? default_value = 1;
    index == 74 ? default_value = 100;
    index == 75 ? default_value = 25;
    index == 76 ? default_value = 100;
    index == 80 ? default_value = 0.2;
    index == 82 ? default_value = 3;
    index == 83 ? default_value = 40;
    default_value;
  );

  // JSFX strings are length-counted rather than NUL-terminated. Truncate by
  // copying a substring so Backspace/Delete genuinely releases characters.
  function set_preset_name_length(new_length) local(current_length) (
    current_length = strlen(#preset_name_input);
    new_length = min(current_length, max(0, floor(new_length)));
    new_length <= 0 ? strcpy(#preset_name_input, "") : (
      strcpy_substr(#preset_name_scratch, #preset_name_input, 0, new_length);
      strcpy(#preset_name_input, #preset_name_scratch);
    );
  );

  // Older builds could save embedded zero bytes into a name. Keep the visible
  // part and discard the hidden bytes before editing or saving it again.
  function sanitize_preset_name() local(total_length, visible_length) (
    total_length = strlen(#preset_name_input);
    visible_length = 0;
    while (visible_length < total_length
           && str_getchar(#preset_name_input, visible_length) != 0) (
      visible_length += 1;
    );
    visible_length < total_length ? set_preset_name_length(visible_length);
    visible_length;
  );

  function store_user_preset(slot) local(base, extended_base, i) (
    base = preset_data + slot*preset_stride;
    i = 1;
    loop(preset_parameter_count, base[i - 1] = slider(i); i += 1;);
    memcpy(base + preset_parameter_count, shape_a, shape_point_count);
    memcpy(base + preset_parameter_count + shape_point_count, shape_b, shape_point_count);
    preset_valid[slot] = 1;

    extended_base = extended_preset_data + slot*extended_preset_stride;
    i = 0;
    loop(extended_preset_parameter_count,
      extended_base[i] = slider(extended_preset_first + i);
      i += 1;
    );
    memcpy(extended_base + extended_preset_parameter_count,
           gate_shape_a, shape_point_count);
    memcpy(extended_base + extended_preset_parameter_count + shape_point_count,
           gate_shape_b, shape_point_count);
    extended_preset_valid[slot] = 1;
    routing_preset_data[slot] = slider92 >= 0.5;
    routing_preset_valid[slot] = 1;
    sanitize_preset_name();
    strcpy(preset_names + slot, #preset_name_input);
    preset_last_saved_slot = slot;
    preset_save_notice_frames = 240;
    sliderchange(-1);
  );

  function recall_user_preset(slot) local(base, extended_base, i) (
    preset_valid[slot] ? (
      base = preset_data + slot*preset_stride;
      i = 1;
      loop(preset_parameter_count, slider_automate(slider(i) = base[i - 1]); i += 1;);
      memcpy(shape_a, base + preset_parameter_count, shape_point_count);
      memcpy(shape_b, base + preset_parameter_count + shape_point_count, shape_point_count);
      // Lucky Slots predate generated modes and store exact curve data, so
      // recalled curves return to FREE for immediate hand editing.
      slider_automate(slider62 = 0);
      slider_automate(slider63 = 0);
      last_shape_mode_a = 0;
      last_shape_mode_b = 0;

      extended_preset_valid[slot] ? (
        extended_base = extended_preset_data + slot*extended_preset_stride;
        i = 0;
        loop(extended_preset_parameter_count,
          slider_automate(slider(extended_preset_first + i) = extended_base[i]);
          i += 1;
        );
        memcpy(gate_shape_a,
               extended_base + extended_preset_parameter_count,
               shape_point_count);
        memcpy(gate_shape_b,
               extended_base + extended_preset_parameter_count + shape_point_count,
               shape_point_count);
        last_shape_mode_a = slider62 | 0;
        last_shape_mode_b = slider63 | 0;
        last_gate_shape_mode_a = slider84 | 0;
        last_gate_shape_mode_b = slider85 | 0;
      );
      routing_preset_valid[slot] ? (
        slider_automate(slider92 = routing_preset_data[slot] >= 0.5);
      );
      strcpy(#preset_name_input, preset_names + slot);
      sanitize_preset_name();
      sliderchange(-1);
    );
  );

  // Gate targets use a compatibility-safe second bank, keeping the original
  // 0-33 Filter target values and their existing automation normalization.
  function gate_target_slider(target) (
    target == 1 ? 64 : target == 2 ? 65 : target == 3 ? 66
    : target == 4 ? 67 : target == 5 ? 68 : target == 6 ? 69
    : target == 7 ? 70 : target == 8 ? 71 : target == 9 ? 72
    : target == 10 ? 73 : target == 11 ? 74 : target == 12 ? 75
    : target == 13 ? 76 : target == 14 ? 77 : target == 15 ? 78
    : target == 16 ? 79 : target == 17 ? 80 : target == 18 ? 82
    : target == 19 ? 83 : target == 20 ? 86 : target == 21 ? 91 : 0;
  );

  function lfo_targets_parameter(target_index, bank_index, parameter_index)
    local(target) (
    target = slider(target_index) | 0;
    slider(bank_index) < 0.5
      ? target == parameter_index
      : gate_target_slider(target) == parameter_index;
  );

  // Modulation is summed in normalized parameter space, then clamped to the
  // original control range. Full depth is one half of a control's total span,
  // keeping feedback, output, and delay targets inside their established limits.
  function modulated_parameter(parameter_index, minimum, maximum, step)
    local(value, modulation, range) (
    value = slider(parameter_index);
    modulation = 0;
    lfo_targets_parameter(34, 87, parameter_index)
      ? modulation += lfo1_value*slider37/100;
    lfo_targets_parameter(38, 88, parameter_index)
      ? modulation += lfo2_value*slider41/100;
    lfo_targets_parameter(42, 89, parameter_index)
      ? modulation += lfo3_value*slider45/100;
    lfo_targets_parameter(46, 90, parameter_index)
      ? modulation += lfo4_value*slider49/100;
    range = maximum - minimum;
    value += modulation*range*0.5;
    step > 0 ? value = minimum + floor((value - minimum)/step + 0.5)*step;
    min(maximum, max(minimum, value));
  );

  function shape_db_at(frequency)
    local(shifted_frequency, normalized_position, scaled_position,
          index_a, index_b, fraction, value_a, value_b) (
    shifted_frequency = frequency / (2 ^ shape_total_shift_octaves);
    normalized_position = log(max(20, min(20000, shifted_frequency)) / 20)
                          / log(20000 / 20);
    scaled_position = normalized_position * (shape_point_count - 1);
    index_a = floor(scaled_position);
    index_b = min(shape_point_count - 1, index_a + 1);
    fraction = scaled_position - index_a;
    value_a = shape_a[index_a]*(1 - fraction) + shape_a[index_b]*fraction;
    value_b = shape_b[index_a]*(1 - fraction) + shape_b[index_b]*fraction;
    value_a + (value_b - value_a)*shape_morph;
  );

  function gate_shape_db_at(frequency)
    local(shifted_frequency, normalized_position, scaled_position,
          index_a, index_b, fraction, value_a, value_b) (
    shifted_frequency = frequency / (2 ^ gate_shape_total_shift_octaves);
    normalized_position = log(max(20, min(20000, shifted_frequency)) / 20)
                          / log(20000 / 20);
    scaled_position = normalized_position * (shape_point_count - 1);
    index_a = floor(scaled_position);
    index_b = min(shape_point_count - 1, index_a + 1);
    fraction = scaled_position - index_a;
    value_a = gate_shape_a[index_a]*(1 - fraction) + gate_shape_a[index_b]*fraction;
    value_b = gate_shape_b[index_a]*(1 - fraction) + gate_shape_b[index_b]*fraction;
    value_a + (value_b - value_a)*gate_shape_morph;
  );

  function spectral_gain(frequency) local(gain, position_in_edge, tilt_db, draw_db) (
    gain = 1;

    frequency <= 0 ? (
      gain = 0;
    ) : (
      frequency < low_hz ? (
        position_in_edge = log(frequency / low_edge_start) / log(2) / edge_octaves;
        gain *= smooth_step(position_in_edge);
      );

      frequency > high_hz ? (
        position_in_edge = 1 - log(frequency / high_hz) / log(2) / edge_octaves;
        gain *= smooth_step(position_in_edge);
      );

      tilt_db = tilt_db_per_octave * log(frequency / 1000) / log(2);
      tilt_db = min(36, max(-60, tilt_db));
      // Expand the hand-drawn response around 0 dB without moving its neutral point.
      // The asymmetric limits keep boosts bold but controlled while allowing
      // near-silent spectral notches at the bottom of the drawing area.
      draw_db = shape_db_at(frequency) * 1.65;
      draw_db = min(20, max(-96, draw_db));
      gain *= exp((tilt_db + draw_db) * log(10) / 20);
    );

    gain;
  );

  // ReaFIR's characteristic nonlinear FFT mode is most audible while its
  // response is changing. Model that character as a stable, underdamped
  // per-bin response. The coefficient is hop-time aware, so larger FFT sizes
  // naturally move more slowly without destabilizing the spring.
  function update_spectral_response()
    local(frame_seconds, response_rate_hz, angular_rate, damping, decay,
          bin, frequency, target_gain, target_db, current_db, velocity_db,
          spectral_warble_rate) (
    frame_seconds = stft_hop_size / srate;
    response_rate_hz = min(4.5, 0.14/max(0.000001, frame_seconds));
    angular_rate = 2*$pi*response_rate_hz;
    damping = 0.40;
    decay = exp(-2*damping*angular_rate*frame_seconds);

    bin = 0;
    loop(fftsize / 2 + 1,
      frequency = bin*srate/fftsize;
      target_gain = spectral_gain(frequency);
      target_db = target_gain > 0.000001
                  ? 20*log(target_gain)/log(10) : -120;
      current_db = spectral_response_db[bin];
      velocity_db = spectral_response_velocity[bin];

      !spectral_response_initialized ? (
        current_db = target_db;
        velocity_db = 0;
      ) : (
        velocity_db += (target_db - current_db)
                       * angular_rate*angular_rate*frame_seconds;
        velocity_db *= decay;
        velocity_db = min(360, max(-360, velocity_db));
        current_db += velocity_db*frame_seconds;
        current_db = min(72, max(-144, current_db));
      );

      spectral_response_db[bin] = current_db;
      spectral_response_velocity[bin] = velocity_db;
      bin += 1;
    );
    spectral_response_initialized = 1;

    spectral_warble_rate = min(3.6, 0.22/max(0.000001, frame_seconds));
    spectral_warble_phase += spectral_warble_rate*frame_seconds;
    spectral_warble_phase -= floor(spectral_warble_phase);
  );

  // Operates only on native FFT data after fft_permute(), so every bin is in
  // ascending frequency order. Keep future spectral processors in this domain.
  function shape_sequential_spectrum(block, magnitude_history)
    local(bin, fft_index, mirror_index, frequency, response,
          response_db, neighbor_db, precision_db,
          real_value, imaginary_value, magnitude, remembered_magnitude,
          shaped_magnitude, magnitude_db, scale, phase_angle,
          response_motion, warble_angle, cosine_value, sine_value,
          mirror_real, mirror_imaginary) (

    bin = 0;
    fft_index = 0;
    loop(fftsize / 2 + 1,
      frequency = bin * srate / fftsize;
      response_db = spectral_response_db[bin];
      bin > 0 && bin < fftsize / 2 ? (
        neighbor_db = (spectral_response_db[bin - 1]
                       + spectral_response_db[bin + 1])*0.5;
        precision_db = (response_db - neighbor_db)*0.16;
        response_db += min(1.5, max(-1.5, precision_db));
      );
      response = bin == 0 ? 0 : exp(response_db*log(10)/20);
      mirror_index = (bin == 0 || bin == fftsize / 2)
                     ? fft_index : 2*(fftsize - bin);

      real_value = block[fft_index];
      imaginary_value = block[fft_index + 1];
      magnitude = sqrt(real_value*real_value + imaginary_value*imaginary_value);

      remembered_magnitude = magnitude_history[bin];
      remembered_magnitude <= 0 ? remembered_magnitude = magnitude;
      shaped_magnitude = remembered_magnitude*smear_coefficient
                         + magnitude*(1 - smear_coefficient);
      magnitude_history[bin] = shaped_magnitude;

      grain_amount > 0 && shaped_magnitude > 0.000000000001 ? (
        magnitude_db = 20 * log(shaped_magnitude) / log(10);
        magnitude_db = floor(magnitude_db / grain_step_db + 0.5) * grain_step_db;
        shaped_magnitude = exp(magnitude_db * log(10) / 20);
      );

      magnitude > 0.000000000001 ? (
        scale = response * min(16, shaped_magnitude / magnitude);
      ) : (
        scale = 0;
      );

      phase_angle = bin > 0 && bin < fftsize / 2
                    ? (rand(2) - 1) * $pi * phase_scatter_amount : 0;
      response_motion = min(1, abs(spectral_response_velocity[bin])/90);
      warble_angle = bin > 0 && bin < fftsize / 2
                     ? response_motion*0.42
                       * sin(2*$pi*spectral_warble_phase
                             + 1.35*log(max(20, frequency)/20)/log(2))
                     : 0;
      phase_angle += warble_angle;
      cosine_value = cos(phase_angle);
      sine_value = sin(phase_angle);

      real_value *= scale;
      imaginary_value *= scale;
      block[fft_index] = real_value*cosine_value - imaginary_value*sine_value;
      block[fft_index + 1] = real_value*sine_value + imaginary_value*cosine_value;

      // Matching opposite rotation preserves conjugate symmetry for a real
      // channel. DC and Nyquist are their own mirrors and are written once.
      mirror_index != fft_index ? (
        mirror_real = block[mirror_index] * scale;
        mirror_imaginary = block[mirror_index + 1] * scale;
        block[mirror_index] = mirror_real*cosine_value + mirror_imaginary*sine_value;
        block[mirror_index + 1] = -mirror_real*sine_value + mirror_imaginary*cosine_value;
      );

      fft_index += 2;
      bin += 1;
    );
  );

  function gate_open_amount(level_db, threshold_db, knee_db)
    local(position) (
    knee_db <= 0.0001 ? level_db >= threshold_db : (
      position = (level_db - (threshold_db - knee_db*0.5))/knee_db;
      smooth_step(position);
    );
  );

  // Analyze both raw, sequentially ordered spectra together so 100% stereo
  // link produces identical gain envelopes without collapsing the audio to mono.
  // Targets are frequency-smoothed before hop-aware attack/release smoothing.
  function update_spectral_gate(left_block, right_block)
    local(bin, fft_index, frequency, band_weight, low_start, high_end,
          edge_position, left_real, left_imaginary, right_real, right_imaginary,
          left_magnitude_now, right_magnitude_now, linked_magnitude,
          detector_left, detector_right, level_left_db, level_right_db,
          detector_tilt_db, contour_db, base_threshold_db,
          left_threshold_db, right_threshold_db,
          left_current_db, right_current_db, left_open, right_open,
          hold_frames, left_target_db, right_target_db,
          frame_seconds, attack_coefficient, release_coefficient,
          previous_target, next_target, smoothed_target,
          envelope_coefficient, reduction_sum) (

    frame_seconds = stft_hop_size/max(1, srate);
    attack_coefficient = exp(-frame_seconds/max(0.0005, gate_attack_ms*0.001));
    release_coefficient = exp(-frame_seconds/max(0.005, gate_release_ms*0.001));
    hold_frames = floor(gate_hold_ms*0.001/max(0.000001, frame_seconds) + 0.5);
    low_start = max(1, gate_low_hz/(2 ^ gate_edge_octaves));
    high_end = min(srate*0.5, gate_high_hz*(2 ^ gate_edge_octaves));

    bin = 0;
    loop(fftsize/2 + 1,
      fft_index = 2*bin;
      frequency = bin*srate/fftsize;
      left_real = left_block[fft_index];
      left_imaginary = left_block[fft_index + 1];
      right_real = right_block[fft_index];
      right_imaginary = right_block[fft_index + 1];
      left_magnitude_now = sqrt(left_real*left_real
                                + left_imaginary*left_imaginary);
      right_magnitude_now = sqrt(right_real*right_real
                                 + right_imaginary*right_imaginary);
      linked_magnitude = max(left_magnitude_now, right_magnitude_now);
      detector_left = left_magnitude_now*(1 - gate_stereo_link)
                      + linked_magnitude*gate_stereo_link;
      detector_right = right_magnitude_now*(1 - gate_stereo_link)
                       + linked_magnitude*gate_stereo_link;
      level_left_db = 20*log(max(0.000000000001,
                                 detector_left*4/max(1, fftsize)))/log(10);
      level_right_db = 20*log(max(0.000000000001,
                                  detector_right*4/max(1, fftsize)))/log(10);

      band_weight = frequency <= 0 ? 0 : 1;
      frequency > 0 && frequency < gate_low_hz ? (
        edge_position = log(max(1, frequency)/low_start)
                        /log(2)/gate_edge_octaves;
        band_weight *= smooth_step(edge_position);
      );
      frequency > gate_high_hz ? (
        edge_position = 1 - log(frequency/gate_high_hz)
                              /log(2)/gate_edge_octaves;
        band_weight *= smooth_step(edge_position);
      );
      frequency >= high_end ? band_weight = 0;

      detector_tilt_db = frequency > 0
                         ? gate_detector_tilt*log(max(20, frequency)/1000)/log(2)
                         : 0;
      level_left_db += detector_tilt_db + gate_detector_gain_db;
      level_right_db += detector_tilt_db + gate_detector_gain_db;
      contour_db = min(24, max(-24, gate_shape_db_at(max(20, frequency))))
                   * gate_contour;
      base_threshold_db = gate_threshold_db - contour_db;

      left_current_db = gate_gain_left[bin];
      right_current_db = gate_gain_right[bin];
      left_threshold_db = base_threshold_db
                          - (left_current_db > -gate_range_db*0.5
                             ? gate_hysteresis_db : 0);
      right_threshold_db = base_threshold_db
                           - (right_current_db > -gate_range_db*0.5
                              ? gate_hysteresis_db : 0);
      left_open = gate_open_amount(level_left_db, left_threshold_db, gate_knee_db);
      right_open = gate_open_amount(level_right_db, right_threshold_db, gate_knee_db);

      left_open >= 0.5 ? (
        gate_hold_left[bin] = hold_frames;
      ) : gate_hold_left[bin] > 0 ? (
        gate_hold_left[bin] -= 1;
        left_open = 1;
      );
      right_open >= 0.5 ? (
        gate_hold_right[bin] = hold_frames;
      ) : gate_hold_right[bin] > 0 ? (
        gate_hold_right[bin] -= 1;
        right_open = 1;
      );

      gate_target_left[bin] = -gate_range_db*(1 - left_open)*band_weight;
      gate_target_right[bin] = -gate_range_db*(1 - right_open)*band_weight;
      bin += 1;
    );

    reduction_sum = 0;
    bin = 0;
    loop(fftsize/2 + 1,
      left_target_db = gate_target_left[bin];
      right_target_db = gate_target_right[bin];
      bin > 0 && bin < fftsize/2 ? (
        previous_target = gate_target_left[bin - 1];
        next_target = gate_target_left[bin + 1];
        smoothed_target = (previous_target + 2*left_target_db + next_target)*0.25;
        left_target_db += (smoothed_target - left_target_db)*gate_frequency_smooth;

        previous_target = gate_target_right[bin - 1];
        next_target = gate_target_right[bin + 1];
        smoothed_target = (previous_target + 2*right_target_db + next_target)*0.25;
        right_target_db += (smoothed_target - right_target_db)*gate_frequency_smooth;
      );

      left_current_db = gate_gain_left[bin];
      envelope_coefficient = left_target_db > left_current_db
                             ? attack_coefficient : release_coefficient;
      left_current_db = left_target_db
                        + (left_current_db - left_target_db)*envelope_coefficient;
      gate_gain_left[bin] = min(0, max(-gate_range_db, left_current_db));

      right_current_db = gate_gain_right[bin];
      envelope_coefficient = right_target_db > right_current_db
                             ? attack_coefficient : release_coefficient;
      right_current_db = right_target_db
                         + (right_current_db - right_target_db)*envelope_coefficient;
      gate_gain_right[bin] = min(0, max(-gate_range_db, right_current_db));
      reduction_sum += (gate_gain_left[bin] + gate_gain_right[bin])*0.5;
      bin += 1;
    );
    gate_activity_db = reduction_sum/max(1, fftsize/2 + 1);
  );

  // Apply a real-valued per-bin gain to both halves of the conjugate spectrum.
  // The mix interpolation is exact unity at 0%, including makeup gain.
  function apply_spectral_gate(block, gain_envelope)
    local(bin, fft_index, mirror_index, wet_gain, scale) (
    bin = 0;
    fft_index = 0;
    loop(fftsize/2 + 1,
      wet_gain = exp(gain_envelope[bin]*log(10)/20)*gate_makeup_gain;
      scale = 1 + gate_mix*(wet_gain - 1);
      mirror_index = (bin == 0 || bin == fftsize/2)
                     ? fft_index : 2*(fftsize - bin);
      block[fft_index] *= scale;
      block[fft_index + 1] *= scale;
      mirror_index != fft_index ? (
        block[mirror_index] *= scale;
        block[mirror_index + 1] *= scale;
      );
      fft_index += 2;
      bin += 1;
    );
  );

  // The same periodic Hann is used before analysis and after synthesis. With
  // an N/4 hop, four squared Hann windows sum to exactly 3/2 at every sample.
  function apply_stft_hann(block)
    local(sample_index, fft_index, window_value) (
    sample_index = 0;
    fft_index = 0;
    loop(fftsize,
      window_value = stft_window[sample_index];
      block[fft_index] *= window_value;
      block[fft_index + 1] *= window_value;
      sample_index += 1;
      fft_index += 2;
    );
  );

  function delay_read(buffer, write_frame, delay_frames, buffer_frames, channel)
    local(read_frame, index_a, index_b, fraction) (
    read_frame = write_frame - delay_frames;
    read_frame < 0 ? read_frame += buffer_frames;
    index_a = floor(read_frame);
    index_b = index_a + 1;
    index_b >= buffer_frames ? index_b = 0;
    fraction = read_frame - index_a;
    buffer[2*index_a + channel]*(1 - fraction)
      + buffer[2*index_b + channel]*fraction;
  );

  function diffuse_allpass(buffer, write_frame, buffer_frames,
                           delay_frames, channel, input, coefficient)
    local(read_frame, delayed, output) (
    read_frame = write_frame - delay_frames;
    read_frame < 0 ? read_frame += buffer_frames;
    delayed = buffer[2*read_frame + channel];
    output = delayed - coefficient*input;
    buffer[2*write_frame + channel] = input + coefficient*output;
    output;
  );

  function distort_band(input, gain, fuzz)
    local(driven, soft_shape, hard_shape) (
    driven = input*gain;
    soft_shape = driven/(1 + abs(driven));
    hard_shape = min(1, max(-1, driven));
    soft_shape*(1 - fuzz) + hard_shape*fuzz;
  );

  function random_stepped(minimum, maximum, step)
    local(value) (
    value = minimum + rand(1)*(maximum - minimum);
    step > 0 ? value = minimum
                     + floor((value - minimum)/step + 0.5)*step;
    min(maximum, max(minimum, value));
  );

  function randomize_parameters() (
    // Conservative whitelist: SAFE RND changes tone and timing, never output
    // gain, tilt/boost position, feedback, wet level, Character drive/spread,
    // or any LFO assignment. Smear is also preserved because remembered FFT
    // energy can legitimately exceed the current frame by a large amount.
    // Cutoffs may only narrow the current passband. This prevents RND from
    // revealing an existing hand-drawn or tilted boost that was safely cut.
    slider_automate(slider1 = max(slider1, random_stepped(20, 700, 1)));
    slider_automate(slider2 = min(slider2, random_stepped(3000, 22000, 10)));
    slider_automate(slider3 = min(slider3, random_stepped(0.3, 3, 0.1)));
    slider_automate(slider6 = random_stepped(1, 4, 1));
    slider_automate(slider8 = random_stepped(0, 25, 1));
    slider_automate(slider9 = random_stepped(0, 35, 1));
    slider_automate(slider10 = random_stepped(0, 2, 1));
    slider_automate(slider15 = random_stepped(20, 1200, 1));
    slider_automate(slider16 = random_stepped(20, 1200, 1));
    slider_automate(slider18 = random_stepped(0, 100, 0.1));
    slider_automate(slider19 = max(slider19, random_stepped(40, 100, 0.1)));
    slider_automate(slider21 = random_stepped(20, 1200, 1));
    slider_automate(slider22 = random_stepped(20, 1200, 1));
    slider_automate(slider24 = random_stepped(0, 100, 0.1));
    slider_automate(slider25 = max(slider25, random_stepped(40, 100, 0.1)));
    // Preserve diffusion when a delay already contains a high-feedback state.
    modulated_parameter(17, 0, 95, 0) <= 50
      ? slider_automate(slider28 = random_stepped(0, 70, 0.1));
    modulated_parameter(23, 0, 95, 0) <= 50
      ? slider_automate(slider29 = random_stepped(0, 70, 0.1));

    // Do not excite the intentionally underdamped ReaFIR-style transition
    // spring with a randomized cutoff jump.
    memset(spectral_response_velocity, 0, 16385);
    spectral_response_initialized = 0;
    repeat_remaining = 0;
    safe_random_notice_until = 0;
  );

  function randomize_gate_parameters()
    local(gate_random_allowed) (
    // Mix, Makeup, and Detector Gain are gain-sensitive and stay untouched.
    // If positive Makeup is audible, changing detection could expose that
    // boost abruptly. Pause instead of touching the user's gain control.
    gate_random_allowed = modulated_parameter(64, 0, 100, 0) <= 0.0001
                          || modulated_parameter(86, -12, 24, 0) <= 0;
    gate_random_allowed ? (
    slider_automate(slider65 = random_stepped(-72, -30, 0.1));
    slider_automate(slider66 = random_stepped(18, 72, 0.1));
    slider_automate(slider67 = random_stepped(2, 120, 0.1));
    slider_automate(slider68 = random_stepped(80, 1800, 1));
    slider_automate(slider69 = random_stepped(3, 15, 0.1));
    slider_automate(slider70 = random_stepped(20, 500, 1));
    slider_automate(slider71 = random_stepped(4000, 20000, 10));
    slider_automate(slider72 = random_stepped(0.25, 2.5, 0.1));
    slider_automate(slider73 = random_stepped(-4, 4, 0.1));
    slider_automate(slider74 = random_stepped(70, 100, 0.1));
    slider_automate(slider75 = random_stepped(10, 75, 0.1));
    slider_automate(slider76 = random_stepped(25, 100, 0.1));
    slider_automate(slider77 = random_stepped(0, 100, 0.1));
    slider_automate(slider78 = random_stepped(-1.5, 1.5, 0.01));
    slider_automate(slider79 = random_stepped(0, 1.25, 0.01));
    slider_automate(slider80 = random_stepped(0.05, 4, 0.01));
    slider_automate(slider82 = random_stepped(1, 12, 0.1));
    slider_automate(slider83 = random_stepped(0, 300, 1));
      safe_random_notice_until = 0;
    ) : (
      safe_random_notice_until = time_precise() + 1.8;
    );
  );

  function refresh_control_state() (

  control1 = modulated_parameter(1, 10, 1000, 0);
  control2 = modulated_parameter(2, 1000, 24000, 0);
  control3 = modulated_parameter(3, 0.1, 4, 0);
  control4 = modulated_parameter(4, -12, 12, 0);
  control5 = modulated_parameter(5, -24, 12, 0);
  control6 = modulated_parameter(6, 0, 5, 1);
  control7 = modulated_parameter(7, 0, 100, 0);
  control8 = modulated_parameter(8, 0, 100, 0);
  control9 = modulated_parameter(9, 0, 100, 0);
  control10 = modulated_parameter(10, 0, 4, 1);
  control11 = modulated_parameter(11, 0, 100, 0);
  control12 = modulated_parameter(12, -4, 4, 0);
  control13 = modulated_parameter(13, 0, 4, 0);
  control14 = modulated_parameter(14, 0, 10, 0);
  control15 = modulated_parameter(15, 1, 2000, 0);
  control16 = modulated_parameter(16, 1, 2000, 0);
  control17 = modulated_parameter(17, 0, 95, 0);
  control18 = modulated_parameter(18, 0, 100, 0);
  control19 = modulated_parameter(19, 0, 100, 0);
  control20 = modulated_parameter(20, 0, 100, 0);
  control21 = modulated_parameter(21, 1, 2000, 0);
  control22 = modulated_parameter(22, 1, 2000, 0);
  control23 = modulated_parameter(23, 0, 95, 0);
  control24 = modulated_parameter(24, 0, 100, 0);
  control25 = modulated_parameter(25, 0, 100, 0);
  control26 = modulated_parameter(26, 0, 100, 0);
  control27 = modulated_parameter(27, 0, 100, 0);
  control28 = modulated_parameter(28, 0, 100, 0);
  control29 = modulated_parameter(29, 0, 100, 0);
  control30 = modulated_parameter(30, 0, 100, 0);
  control31 = modulated_parameter(31, 0, 60, 0);
  control32 = modulated_parameter(32, 0, 60, 0);
  control33 = modulated_parameter(33, 0, 60, 0);
  control64 = modulated_parameter(64, 0, 100, 0);
  control65 = modulated_parameter(65, -96, 0, 0);
  control66 = modulated_parameter(66, 0, 96, 0);
  control67 = modulated_parameter(67, 0.5, 500, 0);
  control68 = modulated_parameter(68, 5, 5000, 0);
  control69 = modulated_parameter(69, 0, 24, 0);
  control70 = modulated_parameter(70, 20, 1000, 0);
  control71 = modulated_parameter(71, 1000, 20000, 0);
  control72 = modulated_parameter(72, 0.1, 4, 0);
  control73 = modulated_parameter(73, -12, 12, 0);
  control74 = modulated_parameter(74, 0, 100, 0);
  control75 = modulated_parameter(75, 0, 100, 0);
  control76 = modulated_parameter(76, 0, 100, 0);
  control77 = modulated_parameter(77, 0, 100, 0);
  control78 = modulated_parameter(78, -4, 4, 0);
  control79 = modulated_parameter(79, 0, 4, 0);
  control80 = modulated_parameter(80, 0, 10, 0);
  control82 = modulated_parameter(82, 0, 24, 0);
  control83 = modulated_parameter(83, 0, 1000, 0);
  control86 = modulated_parameter(86, -12, 24, 0);
  control91 = modulated_parameter(91, -24, 24, 0);

  low_hz = max(10, min(control1, srate * 0.49));
  high_hz = max(low_hz, min(control2, srate * 0.49));
  edge_octaves = max(0.1, control3);
  tilt_db_per_octave = control4;
  output_gain = exp(control5 * log(10) / 20);
  smear_coefficient = control7 <= 0 ? 0 : 1 - exp(-0.055 * control7);
  grain_amount = control8 / 100;
  grain_step_db = 0.25 + grain_amount*grain_amount*23.75;
  phase_scatter_amount = (control9 / 100) ^ 2;
  frame_repeat_count = control10 | 0;

  shape_morph = control11 / 100;
  shape_manual_shift_octaves = control12;
  auto_sweep_depth_octaves = control13;
  auto_sweep_rate_hz = sync_rate(slider50 | 0, control14);

  gate_mix = control64/100;
  gate_threshold_db = control65;
  gate_range_db = control66;
  gate_attack_ms = control67;
  gate_release_ms = control68;
  gate_knee_db = control69;
  gate_low_hz = max(20, min(control70, srate*0.49));
  gate_high_hz = max(gate_low_hz, min(control71, srate*0.49));
  gate_edge_octaves = max(0.1, control72);
  gate_detector_tilt = control73;
  gate_stereo_link = control74/100;
  gate_frequency_smooth = control75/100;
  gate_contour = control76/100;
  gate_shape_morph = control77/100;
  gate_shape_manual_shift_octaves = control78;
  gate_auto_sweep_depth_octaves = control79;
  gate_auto_sweep_rate_hz = sync_rate(slider81 | 0, control80);
  gate_hysteresis_db = control82;
  gate_hold_ms = control83;
  gate_makeup_gain = exp(control86*log(10)/20);
  gate_detector_gain_db = control91;

  low_edge_start = max(1, low_hz / (2 ^ edge_octaves));

  pre_delay_left_seconds = slider52 > 0 ? sync_seconds(slider52 | 0) : control15/1000;
  pre_delay_right_seconds = slider53 > 0 ? sync_seconds(slider53 | 0) : control16/1000;
  slider51 >= 0.5 ? pre_delay_right_seconds = pre_delay_left_seconds;
  pre_delay_left_target = min(delay_buffer_frames - 2, max(1, pre_delay_left_seconds*srate));
  pre_delay_right_target = min(delay_buffer_frames - 2, max(1, pre_delay_right_seconds*srate));
  pre_feedback = control17 / 100;
  pre_crossfeed = control18 / 100;
  pre_damping_cutoff = 20000 * ((600 / 20000) ^ (control19 / 100));
  pre_damping_cutoff = min(srate*0.45, pre_damping_cutoff);
  pre_damping_alpha = control19 <= 0 ? 1 : 1 - exp(-2*$pi*pre_damping_cutoff/srate);
  pre_mix = control20 / 100;
  pre_diffusion_amount = control28 / 100;
  pre_diffusion_insert = smooth_step(min(1, pre_diffusion_amount*20));
  pre_diffusion_coefficient = 0.22 + sqrt(pre_diffusion_amount)*0.56;
  pre_diffusion_a_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0023)));
  pre_diffusion_a_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0037)));
  pre_diffusion_b_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0057)));
  pre_diffusion_b_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0079)));
  pre_diffusion_c_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0097)));
  pre_diffusion_c_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0127)));
  pre_diffusion_d_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0149)));
  pre_diffusion_d_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0191)));

  post_delay_left_seconds = slider55 > 0 ? sync_seconds(slider55 | 0) : control21/1000;
  post_delay_right_seconds = slider56 > 0 ? sync_seconds(slider56 | 0) : control22/1000;
  slider54 >= 0.5 ? post_delay_right_seconds = post_delay_left_seconds;
  post_delay_left_target = min(delay_buffer_frames - 2, max(1, post_delay_left_seconds*srate));
  post_delay_right_target = min(delay_buffer_frames - 2, max(1, post_delay_right_seconds*srate));
  post_feedback = control23 / 100;
  post_crossfeed = control24 / 100;
  post_damping_cutoff = 20000 * ((600 / 20000) ^ (control25 / 100));
  post_damping_cutoff = min(srate*0.45, post_damping_cutoff);
  post_damping_alpha = control25 <= 0 ? 1 : 1 - exp(-2*$pi*post_damping_cutoff/srate);
  post_mix = control26 / 100;
  post_diffusion_amount = control29 / 100;
  post_diffusion_insert = smooth_step(min(1, post_diffusion_amount*20));
  post_diffusion_coefficient = 0.22 + sqrt(post_diffusion_amount)*0.56;
  post_diffusion_a_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0031)));
  post_diffusion_a_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0047)));
  post_diffusion_b_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0067)));
  post_diffusion_b_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0091)));
  post_diffusion_c_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0113)));
  post_diffusion_c_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0149)));
  post_diffusion_d_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0173)));
  post_diffusion_d_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0239)));
  pre_fx_character_target = control27 / 100;
  pre_fx_spread_target = control30 / 100;
  pre_fx_mix_target = slider61 / 100;
  pre_fx_low_xover = 1 - exp(-2*$pi*250/srate);
  pre_fx_high_xover = 1 - exp(-2*$pi*2500/srate);
  pre_fx_low_band_gain = exp(control31*log(10)/20);
  pre_fx_mid_band_gain = exp(control32*log(10)/20);
  pre_fx_high_band_gain = exp(control33*log(10)/20);

  pre_delay_left_current <= 0 ? pre_delay_left_current = pre_delay_left_target;
  pre_delay_right_current <= 0 ? pre_delay_right_current = pre_delay_right_target;
  post_delay_left_current <= 0 ? post_delay_left_current = post_delay_left_target;
  post_delay_right_current <= 0 ? post_delay_right_current = post_delay_right_target;

  requested_fft_size = (2 ^ (control6 + 10)) | 0;
  requested_fft_size != fftsize ? (
    fftsize = requested_fft_size;
    stft_hop_size = fftsize / 4;
    stft_hop_position = 0;
    stft_start_frame = 0;
    stft_ola_scale = 2 / (3 * fftsize);
    repeat_remaining = 0;
    memset(left_frames, 0, 4 * stft_frame_stride);
    memset(right_frames, 0, 4 * stft_frame_stride);
    memset(left_magnitude, 0, 16385);
    memset(right_magnitude, 0, 16385);
    memset(spectral_response_db, 0, 16385);
    memset(spectral_response_velocity, 0, 16385);
    memset(gate_gain_left, 0, 16385);
    memset(gate_gain_right, 0, 16385);
    memset(gate_hold_left, 0, 16385);
    memset(gate_hold_right, 0, 16385);
    memset(gate_target_left, 0, 16385);
    memset(gate_target_right, 0, 16385);
    memset(held_left, 0, 2 * 32768);
    memset(held_right, 0, 2 * 32768);
    memset(stft_window, 0, 32768);
    spectral_response_initialized = 0;
    spectral_warble_phase = 0;
    gate_activity_db = 0;

    phase = 2 * $pi / fftsize;
    index = 0;
    loop(fftsize,
      stft_window[index] = 0.5 - 0.5*cos(index*phase);
      index += 1;
    );

    pdc_delay = fftsize;
    ext_tail_size = -1;
  );
  );

@slider

  refresh_control_state();

@block

  current_shape_mode_a = slider62 | 0;
  current_shape_mode_b = slider63 | 0;
  current_shape_mode_a != last_shape_mode_a ? (
    generate_spectral_shape(shape_a, current_shape_mode_a);
    last_shape_mode_a = current_shape_mode_a;
  );
  current_shape_mode_b != last_shape_mode_b ? (
    generate_spectral_shape(shape_b, current_shape_mode_b);
    last_shape_mode_b = current_shape_mode_b;
  );
  current_gate_shape_mode_a = slider84 | 0;
  current_gate_shape_mode_b = slider85 | 0;
  current_gate_shape_mode_a != last_gate_shape_mode_a ? (
    generate_spectral_shape(gate_shape_a, current_gate_shape_mode_a);
    last_gate_shape_mode_a = current_gate_shape_mode_a;
  );
  current_gate_shape_mode_b != last_gate_shape_mode_b ? (
    generate_spectral_shape(gate_shape_b, current_gate_shape_mode_b);
    last_gate_shape_mode_b = current_gate_shape_mode_b;
  );

  lfo1_previous_phase = lfo1_phase;
  lfo2_previous_phase = lfo2_phase;
  lfo3_previous_phase = lfo3_phase;
  lfo4_previous_phase = lfo4_phase;
  lfo1_phase += sync_rate(slider57 | 0, slider36)*samplesblock/srate;
  lfo2_phase += sync_rate(slider58 | 0, slider40)*samplesblock/srate;
  lfo3_phase += sync_rate(slider59 | 0, slider44)*samplesblock/srate;
  lfo4_phase += sync_rate(slider60 | 0, slider48)*samplesblock/srate;
  lfo1_phase -= floor(lfo1_phase);
  lfo2_phase -= floor(lfo2_phase);
  lfo3_phase -= floor(lfo3_phase);
  lfo4_phase -= floor(lfo4_phase);
  lfo1_phase < lfo1_previous_phase ? lfo1_random = rand(2) - 1;
  lfo2_phase < lfo2_previous_phase ? lfo2_random = rand(2) - 1;
  lfo3_phase < lfo3_previous_phase ? lfo3_random = rand(2) - 1;
  lfo4_phase < lfo4_previous_phase ? lfo4_random = rand(2) - 1;
  lfo1_value = lfo_wave(slider35 | 0, lfo1_phase, lfo1_random);
  lfo2_value = lfo_wave(slider39 | 0, lfo2_phase, lfo2_random);
  lfo3_value = lfo_wave(slider43 | 0, lfo3_phase, lfo3_random);
  lfo4_value = lfo_wave(slider47 | 0, lfo4_phase, lfo4_random);

  // Custom @gfx controls update slider values outside REAPER's stock UI.
  // Refresh every derived coefficient and target once per audio block so the
  // sound always follows the visible knobs immediately.
  refresh_control_state();

@serialize

  // @serialize is bidirectional. Compatibility cleanup belongs only to load
  // mode; file_avail(0) is negative while REAPER is writing the FX state.
  serialize_reading = file_avail(0) >= 0;
  file_mem(0, shape_a, shape_point_count) ? shape_initialized = 1;
  file_mem(0, shape_b, shape_point_count) ? shape_initialized = 1;
  file_mem(0, preset_valid, preset_slot_count);
  file_mem(0, preset_data, preset_slot_count*preset_stride);
  serialize_slot = 0;
  loop(preset_slot_count,
    file_string(0, preset_names + serialize_slot);
    serialize_slot += 1;
  );
  // Appended fields keep old project state readable: legacy streams simply
  // reach EOF here and retain the gate defaults initialized above.
  gate_shape_a_serialized = file_mem(0, gate_shape_a, shape_point_count);
  gate_shape_b_serialized = file_mem(0, gate_shape_b, shape_point_count);
  extended_valid_serialized = file_mem(0, extended_preset_valid,
                                       preset_slot_count);
  extended_data_serialized = file_mem(0, extended_preset_data,
                                      preset_slot_count*extended_preset_stride);
  serialize_reading ? (
    gate_shape_a_serialized < shape_point_count
    || gate_shape_b_serialized < shape_point_count
    || extended_valid_serialized < preset_slot_count
    || extended_data_serialized < preset_slot_count*extended_preset_stride ? (
      // A pre-gate state has no extension. Do not let ext_noinit leak a newer
      // instance's gate curves or Lucky Slots into that older project.
      memset(gate_shape_a, 0, shape_point_count);
      memset(gate_shape_b, 0, shape_point_count);
      memset(extended_preset_valid, 0, preset_slot_count);
      memset(extended_preset_data, 0,
             preset_slot_count*extended_preset_stride);
    ) : (
      gate_shape_initialized = 1;
      extended_preset_initialized = 1;
    );
  );
  // A second append-only sidecar lets new Lucky Slots remember stage order
  // without changing either legacy preset stride.
  routing_valid_serialized = file_mem(0, routing_preset_valid,
                                      preset_slot_count);
  routing_data_serialized = file_mem(0, routing_preset_data,
                                     preset_slot_count);
  // Loading a pre-5.1 state reaches EOF here. Clear both banks on a short
  // read so an older project cannot inherit stale route flags from ext_noinit.
  serialize_reading ? (
    routing_valid_serialized < preset_slot_count
    || routing_data_serialized < preset_slot_count ? (
      memset(routing_preset_valid, 0, preset_slot_count);
      memset(routing_preset_data, 0, preset_slot_count);
    ) : routing_preset_initialized = 1;
  );

@sample

  // Automatable sine sweep moves the drawing over the log-frequency axis.
  auto_sweep_phase += auto_sweep_rate_hz / srate;
  auto_sweep_phase >= 1 ? auto_sweep_phase -= 1;
  shape_total_shift_octaves = shape_manual_shift_octaves
                              + sin(2*$pi*auto_sweep_phase)*auto_sweep_depth_octaves;
  gate_auto_sweep_phase += gate_auto_sweep_rate_hz/srate;
  gate_auto_sweep_phase >= 1 ? gate_auto_sweep_phase -= 1;
  gate_shape_total_shift_octaves = gate_shape_manual_shift_octaves
                                   + sin(2*$pi*gate_auto_sweep_phase)
                                     * gate_auto_sweep_depth_octaves;

  delay_smoothing = 0.001;
  pre_delay_left_current += (pre_delay_left_target - pre_delay_left_current)*delay_smoothing;
  pre_delay_right_current += (pre_delay_right_target - pre_delay_right_current)*delay_smoothing;
  post_delay_left_current += (post_delay_left_target - post_delay_left_current)*delay_smoothing;
  post_delay_right_current += (post_delay_right_target - post_delay_right_current)*delay_smoothing;

  // Stereo delay before the spectral stage.
  chain_input_left = spl0;
  chain_input_right = spl1;
  pre_wet_left = delay_read(pre_delay_buffer, pre_write_frame,
                            pre_delay_left_current, delay_buffer_frames, 0);
  pre_wet_right = delay_read(pre_delay_buffer, pre_write_frame,
                             pre_delay_right_current, delay_buffer_frames, 1);

  // Four staggered stereo all-pass stages turn discrete echoes into a dense
  // cloud. Above the bottom five percent of the knob range it is a serial,
  // magnitude-flat insert rather than a parallel phase blend, avoiding the
  // comb filtering and low-mid buildup of the previous implementation.
  pre_diffused_a_left = diffuse_allpass(pre_diffusion_a_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_a_left, 0, pre_wet_left, pre_diffusion_coefficient);
  pre_diffused_a_right = diffuse_allpass(pre_diffusion_a_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_a_right, 1, pre_wet_right, pre_diffusion_coefficient);
  pre_diffused_b_left = diffuse_allpass(pre_diffusion_b_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_b_left, 0, pre_diffused_a_left, pre_diffusion_coefficient);
  pre_diffused_b_right = diffuse_allpass(pre_diffusion_b_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_b_right, 1, pre_diffused_a_right, pre_diffusion_coefficient);
  pre_diffused_c_left = diffuse_allpass(pre_diffusion_c_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_c_left, 0, pre_diffused_b_left, pre_diffusion_coefficient);
  pre_diffused_c_right = diffuse_allpass(pre_diffusion_c_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_c_right, 1, pre_diffused_b_right, pre_diffusion_coefficient);
  pre_diffused_d_left = diffuse_allpass(pre_diffusion_d_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_d_left, 0, pre_diffused_c_left, pre_diffusion_coefficient);
  pre_diffused_d_right = diffuse_allpass(pre_diffusion_d_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_d_right, 1, pre_diffused_c_right, pre_diffusion_coefficient);
  pre_diffusion_write_frame += 1;
  pre_diffusion_write_frame >= diffusion_buffer_frames ? pre_diffusion_write_frame = 0;
  pre_wet_left = pre_wet_left*(1 - pre_diffusion_insert)
                 + pre_diffused_d_left*pre_diffusion_insert;
  pre_wet_right = pre_wet_right*(1 - pre_diffusion_insert)
                  + pre_diffused_d_right*pre_diffusion_insert;

  pre_feedback_state_left += (pre_wet_left - pre_feedback_state_left)*pre_damping_alpha;
  pre_feedback_state_right += (pre_wet_right - pre_feedback_state_right)*pre_damping_alpha;
  pre_feedback_to_left = pre_feedback_state_left*(1 - pre_crossfeed)
                         + pre_feedback_state_right*pre_crossfeed;
  pre_feedback_to_right = pre_feedback_state_right*(1 - pre_crossfeed)
                          + pre_feedback_state_left*pre_crossfeed;
  pre_delay_buffer[2*pre_write_frame] = chain_input_left + pre_feedback_to_left*pre_feedback;
  pre_delay_buffer[2*pre_write_frame + 1] = chain_input_right + pre_feedback_to_right*pre_feedback;
  pre_write_frame += 1;
  pre_write_frame >= delay_buffer_frames ? pre_write_frame = 0;

  input_left = chain_input_left*(1 - pre_mix) + pre_wet_left*pre_mix;
  input_right = chain_input_right*(1 - pre_mix) + pre_wet_right*pre_mix;
  pre_fx_stage_dry_left = input_left;
  pre_fx_stage_dry_right = input_right;

  // Cloudbox-style reconstructing crossover: low below 250 Hz, mid between
  // 250 Hz and 2.5 kHz, and high above 2.5 kHz. Since mid is the residual,
  // the three clean bands sum exactly to the input.
  pre_fx_character += (pre_fx_character_target - pre_fx_character) * 0.002;
  pre_fx_spread += (pre_fx_spread_target - pre_fx_spread) * 0.002;
  pre_fx_mix += (pre_fx_mix_target - pre_fx_mix) * 0.002;
  pre_fx_low_state_left += pre_fx_low_xover*(input_left - pre_fx_low_state_left);
  pre_fx_low_state_right += pre_fx_low_xover*(input_right - pre_fx_low_state_right);
  pre_fx_high_state_left += pre_fx_high_xover*(input_left - pre_fx_high_state_left);
  pre_fx_high_state_right += pre_fx_high_xover*(input_right - pre_fx_high_state_right);
  pre_fx_low_left = pre_fx_low_state_left;
  pre_fx_low_right = pre_fx_low_state_right;
  pre_fx_high_left = input_left - pre_fx_high_state_left;
  pre_fx_high_right = input_right - pre_fx_high_state_right;
  pre_fx_mid_left = input_left - pre_fx_low_left - pre_fx_high_left;
  pre_fx_mid_right = input_right - pre_fx_low_right - pre_fx_high_right;

  // Character zero remains an exact clean bypass. Above zero the three bands
  // saturate independently, then the recombined signal moves into fuzz and
  // finally the restrained Cloudbox-style crusher.
  pre_fx_character > 0.00001 ? (
    pre_fx_dry_left = input_left;
    pre_fx_dry_right = input_right;
    pre_fx_base_fuzz = min(1, pre_fx_character*2);
    pre_fx_base_crush = max(0, (pre_fx_character - 0.5)*2);
    pre_fx_base_wet = min(1, pre_fx_character*4);
    pre_fx_fuzz_left = max(0, pre_fx_base_fuzz - pre_fx_spread*0.85);
    pre_fx_fuzz_right = min(1, pre_fx_base_fuzz + pre_fx_spread*0.85);
    pre_fx_crush_left = max(0, pre_fx_base_crush - pre_fx_spread*0.90);
    pre_fx_crush_right = min(1, pre_fx_base_crush
                             + pre_fx_spread*(0.30 + pre_fx_character*0.55));
    pre_fx_drive_db_left = 3 + pre_fx_character*27 - pre_fx_spread*3;
    pre_fx_drive_db_right = 3 + pre_fx_character*27 + pre_fx_spread*3;
    pre_fx_drive_left = exp(pre_fx_drive_db_left*log(10)/20);
    pre_fx_drive_right = exp(pre_fx_drive_db_right*log(10)/20);
    pre_fx_trim = exp((-3 - pre_fx_character*9)*log(10)/20);

    pre_fx_dist_low_left = distort_band(pre_fx_low_left,
      pre_fx_drive_left*pre_fx_low_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_low_right = distort_band(pre_fx_low_right,
      pre_fx_drive_right*pre_fx_low_band_gain, pre_fx_fuzz_right);
    pre_fx_dist_mid_left = distort_band(pre_fx_mid_left,
      pre_fx_drive_left*pre_fx_mid_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_mid_right = distort_band(pre_fx_mid_right,
      pre_fx_drive_right*pre_fx_mid_band_gain, pre_fx_fuzz_right);
    pre_fx_dist_high_left = distort_band(pre_fx_high_left,
      pre_fx_drive_left*pre_fx_high_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_high_right = distort_band(pre_fx_high_right,
      pre_fx_drive_right*pre_fx_high_band_gain, pre_fx_fuzz_right);

    // Width is frequency-conscious: bass stays anchored while mid and high
    // character differences grow dramatically. The dry path is never widened.
    pre_fx_band_mid = (pre_fx_dist_low_left + pre_fx_dist_low_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_low_left - pre_fx_dist_low_right)*0.5
                       * (1 + pre_fx_spread*0.75);
    pre_fx_wide_low_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_low_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_band_mid = (pre_fx_dist_mid_left + pre_fx_dist_mid_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_mid_left - pre_fx_dist_mid_right)*0.5
                       * (1 + pre_fx_spread*4.00);
    pre_fx_wide_mid_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_mid_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_band_mid = (pre_fx_dist_high_left + pre_fx_dist_high_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_high_left - pre_fx_dist_high_right)*0.5
                       * (1 + pre_fx_spread*7.00);
    pre_fx_wide_high_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_high_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_spread_norm = 1/(1 + pre_fx_spread*0.35);
    pre_fx_processed_left = (pre_fx_wide_low_left + pre_fx_wide_mid_left
                             + pre_fx_wide_high_left)*pre_fx_spread_norm;
    pre_fx_processed_right = (pre_fx_wide_low_right + pre_fx_wide_mid_right
                              + pre_fx_wide_high_right)*pre_fx_spread_norm;

    pre_fx_steps_left = max(16, floor(128 - pre_fx_crush_left*112));
    pre_fx_hold_period_left = 1 + floor(pre_fx_crush_left*5);
    pre_fx_hold_counter_left <= 0 ? (
      pre_fx_held_left = floor(pre_fx_processed_left*pre_fx_steps_left + 0.5)
                         / pre_fx_steps_left;
      pre_fx_hold_counter_left = pre_fx_hold_period_left;
    ) : pre_fx_hold_counter_left -= 1;
    pre_fx_processed_left = pre_fx_processed_left*(1 - pre_fx_crush_left)
                            + pre_fx_held_left*pre_fx_crush_left;

    pre_fx_steps_right = max(16, floor(128 - pre_fx_crush_right*112));
    pre_fx_hold_period_right = 1 + floor(pre_fx_crush_right*5);
    pre_fx_hold_counter_right <= 0 ? (
      pre_fx_held_right = floor(pre_fx_processed_right*pre_fx_steps_right + 0.5)
                          / pre_fx_steps_right;
      pre_fx_hold_counter_right = pre_fx_hold_period_right;
    ) : pre_fx_hold_counter_right -= 1;
    pre_fx_processed_right = pre_fx_processed_right*(1 - pre_fx_crush_right)
                             + pre_fx_held_right*pre_fx_crush_right;

    pre_fx_cutoff_left = min(srate*0.45,
                             (18000 - pre_fx_crush_left*6000)
                             * (1 - pre_fx_spread*0.15));
    pre_fx_cutoff_right = min(srate*0.45, 18000 - pre_fx_crush_right*6000);
    pre_fx_cut_coefficient_left = 1 - exp(-2*$pi*pre_fx_cutoff_left/srate);
    pre_fx_cut_coefficient_right = 1 - exp(-2*$pi*pre_fx_cutoff_right/srate);
    pre_fx_filter_left += pre_fx_cut_coefficient_left
                          * (pre_fx_processed_left - pre_fx_filter_left);
    pre_fx_filter_right += pre_fx_cut_coefficient_right
                           * (pre_fx_processed_right - pre_fx_filter_right);
    pre_fx_processed_left = pre_fx_filter_left*pre_fx_trim;
    pre_fx_processed_right = pre_fx_filter_right*pre_fx_trim;
    input_left = pre_fx_dry_left*(1 - pre_fx_base_wet)
                 + pre_fx_processed_left*pre_fx_base_wet;
    input_right = pre_fx_dry_right*(1 - pre_fx_base_wet)
                  + pre_fx_processed_right*pre_fx_base_wet;
  ) : (
    pre_fx_filter_left = input_left;
    pre_fx_filter_right = input_right;
    pre_fx_hold_counter_left = 0;
    pre_fx_hold_counter_right = 0;
  );

  // Outer Cauldron mix keeps Gold's internal character progression intact
  // while allowing a clean parallel blend around the complete 3-band stage.
  input_left = pre_fx_stage_dry_left*(1 - pre_fx_mix) + input_left*pre_fx_mix;
  input_right = pre_fx_stage_dry_right*(1 - pre_fx_mix) + input_right*pre_fx_mix;

  // Four staggered STFT frames implement 75% overlap. Each output sample is
  // read before that same frame slot is recycled for the next input frame.
  stft_frame_slot0 = stft_start_frame;
  stft_frame_slot1 = (stft_start_frame + 3) % 4;
  stft_frame_slot2 = (stft_start_frame + 2) % 4;
  stft_frame_slot3 = (stft_start_frame + 1) % 4;
  stft_left_frame0 = left_frames + stft_frame_slot0*stft_frame_stride;
  stft_left_frame1 = left_frames + stft_frame_slot1*stft_frame_stride;
  stft_left_frame2 = left_frames + stft_frame_slot2*stft_frame_stride;
  stft_left_frame3 = left_frames + stft_frame_slot3*stft_frame_stride;
  stft_right_frame0 = right_frames + stft_frame_slot0*stft_frame_stride;
  stft_right_frame1 = right_frames + stft_frame_slot1*stft_frame_stride;
  stft_right_frame2 = right_frames + stft_frame_slot2*stft_frame_stride;
  stft_right_frame3 = right_frames + stft_frame_slot3*stft_frame_stride;

  stft_index0 = 2*stft_hop_position;
  stft_index1 = 2*(stft_hop_size + stft_hop_position);
  stft_index2 = 2*(2*stft_hop_size + stft_hop_position);
  stft_index3 = 2*(3*stft_hop_size + stft_hop_position);

  spectral_left = (stft_left_frame0[stft_index0]
                   + stft_left_frame1[stft_index1]
                   + stft_left_frame2[stft_index2]
                   + stft_left_frame3[stft_index3]) * stft_ola_scale;
  spectral_right = (stft_right_frame0[stft_index0]
                    + stft_right_frame1[stft_index1]
                    + stft_right_frame2[stft_index2]
                    + stft_right_frame3[stft_index3]) * stft_ola_scale;

  stft_left_frame0[stft_index0] = input_left;
  stft_left_frame0[stft_index0 + 1] = 0;
  stft_left_frame1[stft_index1] = input_left;
  stft_left_frame1[stft_index1 + 1] = 0;
  stft_left_frame2[stft_index2] = input_left;
  stft_left_frame2[stft_index2 + 1] = 0;
  stft_left_frame3[stft_index3] = input_left;
  stft_left_frame3[stft_index3 + 1] = 0;
  stft_right_frame0[stft_index0] = input_right;
  stft_right_frame0[stft_index0 + 1] = 0;
  stft_right_frame1[stft_index1] = input_right;
  stft_right_frame1[stft_index1 + 1] = 0;
  stft_right_frame2[stft_index2] = input_right;
  stft_right_frame2[stft_index2 + 1] = 0;
  stft_right_frame3[stft_index3] = input_right;
  stft_right_frame3[stft_index3 + 1] = 0;

  stft_hop_position += 1;
  stft_hop_position >= stft_hop_size ? (
    stft_completed_slot = (stft_start_frame + 1) % 4;
    stft_completed_left = left_frames + stft_completed_slot*stft_frame_stride;
    stft_completed_right = right_frames + stft_completed_slot*stft_frame_stride;

    apply_stft_hann(stft_completed_left);
    fft(stft_completed_left, fftsize);
    fft_permute(stft_completed_left, fftsize);
    apply_stft_hann(stft_completed_right);
    fft(stft_completed_right, fftsize);
    fft_permute(stft_completed_right, fftsize);

    // Commit topology changes only where complete sequential spectra exist.
    // Held frames have route-specific meaning, so a reorder always starts
    // with a fresh downstream frame rather than replaying the old topology.
    requested_spectral_order = slider92 >= 0.5;
    requested_spectral_order != active_spectral_order ? (
      active_spectral_order = requested_spectral_order;
      repeat_remaining = 0;
      memset(held_left, 0, 2 * fftsize);
      memset(held_right, 0, 2 * fftsize);
    );

    active_spectral_order >= 0.5 ? (
      // GATE > FILTER: the detector and gain operate on the raw FFT frame.
      // During Frame Repeat the downstream Filter intentionally replays its
      // already-gated held result, while the detector keeps tracking live input.
      update_spectral_gate(stft_completed_left, stft_completed_right);
      repeat_remaining <= 0 ? (
        apply_spectral_gate(stft_completed_left, gate_gain_left);
        apply_spectral_gate(stft_completed_right, gate_gain_right);
      );
    );

    repeat_remaining > 0 ? (
      memcpy(stft_completed_left, held_left, 2 * fftsize);
      memcpy(stft_completed_right, held_right, 2 * fftsize);
      repeat_remaining -= 1;
    ) : (
      update_spectral_response();
      shape_sequential_spectrum(stft_completed_left, left_magnitude);
      shape_sequential_spectrum(stft_completed_right, right_magnitude);
      // FILTER > GATE holds a pre-gate filter frame. GATE > FILTER holds the
      // complete downstream result. Either form is consumed only by its route.
      memcpy(held_left, stft_completed_left, 2 * fftsize);
      memcpy(held_right, stft_completed_right, 2 * fftsize);
      repeat_remaining = frame_repeat_count;
    );

    active_spectral_order < 0.5 ? (
      // FILTER > GATE: detection follows the actual filtered/replayed spectrum.
      update_spectral_gate(stft_completed_left, stft_completed_right);
      apply_spectral_gate(stft_completed_left, gate_gain_left);
      apply_spectral_gate(stft_completed_right, gate_gain_right);
    );

    fft_ipermute(stft_completed_left, fftsize);
    ifft(stft_completed_left, fftsize);
    apply_stft_hann(stft_completed_left);
    fft_ipermute(stft_completed_right, fftsize);
    ifft(stft_completed_right, fftsize);
    apply_stft_hann(stft_completed_right);

    stft_start_frame = (stft_start_frame + 1) % 4;
    stft_hop_position = 0;
  );

  spectral_left *= output_gain;
  spectral_right *= output_gain;

  // Stereo delay after the spectral stage.
  post_wet_left = delay_read(post_delay_buffer, post_write_frame,
                             post_delay_left_current, delay_buffer_frames, 0);
  post_wet_right = delay_read(post_delay_buffer, post_write_frame,
                              post_delay_right_current, delay_buffer_frames, 1);
  post_diffused_a_left = diffuse_allpass(post_diffusion_a_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_a_left, 0, post_wet_left, post_diffusion_coefficient);
  post_diffused_a_right = diffuse_allpass(post_diffusion_a_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_a_right, 1, post_wet_right, post_diffusion_coefficient);
  post_diffused_b_left = diffuse_allpass(post_diffusion_b_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_b_left, 0, post_diffused_a_left, post_diffusion_coefficient);
  post_diffused_b_right = diffuse_allpass(post_diffusion_b_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_b_right, 1, post_diffused_a_right, post_diffusion_coefficient);
  post_diffused_c_left = diffuse_allpass(post_diffusion_c_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_c_left, 0, post_diffused_b_left, post_diffusion_coefficient);
  post_diffused_c_right = diffuse_allpass(post_diffusion_c_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_c_right, 1, post_diffused_b_right, post_diffusion_coefficient);
  post_diffused_d_left = diffuse_allpass(post_diffusion_d_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_d_left, 0, post_diffused_c_left, post_diffusion_coefficient);
  post_diffused_d_right = diffuse_allpass(post_diffusion_d_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_d_right, 1, post_diffused_c_right, post_diffusion_coefficient);
  post_diffusion_write_frame += 1;
  post_diffusion_write_frame >= diffusion_buffer_frames ? post_diffusion_write_frame = 0;
  post_wet_left = post_wet_left*(1 - post_diffusion_insert)
                  + post_diffused_d_left*post_diffusion_insert;
  post_wet_right = post_wet_right*(1 - post_diffusion_insert)
                   + post_diffused_d_right*post_diffusion_insert;
  post_feedback_state_left += (post_wet_left - post_feedback_state_left)*post_damping_alpha;
  post_feedback_state_right += (post_wet_right - post_feedback_state_right)*post_damping_alpha;
  post_feedback_to_left = post_feedback_state_left*(1 - post_crossfeed)
                          + post_feedback_state_right*post_crossfeed;
  post_feedback_to_right = post_feedback_state_right*(1 - post_crossfeed)
                           + post_feedback_state_left*post_crossfeed;
  post_delay_buffer[2*post_write_frame] = spectral_left + post_feedback_to_left*post_feedback;
  post_delay_buffer[2*post_write_frame + 1] = spectral_right + post_feedback_to_right*post_feedback;
  post_write_frame += 1;
  post_write_frame >= delay_buffer_frames ? post_write_frame = 0;

  spl0 = spectral_left*(1 - post_mix) + post_wet_left*post_mix;
  spl1 = spectral_right*(1 - post_mix) + post_wet_right*post_mix;

@gfx 1160 830

  function set_rainbow_color(position, alpha)
    local(wrapped, segment, fraction) (
    wrapped = position - floor(position);
    segment = floor(wrapped * 6);
    fraction = wrapped*6 - segment;
    segment == 0 ? (gfx_r = 1; gfx_g = fraction; gfx_b = 0;);
    segment == 1 ? (gfx_r = 1 - fraction; gfx_g = 1; gfx_b = 0;);
    segment == 2 ? (gfx_r = 0; gfx_g = 1; gfx_b = fraction;);
    segment == 3 ? (gfx_r = 0; gfx_g = 1 - fraction; gfx_b = 1;);
    segment == 4 ? (gfx_r = fraction; gfx_g = 0; gfx_b = 1;);
    segment == 5 ? (gfx_r = 1; gfx_g = 0; gfx_b = 1 - fraction;);
    gfx_a = alpha;
  );

  function draw_shamrock(center_x, center_y, size) (
    gfx_r = 0.10; gfx_g = 0.78; gfx_b = 0.24; gfx_a = 1;
    gfx_circle(center_x - size*0.42, center_y - size*0.22, size*0.48, 1, 1);
    gfx_circle(center_x + size*0.42, center_y - size*0.22, size*0.48, 1, 1);
    gfx_circle(center_x, center_y - size*0.72, size*0.48, 1, 1);
    gfx_line(center_x, center_y, center_x + size*0.26, center_y + size*1.2, 1);
  );

  function draw_leprechaun_hat(x, y, size) (
    gfx_r = 0.02; gfx_g = 0.44; gfx_b = 0.14; gfx_a = 1;
    gfx_triangle(x + size*0.18, y, x + size*0.75, y,
                 x + size*0.90, y + size*0.68, x + size*0.08, y + size*0.68);
    gfx_r = 0.01; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(x + size*0.10, y + size*0.45, size*0.76, size*0.20);
    gfx_r = 1; gfx_g = 0.74; gfx_b = 0.06;
    gfx_rect(x + size*0.39, y + size*0.43, size*0.22, size*0.24);
    gfx_r = 0.01; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(x + size*0.44, y + size*0.47, size*0.12, size*0.16);
    gfx_r = 0.03; gfx_g = 0.58; gfx_b = 0.18;
    gfx_rect(x, y + size*0.65, size, size*0.16);
  );

  function draw_leprechaun_face(center_x, center_y, size) (
    draw_leprechaun_hat(center_x - size*1.05, center_y - size*1.62, size*2.1);
    gfx_r = 1.00; gfx_g = 0.70; gfx_b = 0.42; gfx_a = 1;
    gfx_circle(center_x, center_y, size, 1, 1);
    gfx_r = 0.92; gfx_g = 0.25; gfx_b = 0.035; gfx_a = 1;
    gfx_rect(center_x - size, center_y + size*0.42, size*2, size*0.72);
    gfx_rect(center_x - size*0.72, center_y + size*0.96, size*1.44, size*0.42);
    gfx_r = 0.02; gfx_g = 0.08; gfx_b = 0.03; gfx_a = 1;
    gfx_rect(center_x - size*0.52, center_y - size*0.25, size*0.22, size*0.22);
    gfx_rect(center_x + size*0.30, center_y - size*0.25, size*0.22, size*0.22);
    gfx_r = 1; gfx_g = 0.44; gfx_b = 0.18; gfx_a = 1;
    gfx_rect(center_x - size*0.12, center_y, size*0.30, size*0.26);
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.68; gfx_a = 1;
    gfx_rect(center_x - size*0.42, center_y + size*0.36, size*0.84, size*0.18);
  );

  function draw_pixel_leprechaun(center_x, foot_y, size, coat_red, coat_green, coat_blue) (
    // Chunky 16-bit body, striped stockings, and square buckled shoes.
    gfx_r = 0.015; gfx_g = 0.045; gfx_b = 0.018; gfx_a = 0.72;
    gfx_rect(center_x - size*1.20 + 3, foot_y - size*3.35 + 3,
             size*2.40, size*3.35);
    gfx_r = coat_red; gfx_g = coat_green; gfx_b = coat_blue; gfx_a = 1;
    gfx_rect(center_x - size, foot_y - size*3.30, size*2, size*1.75);
    gfx_rect(center_x - size*1.42, foot_y - size*3.05, size*0.48, size*1.30);
    gfx_rect(center_x + size*0.94, foot_y - size*3.05, size*0.48, size*1.30);
    gfx_r = 0.03; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(center_x - size, foot_y - size*2.22, size*2, size*0.35);
    gfx_r = 1; gfx_g = 0.74; gfx_b = 0.06;
    gfx_rect(center_x - size*0.25, foot_y - size*2.29, size*0.50, size*0.48);
    gfx_r = 0.96; gfx_g = 0.62; gfx_b = 0.08;
    gfx_rect(center_x - size*0.78, foot_y - size*1.55, size*0.55, size*1.20);
    gfx_rect(center_x + size*0.23, foot_y - size*1.55, size*0.55, size*1.20);
    gfx_r = 0.98; gfx_g = 0.94; gfx_b = 0.66;
    gfx_rect(center_x - size*0.78, foot_y - size*1.20, size*0.55, size*0.22);
    gfx_rect(center_x + size*0.23, foot_y - size*0.72, size*0.55, size*0.22);
    gfx_r = 0.025; gfx_g = 0.045; gfx_b = 0.018;
    gfx_rect(center_x - size*1.02, foot_y - size*0.40, size*0.82, size*0.40);
    gfx_rect(center_x + size*0.20, foot_y - size*0.40, size*0.82, size*0.40);
    gfx_r = 1; gfx_g = 0.72; gfx_b = 0.05;
    gfx_rect(center_x - size*0.84, foot_y - size*0.34, size*0.24, size*0.20);
    gfx_rect(center_x + size*0.56, foot_y - size*0.34, size*0.24, size*0.20);
    draw_leprechaun_face(center_x, foot_y - size*4.18, size*0.92);
  );

  function draw_badass_leprechaun(center_x, foot_y, size) local(head_y, body_y) (
    head_y = foot_y - size*4.15;
    body_y = foot_y - size*2.65;

    // Long soft shadow and wide planted stance.
    gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.018; gfx_a = 0.48;
    gfx_rect(center_x - size*1.45, foot_y - size*0.16,
             size*2.90, size*0.22);
    gfx_circle(center_x - size*1.43, foot_y - size*0.05, size*0.11, 1, 1);
    gfx_circle(center_x + size*1.43, foot_y - size*0.05, size*0.11, 1, 1);

    // Tailored charcoal trousers and heavy asymmetric boots.
    gfx_r = 0.025; gfx_g = 0.045; gfx_b = 0.055; gfx_a = 1;
    gfx_triangle(center_x - size*0.72, body_y + size*0.95,
                 center_x - size*0.05, body_y + size*0.95,
                 center_x - size*0.26, foot_y - size*0.28,
                 center_x - size*0.92, foot_y - size*0.28);
    gfx_triangle(center_x + size*0.05, body_y + size*0.95,
                 center_x + size*0.72, body_y + size*0.95,
                 center_x + size*0.92, foot_y - size*0.28,
                 center_x + size*0.26, foot_y - size*0.28);
    gfx_r = 0.01; gfx_g = 0.018; gfx_b = 0.028;
    gfx_rect(center_x - size*1.08, foot_y - size*0.38, size*1.02, size*0.38);
    gfx_rect(center_x + size*0.12, foot_y - size*0.38, size*1.18, size*0.38);
