// @description JSchwartz Simple Spectral Filter — Lucky Edition
// @version 2.7.1
// @author JSchwartz
// @changelog Make every panel translucent, restore the single rainbow curve, and fill the UI with lucky pixel characters.
// @about Drawable spectral filtering, FFT damage, and stereo delays wrapped in
//   a rainbow-leprechaun interface. Draw two curves, morph between them, and
//   automate the filter motion from REAPER.
// @link https://github.com/janschwartzmusic/lucky-spectral-filter
desc:JSchwartz Simple Spectral Filter
//tags: FFT filter spectral stereo delay drawable modulation
//author: JSchwartz

slider1:30<10,1000,1>-Filter: Low Cut (Hz)
slider2:18000<1000,24000,10>-Filter: High Cut (Hz)
slider3:1<0.1,4,0.1>-Filter: Edge Width (octaves)
slider4:0<-12,12,0.1>-Filter: Spectral Tilt (dB/octave)
slider5:0<-24,12,0.1>-Filter: Output (dB)
slider6:1<0,5,1{1024,2048,4096,8192,16384,32768}>-Filter: FFT Size
slider7:0<0,100,1>-Damage: Transient Smear (%)
slider8:0<0,100,1>-Damage: Spectral Grain (%)
slider9:0<0,100,1>-Damage: Phase Scatter (%)
slider10:0<0,4,1>-Damage: Frame Repeat (frames)
slider11:0<0,100,0.1>-Drawing: Morph A to B (%)
slider12:0<-4,4,0.01>-Drawing: Shift (octaves)
slider13:0<0,4,0.01>-Drawing: Auto Sweep Depth (octaves)
slider14:0.2<0,10,0.01>-Drawing: Auto Sweep Rate (Hz)
slider15:220<1,2000,1>-Pre Delay: Left Time (ms)
slider16:330<1,2000,1>-Pre Delay: Right Time (ms)
slider17:35<0,95,0.1>-Pre Delay: Feedback (%)
slider18:50<0,100,0.1>-Pre Delay: Crossfeed / Ping-Pong (%)
slider19:20<0,100,0.1>-Pre Delay: HF Damping (%)
slider20:0<0,100,0.1>-Pre Delay: Mix (%)
slider21:375<1,2000,1>-Post Delay: Left Time (ms)
slider22:500<1,2000,1>-Post Delay: Right Time (ms)
slider23:40<0,95,0.1>-Post Delay: Feedback (%)
slider24:70<0,100,0.1>-Post Delay: Crossfeed / Ping-Pong (%)
slider25:25<0,100,0.1>-Post Delay: HF Damping (%)
slider26:0<0,100,0.1>-Post Delay: Mix (%)
slider27:0<0,100,0.1>-Pre Spectral: Saturation to Crush (%)
slider28:0<0,100,0.1>-Pre Delay: Diffusion (%)
slider29:0<0,100,0.1>-Post Delay: Diffusion (%)
slider30:0<0,100,0.1>-Pre Spectral: Distortion Spread (%)
slider31:6<0,60,0.1>-Distortion: Low Drive (dB)
slider32:12<0,60,0.1>-Distortion: Mid Drive (dB)
slider33:6<0,60,0.1>-Distortion: High Drive (dB)
slider34:0<0,33,1>-LFO 1: Target
slider35:0<0,5,1>-LFO 1: Shape
slider36:0.5<0.05,20,0.01>-LFO 1: Rate (Hz)
slider37:0<0,100,0.1>-LFO 1: Depth (%)
slider38:0<0,33,1>-LFO 2: Target
slider39:1<0,5,1>-LFO 2: Shape
slider40:0.33<0.05,20,0.01>-LFO 2: Rate (Hz)
slider41:0<0,100,0.1>-LFO 2: Depth (%)
slider42:0<0,33,1>-LFO 3: Target
slider43:2<0,5,1>-LFO 3: Shape
slider44:0.2<0.05,20,0.01>-LFO 3: Rate (Hz)
slider45:0<0,100,0.1>-LFO 3: Depth (%)
slider46:0<0,33,1>-LFO 4: Target
slider47:5<0,5,1>-LFO 4: Shape
slider48:0.125<0.05,20,0.01>-LFO 4: Rate (Hz)
slider49:0<0,100,0.1>-LFO 4: Depth (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:gfx_hz=60 no_meter

@init

  ext_noinit = 1;
  fftsize = -1;
  position = 0;

  // FFT/IFFT blocks must not cross REAPER's 65,536-slot memory pages.
  // Each maximum-size complex block therefore begins on its own page.
  window = 0;
  left_a = 65536;
  left_b = 131072;
  right_a = 196608;
  right_b = 262144;
  left_magnitude = 327680;
  right_magnitude = 344064;
  held_left = 393216;
  held_right = 458752;

  // Two persistent, drawable frequency-response curves.
  shape_point_count = 512;
  shape_a = 524288;
  shape_b = shape_a + shape_point_count;
  !shape_initialized ? (
    memset(shape_a, 0, shape_point_count);
    memset(shape_b, 0, shape_point_count);
    shape_initialized = 1;
  );
  active_shape = 0;
  last_draw_index = -1;

  // Two stereo delay lines. Each frame stores interleaved left/right samples.
  delay_buffer_frames = ceil(srate * 2.05) + 8;
  pre_delay_buffer = 600000;
  post_delay_buffer = pre_delay_buffer + 2*delay_buffer_frames + 8;
  diffusion_buffer_frames = ceil(srate * 0.06) + 8;
  pre_diffusion_a_buffer = post_delay_buffer + 2*delay_buffer_frames + 8;
  pre_diffusion_b_buffer = pre_diffusion_a_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_a_buffer = pre_diffusion_b_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_b_buffer = post_diffusion_a_buffer + 2*diffusion_buffer_frames + 8;
  pre_diffusion_c_buffer = post_diffusion_b_buffer + 2*diffusion_buffer_frames + 8;
  pre_diffusion_d_buffer = pre_diffusion_c_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_c_buffer = pre_diffusion_d_buffer + 2*diffusion_buffer_frames + 8;
  post_diffusion_d_buffer = post_diffusion_c_buffer + 2*diffusion_buffer_frames + 8;
  memset(pre_delay_buffer, 0, 2*delay_buffer_frames);
  memset(post_delay_buffer, 0, 2*delay_buffer_frames);
  memset(pre_diffusion_a_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_b_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_a_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_b_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_c_buffer, 0, 2*diffusion_buffer_frames);
  memset(pre_diffusion_d_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_c_buffer, 0, 2*diffusion_buffer_frames);
  memset(post_diffusion_d_buffer, 0, 2*diffusion_buffer_frames);
  pre_write_frame = 0;
  post_write_frame = 0;
  pre_diffusion_write_frame = 0;
  post_diffusion_write_frame = 0;
  pre_delay_left_current = 0;
  pre_delay_right_current = 0;
  post_delay_left_current = 0;
  post_delay_right_current = 0;
  pre_feedback_state_left = 0;
  pre_feedback_state_right = 0;
  post_feedback_state_left = 0;
  post_feedback_state_right = 0;
  pre_fx_character = 0;
  pre_fx_spread = 0;
  pre_fx_filter_left = 0;
  pre_fx_filter_right = 0;
  pre_fx_low_state_left = 0;
  pre_fx_low_state_right = 0;
  pre_fx_high_state_left = 0;
  pre_fx_high_state_right = 0;
  pre_fx_hold_counter_left = 0;
  pre_fx_hold_counter_right = 0;
  pre_fx_held_left = 0;
  pre_fx_held_right = 0;
  auto_sweep_phase = 0;
  lfo1_phase = 0;
  lfo2_phase = 0.25;
  lfo3_phase = 0.5;
  lfo4_phase = 0.75;
  lfo1_random = rand(2) - 1;
  lfo2_random = rand(2) - 1;
  lfo3_random = rand(2) - 1;
  lfo4_random = rand(2) - 1;
  lfo1_value = 0;
  lfo2_value = 0;
  lfo3_value = 0;
  lfo4_value = 0;
  ui_page = 0;

  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  function smooth_step(value) local(x) (
    x = min(1, max(0, value));
    x*x*(3 - 2*x);
  );

  function lfo_wave(shape, phase_value, random_value) local(wave_value) (
    shape == 0 ? wave_value = sin(2*$pi*phase_value);
    shape == 1 ? wave_value = 1 - 4*abs(phase_value - 0.5);
    shape == 2 ? (
      phase_value < 0.5 ? wave_value = 1 : wave_value = -1;
    );
    shape == 3 ? wave_value = phase_value*2 - 1;
    shape == 4 ? wave_value = 1 - phase_value*2;
    shape == 5 ? wave_value = random_value;
    wave_value;
  );

  // Modulation is summed in normalized parameter space, then clamped to the
  // original control range. Full depth is one half of a control's total span,
  // keeping feedback, output, and delay targets inside their established limits.
  function modulated_parameter(parameter_index, minimum, maximum, step)
    local(value, modulation, range) (
    value = slider(parameter_index);
    modulation = 0;
    (slider34 | 0) == parameter_index ? modulation += lfo1_value*slider37/100;
    (slider38 | 0) == parameter_index ? modulation += lfo2_value*slider41/100;
    (slider42 | 0) == parameter_index ? modulation += lfo3_value*slider45/100;
    (slider46 | 0) == parameter_index ? modulation += lfo4_value*slider49/100;
    range = maximum - minimum;
    value += modulation*range*0.5;
    step > 0 ? value = minimum + floor((value - minimum)/step + 0.5)*step;
    min(maximum, max(minimum, value));
  );

  function shape_db_at(frequency)
    local(shifted_frequency, normalized_position, scaled_position,
          index_a, index_b, fraction, value_a, value_b) (
    shifted_frequency = frequency / (2 ^ shape_total_shift_octaves);
    normalized_position = log(max(20, min(20000, shifted_frequency)) / 20)
                          / log(20000 / 20);
    scaled_position = normalized_position * (shape_point_count - 1);
    index_a = floor(scaled_position);
    index_b = min(shape_point_count - 1, index_a + 1);
    fraction = scaled_position - index_a;
    value_a = shape_a[index_a]*(1 - fraction) + shape_a[index_b]*fraction;
    value_b = shape_b[index_a]*(1 - fraction) + shape_b[index_b]*fraction;
    value_a + (value_b - value_a)*shape_morph;
  );

  function spectral_gain(frequency) local(gain, position_in_edge, tilt_db, draw_db) (
    gain = 1;

    frequency <= 0 ? (
      gain = 0;
    ) : (
      frequency < low_hz ? (
        position_in_edge = log(frequency / low_edge_start) / log(2) / edge_octaves;
        gain *= smooth_step(position_in_edge);
      );

      frequency > high_hz ? (
        position_in_edge = 1 - log(frequency / high_hz) / log(2) / edge_octaves;
        gain *= smooth_step(position_in_edge);
      );

      tilt_db = tilt_db_per_octave * log(frequency / 1000) / log(2);
      tilt_db = min(36, max(-60, tilt_db));
      // Expand the hand-drawn response around 0 dB without moving its neutral point.
      // The asymmetric limits keep boosts bold but controlled while allowing
      // near-silent spectral notches at the bottom of the drawing area.
      draw_db = shape_db_at(frequency) * 1.65;
      draw_db = min(20, max(-96, draw_db));
      gain *= exp((tilt_db + draw_db) * log(10) / 20);
    );

    gain;
  );

  function shape_spectrum(block, magnitude_history)
    local(bin, fft_index, mirror_index, frequency, response,
          real_value, imaginary_value, magnitude, remembered_magnitude,
          shaped_magnitude, magnitude_db, scale, phase_angle,
          cosine_value, sine_value, mirror_real, mirror_imaginary) (

    fft(block, fftsize);
    fft_permute(block, fftsize);

    bin = 0;
    fft_index = 0;
    loop(fftsize / 2,
      frequency = bin * srate / fftsize;
      response = spectral_gain(frequency);
      mirror_index = 2*fftsize - fft_index - 2;

      real_value = block[fft_index];
      imaginary_value = block[fft_index + 1];
      magnitude = sqrt(real_value*real_value + imaginary_value*imaginary_value);

      remembered_magnitude = magnitude_history[bin];
      remembered_magnitude <= 0 ? remembered_magnitude = magnitude;
      shaped_magnitude = remembered_magnitude*smear_coefficient
                         + magnitude*(1 - smear_coefficient);
      magnitude_history[bin] = shaped_magnitude;

      grain_amount > 0 && shaped_magnitude > 0.000000000001 ? (
        magnitude_db = 20 * log(shaped_magnitude) / log(10);
        magnitude_db = floor(magnitude_db / grain_step_db + 0.5) * grain_step_db;
        shaped_magnitude = exp(magnitude_db * log(10) / 20);
      );

      magnitude > 0.000000000001 ? (
        scale = response * min(16, shaped_magnitude / magnitude);
      ) : (
        scale = 0;
      );

      phase_angle = bin > 0 ? (rand(2) - 1) * $pi * phase_scatter_amount : 0;
      cosine_value = cos(phase_angle);
      sine_value = sin(phase_angle);

      real_value *= scale;
      imaginary_value *= scale;
      block[fft_index] = real_value*cosine_value - imaginary_value*sine_value;
      block[fft_index + 1] = real_value*sine_value + imaginary_value*cosine_value;

      // Matching opposite rotation preserves a real-valued channel.
      mirror_real = block[mirror_index] * scale;
      mirror_imaginary = block[mirror_index + 1] * scale;
      block[mirror_index] = mirror_real*cosine_value + mirror_imaginary*sine_value;
      block[mirror_index + 1] = -mirror_real*sine_value + mirror_imaginary*cosine_value;

      fft_index += 2;
      bin += 1;
    );
  );

  function delay_read(buffer, write_frame, delay_frames, buffer_frames, channel)
    local(read_frame, index_a, index_b, fraction) (
    read_frame = write_frame - delay_frames;
    read_frame < 0 ? read_frame += buffer_frames;
    index_a = floor(read_frame);
    index_b = index_a + 1;
    index_b >= buffer_frames ? index_b = 0;
    fraction = read_frame - index_a;
    buffer[2*index_a + channel]*(1 - fraction)
      + buffer[2*index_b + channel]*fraction;
  );

  function diffuse_allpass(buffer, write_frame, buffer_frames,
                           delay_frames, channel, input, coefficient)
    local(read_frame, delayed, output) (
    read_frame = write_frame - delay_frames;
    read_frame < 0 ? read_frame += buffer_frames;
    delayed = buffer[2*read_frame + channel];
    output = delayed - coefficient*input;
    buffer[2*write_frame + channel] = input + coefficient*output;
    output;
  );

  function distort_band(input, gain, fuzz)
    local(driven, soft_shape, hard_shape) (
    driven = input*gain;
    soft_shape = driven/(1 + abs(driven));
    hard_shape = min(1, max(-1, driven));
    soft_shape*(1 - fuzz) + hard_shape*fuzz;
  );

  function random_stepped(minimum, maximum, step)
    local(value) (
    value = minimum + rand(1)*(maximum - minimum);
    step > 0 ? value = minimum
                     + floor((value - minimum)/step + 0.5)*step;
    min(maximum, max(minimum, value));
  );

  function randomize_parameters() (
    slider_automate(slider1 = random_stepped(10, 1000, 1));
    slider_automate(slider2 = random_stepped(1000, 24000, 10));
    slider_automate(slider3 = random_stepped(0.1, 4, 0.1));
    slider_automate(slider4 = random_stepped(-12, 12, 0.1));
    // slider5 is Master Output and is deliberately never randomized.
    slider_automate(slider6 = random_stepped(0, 5, 1));
    slider_automate(slider7 = random_stepped(0, 100, 1));
    slider_automate(slider8 = random_stepped(0, 100, 1));
    slider_automate(slider9 = random_stepped(0, 100, 1));
    slider_automate(slider10 = random_stepped(0, 4, 1));
    slider_automate(slider11 = random_stepped(0, 100, 0.1));
    slider_automate(slider12 = random_stepped(-4, 4, 0.01));
    slider_automate(slider13 = random_stepped(0, 4, 0.01));
    slider_automate(slider14 = random_stepped(0, 10, 0.01));
    slider_automate(slider15 = random_stepped(1, 2000, 1));
    slider_automate(slider16 = random_stepped(1, 2000, 1));
    slider_automate(slider17 = random_stepped(0, 95, 0.1));
    slider_automate(slider18 = random_stepped(0, 100, 0.1));
    slider_automate(slider19 = random_stepped(0, 100, 0.1));
    slider_automate(slider20 = random_stepped(0, 100, 0.1));
    slider_automate(slider21 = random_stepped(1, 2000, 1));
    slider_automate(slider22 = random_stepped(1, 2000, 1));
    slider_automate(slider23 = random_stepped(0, 95, 0.1));
    slider_automate(slider24 = random_stepped(0, 100, 0.1));
    slider_automate(slider25 = random_stepped(0, 100, 0.1));
    slider_automate(slider26 = random_stepped(0, 100, 0.1));
    slider_automate(slider27 = random_stepped(0, 100, 0.1));
    slider_automate(slider28 = random_stepped(0, 100, 0.1));
    slider_automate(slider29 = random_stepped(0, 100, 0.1));
    slider_automate(slider30 = random_stepped(0, 100, 0.1));
    slider_automate(slider31 = random_stepped(0, 60, 0.1));
    slider_automate(slider32 = random_stepped(0, 60, 0.1));
    slider_automate(slider33 = random_stepped(0, 60, 0.1));
  );

  function refresh_control_state() (

  control1 = modulated_parameter(1, 10, 1000, 0);
  control2 = modulated_parameter(2, 1000, 24000, 0);
  control3 = modulated_parameter(3, 0.1, 4, 0);
  control4 = modulated_parameter(4, -12, 12, 0);
  control5 = modulated_parameter(5, -24, 12, 0);
  control6 = modulated_parameter(6, 0, 5, 1);
  control7 = modulated_parameter(7, 0, 100, 0);
  control8 = modulated_parameter(8, 0, 100, 0);
  control9 = modulated_parameter(9, 0, 100, 0);
  control10 = modulated_parameter(10, 0, 4, 1);
  control11 = modulated_parameter(11, 0, 100, 0);
  control12 = modulated_parameter(12, -4, 4, 0);
  control13 = modulated_parameter(13, 0, 4, 0);
  control14 = modulated_parameter(14, 0, 10, 0);
  control15 = modulated_parameter(15, 1, 2000, 0);
  control16 = modulated_parameter(16, 1, 2000, 0);
  control17 = modulated_parameter(17, 0, 95, 0);
  control18 = modulated_parameter(18, 0, 100, 0);
  control19 = modulated_parameter(19, 0, 100, 0);
  control20 = modulated_parameter(20, 0, 100, 0);
  control21 = modulated_parameter(21, 1, 2000, 0);
  control22 = modulated_parameter(22, 1, 2000, 0);
  control23 = modulated_parameter(23, 0, 95, 0);
  control24 = modulated_parameter(24, 0, 100, 0);
  control25 = modulated_parameter(25, 0, 100, 0);
  control26 = modulated_parameter(26, 0, 100, 0);
  control27 = modulated_parameter(27, 0, 100, 0);
  control28 = modulated_parameter(28, 0, 100, 0);
  control29 = modulated_parameter(29, 0, 100, 0);
  control30 = modulated_parameter(30, 0, 100, 0);
  control31 = modulated_parameter(31, 0, 60, 0);
  control32 = modulated_parameter(32, 0, 60, 0);
  control33 = modulated_parameter(33, 0, 60, 0);

  low_hz = max(10, min(control1, srate * 0.49));
  high_hz = max(low_hz, min(control2, srate * 0.49));
  edge_octaves = max(0.1, control3);
  tilt_db_per_octave = control4;
  output_gain = exp(control5 * log(10) / 20);
  smear_coefficient = control7 <= 0 ? 0 : 1 - exp(-0.055 * control7);
  grain_amount = control8 / 100;
  grain_step_db = 0.25 + grain_amount*grain_amount*23.75;
  phase_scatter_amount = (control9 / 100) ^ 2;
  frame_repeat_count = control10 | 0;

  shape_morph = control11 / 100;
  shape_manual_shift_octaves = control12;
  auto_sweep_depth_octaves = control13;
  auto_sweep_rate_hz = control14;

  low_edge_start = max(1, low_hz / (2 ^ edge_octaves));

  pre_delay_left_target = min(delay_buffer_frames - 2, max(1, control15*srate/1000));
  pre_delay_right_target = min(delay_buffer_frames - 2, max(1, control16*srate/1000));
  pre_feedback = control17 / 100;
  pre_crossfeed = control18 / 100;
  pre_damping_cutoff = 20000 * ((600 / 20000) ^ (control19 / 100));
  pre_damping_cutoff = min(srate*0.45, pre_damping_cutoff);
  pre_damping_alpha = control19 <= 0 ? 1 : 1 - exp(-2*$pi*pre_damping_cutoff/srate);
  pre_mix = control20 / 100;
  pre_diffusion_amount = control28 / 100;
  pre_diffusion_insert = smooth_step(min(1, pre_diffusion_amount*20));
  pre_diffusion_coefficient = 0.22 + sqrt(pre_diffusion_amount)*0.56;
  pre_diffusion_a_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0023)));
  pre_diffusion_a_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0037)));
  pre_diffusion_b_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0057)));
  pre_diffusion_b_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0079)));
  pre_diffusion_c_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0097)));
  pre_diffusion_c_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0127)));
  pre_diffusion_d_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0149)));
  pre_diffusion_d_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0191)));

  post_delay_left_target = min(delay_buffer_frames - 2, max(1, control21*srate/1000));
  post_delay_right_target = min(delay_buffer_frames - 2, max(1, control22*srate/1000));
  post_feedback = control23 / 100;
  post_crossfeed = control24 / 100;
  post_damping_cutoff = 20000 * ((600 / 20000) ^ (control25 / 100));
  post_damping_cutoff = min(srate*0.45, post_damping_cutoff);
  post_damping_alpha = control25 <= 0 ? 1 : 1 - exp(-2*$pi*post_damping_cutoff/srate);
  post_mix = control26 / 100;
  post_diffusion_amount = control29 / 100;
  post_diffusion_insert = smooth_step(min(1, post_diffusion_amount*20));
  post_diffusion_coefficient = 0.22 + sqrt(post_diffusion_amount)*0.56;
  post_diffusion_a_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0031)));
  post_diffusion_a_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0047)));
  post_diffusion_b_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0067)));
  post_diffusion_b_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0091)));
  post_diffusion_c_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0113)));
  post_diffusion_c_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0149)));
  post_diffusion_d_left = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0173)));
  post_diffusion_d_right = min(diffusion_buffer_frames - 1, max(1, floor(srate*0.0239)));
  pre_fx_character_target = control27 / 100;
  pre_fx_spread_target = control30 / 100;
  pre_fx_low_xover = 1 - exp(-2*$pi*250/srate);
  pre_fx_high_xover = 1 - exp(-2*$pi*2500/srate);
  pre_fx_low_band_gain = exp(control31*log(10)/20);
  pre_fx_mid_band_gain = exp(control32*log(10)/20);
  pre_fx_high_band_gain = exp(control33*log(10)/20);

  pre_delay_left_current <= 0 ? pre_delay_left_current = pre_delay_left_target;
  pre_delay_right_current <= 0 ? pre_delay_right_current = pre_delay_right_target;
  post_delay_left_current <= 0 ? post_delay_left_current = post_delay_left_target;
  post_delay_right_current <= 0 ? post_delay_right_current = post_delay_right_target;

  requested_fft_size = (2 ^ (control6 + 10)) | 0;
  requested_fft_size != fftsize ? (
    fftsize = requested_fft_size;
    position = 0;
    repeat_remaining = 0;
    memset(left_a, 0, 2 * 32768);
    memset(left_b, 0, 2 * 32768);
    memset(right_a, 0, 2 * 32768);
    memset(right_b, 0, 2 * 32768);
    memset(left_magnitude, 0, 16384);
    memset(right_magnitude, 0, 16384);
    memset(held_left, 0, 2 * 32768);
    memset(held_right, 0, 2 * 32768);
    memset(window, 0, 16384);

    phase = 2 * $pi / fftsize;
    index = 0;
    loop(fftsize / 2,
      window[index] = 0.42 - 0.50*cos(index*phase) + 0.08*cos(2*index*phase);
      index += 1;
    );

    pdc_delay = fftsize;
    ext_tail_size = -1;
  );
  );

@slider

  refresh_control_state();

@block

  lfo1_previous_phase = lfo1_phase;
  lfo2_previous_phase = lfo2_phase;
  lfo3_previous_phase = lfo3_phase;
  lfo4_previous_phase = lfo4_phase;
  lfo1_phase += slider36*samplesblock/srate;
  lfo2_phase += slider40*samplesblock/srate;
  lfo3_phase += slider44*samplesblock/srate;
  lfo4_phase += slider48*samplesblock/srate;
  lfo1_phase -= floor(lfo1_phase);
  lfo2_phase -= floor(lfo2_phase);
  lfo3_phase -= floor(lfo3_phase);
  lfo4_phase -= floor(lfo4_phase);
  lfo1_phase < lfo1_previous_phase ? lfo1_random = rand(2) - 1;
  lfo2_phase < lfo2_previous_phase ? lfo2_random = rand(2) - 1;
  lfo3_phase < lfo3_previous_phase ? lfo3_random = rand(2) - 1;
  lfo4_phase < lfo4_previous_phase ? lfo4_random = rand(2) - 1;
  lfo1_value = lfo_wave(slider35 | 0, lfo1_phase, lfo1_random);
  lfo2_value = lfo_wave(slider39 | 0, lfo2_phase, lfo2_random);
  lfo3_value = lfo_wave(slider43 | 0, lfo3_phase, lfo3_random);
  lfo4_value = lfo_wave(slider47 | 0, lfo4_phase, lfo4_random);

  // Custom @gfx controls update slider values outside REAPER's stock UI.
  // Refresh every derived coefficient and target once per audio block so the
  // sound always follows the visible knobs immediately.
  refresh_control_state();

@serialize

  file_mem(0, shape_a, shape_point_count) ? shape_initialized = 1;
  file_mem(0, shape_b, shape_point_count) ? shape_initialized = 1;

@sample

  // Automatable sine sweep moves the drawing over the log-frequency axis.
  auto_sweep_phase += auto_sweep_rate_hz / srate;
  auto_sweep_phase >= 1 ? auto_sweep_phase -= 1;
  shape_total_shift_octaves = shape_manual_shift_octaves
                              + sin(2*$pi*auto_sweep_phase)*auto_sweep_depth_octaves;

  delay_smoothing = 0.001;
  pre_delay_left_current += (pre_delay_left_target - pre_delay_left_current)*delay_smoothing;
  pre_delay_right_current += (pre_delay_right_target - pre_delay_right_current)*delay_smoothing;
  post_delay_left_current += (post_delay_left_target - post_delay_left_current)*delay_smoothing;
  post_delay_right_current += (post_delay_right_target - post_delay_right_current)*delay_smoothing;

  // Stereo delay before the spectral stage.
  chain_input_left = spl0;
  chain_input_right = spl1;
  pre_wet_left = delay_read(pre_delay_buffer, pre_write_frame,
                            pre_delay_left_current, delay_buffer_frames, 0);
  pre_wet_right = delay_read(pre_delay_buffer, pre_write_frame,
                             pre_delay_right_current, delay_buffer_frames, 1);

  // Four staggered stereo all-pass stages turn discrete echoes into a dense
  // cloud. Above the bottom five percent of the knob range it is a serial,
  // magnitude-flat insert rather than a parallel phase blend, avoiding the
  // comb filtering and low-mid buildup of the previous implementation.
  pre_diffused_a_left = diffuse_allpass(pre_diffusion_a_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_a_left, 0, pre_wet_left, pre_diffusion_coefficient);
  pre_diffused_a_right = diffuse_allpass(pre_diffusion_a_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_a_right, 1, pre_wet_right, pre_diffusion_coefficient);
  pre_diffused_b_left = diffuse_allpass(pre_diffusion_b_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_b_left, 0, pre_diffused_a_left, pre_diffusion_coefficient);
  pre_diffused_b_right = diffuse_allpass(pre_diffusion_b_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_b_right, 1, pre_diffused_a_right, pre_diffusion_coefficient);
  pre_diffused_c_left = diffuse_allpass(pre_diffusion_c_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_c_left, 0, pre_diffused_b_left, pre_diffusion_coefficient);
  pre_diffused_c_right = diffuse_allpass(pre_diffusion_c_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_c_right, 1, pre_diffused_b_right, pre_diffusion_coefficient);
  pre_diffused_d_left = diffuse_allpass(pre_diffusion_d_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_d_left, 0, pre_diffused_c_left, pre_diffusion_coefficient);
  pre_diffused_d_right = diffuse_allpass(pre_diffusion_d_buffer,
    pre_diffusion_write_frame, diffusion_buffer_frames,
    pre_diffusion_d_right, 1, pre_diffused_c_right, pre_diffusion_coefficient);
  pre_diffusion_write_frame += 1;
  pre_diffusion_write_frame >= diffusion_buffer_frames ? pre_diffusion_write_frame = 0;
  pre_wet_left = pre_wet_left*(1 - pre_diffusion_insert)
                 + pre_diffused_d_left*pre_diffusion_insert;
  pre_wet_right = pre_wet_right*(1 - pre_diffusion_insert)
                  + pre_diffused_d_right*pre_diffusion_insert;

  pre_feedback_state_left += (pre_wet_left - pre_feedback_state_left)*pre_damping_alpha;
  pre_feedback_state_right += (pre_wet_right - pre_feedback_state_right)*pre_damping_alpha;
  pre_feedback_to_left = pre_feedback_state_left*(1 - pre_crossfeed)
                         + pre_feedback_state_right*pre_crossfeed;
  pre_feedback_to_right = pre_feedback_state_right*(1 - pre_crossfeed)
                          + pre_feedback_state_left*pre_crossfeed;
  pre_delay_buffer[2*pre_write_frame] = chain_input_left + pre_feedback_to_left*pre_feedback;
  pre_delay_buffer[2*pre_write_frame + 1] = chain_input_right + pre_feedback_to_right*pre_feedback;
  pre_write_frame += 1;
  pre_write_frame >= delay_buffer_frames ? pre_write_frame = 0;

  input_left = chain_input_left*(1 - pre_mix) + pre_wet_left*pre_mix;
  input_right = chain_input_right*(1 - pre_mix) + pre_wet_right*pre_mix;

  // Cloudbox-style reconstructing crossover: low below 250 Hz, mid between
  // 250 Hz and 2.5 kHz, and high above 2.5 kHz. Since mid is the residual,
  // the three clean bands sum exactly to the input.
  pre_fx_character += (pre_fx_character_target - pre_fx_character) * 0.002;
  pre_fx_spread += (pre_fx_spread_target - pre_fx_spread) * 0.002;
  pre_fx_low_state_left += pre_fx_low_xover*(input_left - pre_fx_low_state_left);
  pre_fx_low_state_right += pre_fx_low_xover*(input_right - pre_fx_low_state_right);
  pre_fx_high_state_left += pre_fx_high_xover*(input_left - pre_fx_high_state_left);
  pre_fx_high_state_right += pre_fx_high_xover*(input_right - pre_fx_high_state_right);
  pre_fx_low_left = pre_fx_low_state_left;
  pre_fx_low_right = pre_fx_low_state_right;
  pre_fx_high_left = input_left - pre_fx_high_state_left;
  pre_fx_high_right = input_right - pre_fx_high_state_right;
  pre_fx_mid_left = input_left - pre_fx_low_left - pre_fx_high_left;
  pre_fx_mid_right = input_right - pre_fx_low_right - pre_fx_high_right;

  // Character zero remains an exact clean bypass. Above zero the three bands
  // saturate independently, then the recombined signal moves into fuzz and
  // finally the restrained Cloudbox-style crusher.
  pre_fx_character > 0.00001 ? (
    pre_fx_dry_left = input_left;
    pre_fx_dry_right = input_right;
    pre_fx_base_fuzz = min(1, pre_fx_character*2);
    pre_fx_base_crush = max(0, (pre_fx_character - 0.5)*2);
    pre_fx_base_wet = min(1, pre_fx_character*4);
    pre_fx_fuzz_left = max(0, pre_fx_base_fuzz - pre_fx_spread*0.85);
    pre_fx_fuzz_right = min(1, pre_fx_base_fuzz + pre_fx_spread*0.85);
    pre_fx_crush_left = max(0, pre_fx_base_crush - pre_fx_spread*0.90);
    pre_fx_crush_right = min(1, pre_fx_base_crush
                             + pre_fx_spread*(0.30 + pre_fx_character*0.55));
    pre_fx_drive_db_left = 3 + pre_fx_character*27 - pre_fx_spread*3;
    pre_fx_drive_db_right = 3 + pre_fx_character*27 + pre_fx_spread*3;
    pre_fx_drive_left = exp(pre_fx_drive_db_left*log(10)/20);
    pre_fx_drive_right = exp(pre_fx_drive_db_right*log(10)/20);
    pre_fx_trim = exp((-3 - pre_fx_character*9)*log(10)/20);

    pre_fx_dist_low_left = distort_band(pre_fx_low_left,
      pre_fx_drive_left*pre_fx_low_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_low_right = distort_band(pre_fx_low_right,
      pre_fx_drive_right*pre_fx_low_band_gain, pre_fx_fuzz_right);
    pre_fx_dist_mid_left = distort_band(pre_fx_mid_left,
      pre_fx_drive_left*pre_fx_mid_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_mid_right = distort_band(pre_fx_mid_right,
      pre_fx_drive_right*pre_fx_mid_band_gain, pre_fx_fuzz_right);
    pre_fx_dist_high_left = distort_band(pre_fx_high_left,
      pre_fx_drive_left*pre_fx_high_band_gain, pre_fx_fuzz_left);
    pre_fx_dist_high_right = distort_band(pre_fx_high_right,
      pre_fx_drive_right*pre_fx_high_band_gain, pre_fx_fuzz_right);

    // Width is frequency-conscious: bass stays anchored while mid and high
    // character differences grow dramatically. The dry path is never widened.
    pre_fx_band_mid = (pre_fx_dist_low_left + pre_fx_dist_low_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_low_left - pre_fx_dist_low_right)*0.5
                       * (1 + pre_fx_spread*0.75);
    pre_fx_wide_low_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_low_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_band_mid = (pre_fx_dist_mid_left + pre_fx_dist_mid_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_mid_left - pre_fx_dist_mid_right)*0.5
                       * (1 + pre_fx_spread*4.00);
    pre_fx_wide_mid_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_mid_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_band_mid = (pre_fx_dist_high_left + pre_fx_dist_high_right)*0.5;
    pre_fx_band_side = (pre_fx_dist_high_left - pre_fx_dist_high_right)*0.5
                       * (1 + pre_fx_spread*7.00);
    pre_fx_wide_high_left = pre_fx_band_mid + pre_fx_band_side;
    pre_fx_wide_high_right = pre_fx_band_mid - pre_fx_band_side;

    pre_fx_spread_norm = 1/(1 + pre_fx_spread*0.35);
    pre_fx_processed_left = (pre_fx_wide_low_left + pre_fx_wide_mid_left
                             + pre_fx_wide_high_left)*pre_fx_spread_norm;
    pre_fx_processed_right = (pre_fx_wide_low_right + pre_fx_wide_mid_right
                              + pre_fx_wide_high_right)*pre_fx_spread_norm;

    pre_fx_steps_left = max(16, floor(128 - pre_fx_crush_left*112));
    pre_fx_hold_period_left = 1 + floor(pre_fx_crush_left*5);
    pre_fx_hold_counter_left <= 0 ? (
      pre_fx_held_left = floor(pre_fx_processed_left*pre_fx_steps_left + 0.5)
                         / pre_fx_steps_left;
      pre_fx_hold_counter_left = pre_fx_hold_period_left;
    ) : pre_fx_hold_counter_left -= 1;
    pre_fx_processed_left = pre_fx_processed_left*(1 - pre_fx_crush_left)
                            + pre_fx_held_left*pre_fx_crush_left;

    pre_fx_steps_right = max(16, floor(128 - pre_fx_crush_right*112));
    pre_fx_hold_period_right = 1 + floor(pre_fx_crush_right*5);
    pre_fx_hold_counter_right <= 0 ? (
      pre_fx_held_right = floor(pre_fx_processed_right*pre_fx_steps_right + 0.5)
                          / pre_fx_steps_right;
      pre_fx_hold_counter_right = pre_fx_hold_period_right;
    ) : pre_fx_hold_counter_right -= 1;
    pre_fx_processed_right = pre_fx_processed_right*(1 - pre_fx_crush_right)
                             + pre_fx_held_right*pre_fx_crush_right;

    pre_fx_cutoff_left = min(srate*0.45,
                             (18000 - pre_fx_crush_left*6000)
                             * (1 - pre_fx_spread*0.15));
    pre_fx_cutoff_right = min(srate*0.45, 18000 - pre_fx_crush_right*6000);
    pre_fx_cut_coefficient_left = 1 - exp(-2*$pi*pre_fx_cutoff_left/srate);
    pre_fx_cut_coefficient_right = 1 - exp(-2*$pi*pre_fx_cutoff_right/srate);
    pre_fx_filter_left += pre_fx_cut_coefficient_left
                          * (pre_fx_processed_left - pre_fx_filter_left);
    pre_fx_filter_right += pre_fx_cut_coefficient_right
                           * (pre_fx_processed_right - pre_fx_filter_right);
    pre_fx_processed_left = pre_fx_filter_left*pre_fx_trim;
    pre_fx_processed_right = pre_fx_filter_right*pre_fx_trim;
    input_left = pre_fx_dry_left*(1 - pre_fx_base_wet)
                 + pre_fx_processed_left*pre_fx_base_wet;
    input_right = pre_fx_dry_right*(1 - pre_fx_base_wet)
                  + pre_fx_processed_right*pre_fx_base_wet;
  ) : (
    pre_fx_filter_left = input_left;
    pre_fx_filter_right = input_right;
    pre_fx_hold_counter_left = 0;
    pre_fx_hold_counter_right = 0;
  );

  // FFT overlap-add stage.
  position >= fftsize ? (
    temporary = left_a;
    left_a = left_b;
    left_b = temporary;

    temporary = right_a;
    right_a = right_b;
    right_b = temporary;

    repeat_remaining > 0 ? (
      memcpy(left_a, held_left, 2 * fftsize);
      memcpy(right_a, held_right, 2 * fftsize);
      repeat_remaining -= 1;
    ) : (
      shape_spectrum(left_a, left_magnitude);
      shape_spectrum(right_a, right_magnitude);
      memcpy(held_left, left_a, 2 * fftsize);
      memcpy(held_right, right_a, 2 * fftsize);
      repeat_remaining = frame_repeat_count;
    );

    fft_ipermute(left_a, fftsize);
    ifft(left_a, fftsize);
    fft_ipermute(right_a, fftsize);
    ifft(right_a, fftsize);
    position = 0;
  );

  window_a = window[position / 2];
  window_b = window[(fftsize - position) / 2 - 1];
  normalization = max(0.000000001, (window_a + window_b) * fftsize);

  spectral_left = (left_a[position] + left_b[fftsize + position]) / normalization;
  spectral_right = (right_a[position] + right_b[fftsize + position]) / normalization;

  left_a[position] = window_a * input_left;
  left_a[position + 1] = 0;
  left_b[fftsize + position] = window_b * input_left;
  left_b[fftsize + position + 1] = 0;
  right_a[position] = window_a * input_right;
  right_a[position + 1] = 0;
  right_b[fftsize + position] = window_b * input_right;
  right_b[fftsize + position + 1] = 0;
  position += 2;

  spectral_left *= output_gain;
  spectral_right *= output_gain;

  // Stereo delay after the spectral stage.
  post_wet_left = delay_read(post_delay_buffer, post_write_frame,
                             post_delay_left_current, delay_buffer_frames, 0);
  post_wet_right = delay_read(post_delay_buffer, post_write_frame,
                              post_delay_right_current, delay_buffer_frames, 1);
  post_diffused_a_left = diffuse_allpass(post_diffusion_a_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_a_left, 0, post_wet_left, post_diffusion_coefficient);
  post_diffused_a_right = diffuse_allpass(post_diffusion_a_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_a_right, 1, post_wet_right, post_diffusion_coefficient);
  post_diffused_b_left = diffuse_allpass(post_diffusion_b_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_b_left, 0, post_diffused_a_left, post_diffusion_coefficient);
  post_diffused_b_right = diffuse_allpass(post_diffusion_b_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_b_right, 1, post_diffused_a_right, post_diffusion_coefficient);
  post_diffused_c_left = diffuse_allpass(post_diffusion_c_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_c_left, 0, post_diffused_b_left, post_diffusion_coefficient);
  post_diffused_c_right = diffuse_allpass(post_diffusion_c_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_c_right, 1, post_diffused_b_right, post_diffusion_coefficient);
  post_diffused_d_left = diffuse_allpass(post_diffusion_d_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_d_left, 0, post_diffused_c_left, post_diffusion_coefficient);
  post_diffused_d_right = diffuse_allpass(post_diffusion_d_buffer,
    post_diffusion_write_frame, diffusion_buffer_frames,
    post_diffusion_d_right, 1, post_diffused_c_right, post_diffusion_coefficient);
  post_diffusion_write_frame += 1;
  post_diffusion_write_frame >= diffusion_buffer_frames ? post_diffusion_write_frame = 0;
  post_wet_left = post_wet_left*(1 - post_diffusion_insert)
                  + post_diffused_d_left*post_diffusion_insert;
  post_wet_right = post_wet_right*(1 - post_diffusion_insert)
                   + post_diffused_d_right*post_diffusion_insert;
  post_feedback_state_left += (post_wet_left - post_feedback_state_left)*post_damping_alpha;
  post_feedback_state_right += (post_wet_right - post_feedback_state_right)*post_damping_alpha;
  post_feedback_to_left = post_feedback_state_left*(1 - post_crossfeed)
                          + post_feedback_state_right*post_crossfeed;
  post_feedback_to_right = post_feedback_state_right*(1 - post_crossfeed)
                           + post_feedback_state_left*post_crossfeed;
  post_delay_buffer[2*post_write_frame] = spectral_left + post_feedback_to_left*post_feedback;
  post_delay_buffer[2*post_write_frame + 1] = spectral_right + post_feedback_to_right*post_feedback;
  post_write_frame += 1;
  post_write_frame >= delay_buffer_frames ? post_write_frame = 0;

  spl0 = spectral_left*(1 - post_mix) + post_wet_left*post_mix;
  spl1 = spectral_right*(1 - post_mix) + post_wet_right*post_mix;

@gfx 1160 830

  function set_rainbow_color(position, alpha)
    local(wrapped, segment, fraction) (
    wrapped = position - floor(position);
    segment = floor(wrapped * 6);
    fraction = wrapped*6 - segment;
    segment == 0 ? (gfx_r = 1; gfx_g = fraction; gfx_b = 0;);
    segment == 1 ? (gfx_r = 1 - fraction; gfx_g = 1; gfx_b = 0;);
    segment == 2 ? (gfx_r = 0; gfx_g = 1; gfx_b = fraction;);
    segment == 3 ? (gfx_r = 0; gfx_g = 1 - fraction; gfx_b = 1;);
    segment == 4 ? (gfx_r = fraction; gfx_g = 0; gfx_b = 1;);
    segment == 5 ? (gfx_r = 1; gfx_g = 0; gfx_b = 1 - fraction;);
    gfx_a = alpha;
  );

  function draw_shamrock(center_x, center_y, size) (
    gfx_r = 0.10; gfx_g = 0.78; gfx_b = 0.24; gfx_a = 1;
    gfx_circle(center_x - size*0.42, center_y - size*0.22, size*0.48, 1, 1);
    gfx_circle(center_x + size*0.42, center_y - size*0.22, size*0.48, 1, 1);
    gfx_circle(center_x, center_y - size*0.72, size*0.48, 1, 1);
    gfx_line(center_x, center_y, center_x + size*0.26, center_y + size*1.2, 1);
  );

  function draw_leprechaun_hat(x, y, size) (
    gfx_r = 0.02; gfx_g = 0.44; gfx_b = 0.14; gfx_a = 1;
    gfx_triangle(x + size*0.18, y, x + size*0.75, y,
                 x + size*0.90, y + size*0.68, x + size*0.08, y + size*0.68);
    gfx_r = 0.01; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(x + size*0.10, y + size*0.45, size*0.76, size*0.20);
    gfx_r = 1; gfx_g = 0.74; gfx_b = 0.06;
    gfx_rect(x + size*0.39, y + size*0.43, size*0.22, size*0.24);
    gfx_r = 0.01; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(x + size*0.44, y + size*0.47, size*0.12, size*0.16);
    gfx_r = 0.03; gfx_g = 0.58; gfx_b = 0.18;
    gfx_rect(x, y + size*0.65, size, size*0.16);
  );

  function draw_leprechaun_face(center_x, center_y, size) (
    draw_leprechaun_hat(center_x - size*1.05, center_y - size*1.62, size*2.1);
    gfx_r = 1.00; gfx_g = 0.70; gfx_b = 0.42; gfx_a = 1;
    gfx_circle(center_x, center_y, size, 1, 1);
    gfx_r = 0.92; gfx_g = 0.25; gfx_b = 0.035; gfx_a = 1;
    gfx_rect(center_x - size, center_y + size*0.42, size*2, size*0.72);
    gfx_rect(center_x - size*0.72, center_y + size*0.96, size*1.44, size*0.42);
    gfx_r = 0.02; gfx_g = 0.08; gfx_b = 0.03; gfx_a = 1;
    gfx_rect(center_x - size*0.52, center_y - size*0.25, size*0.22, size*0.22);
    gfx_rect(center_x + size*0.30, center_y - size*0.25, size*0.22, size*0.22);
    gfx_r = 1; gfx_g = 0.44; gfx_b = 0.18; gfx_a = 1;
    gfx_rect(center_x - size*0.12, center_y, size*0.30, size*0.26);
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.68; gfx_a = 1;
    gfx_rect(center_x - size*0.42, center_y + size*0.36, size*0.84, size*0.18);
  );

  function draw_pixel_leprechaun(center_x, foot_y, size, coat_red, coat_green, coat_blue) (
    // Chunky 16-bit body, striped stockings, and square buckled shoes.
    gfx_r = 0.015; gfx_g = 0.045; gfx_b = 0.018; gfx_a = 0.72;
    gfx_rect(center_x - size*1.20 + 3, foot_y - size*3.35 + 3,
             size*2.40, size*3.35);
    gfx_r = coat_red; gfx_g = coat_green; gfx_b = coat_blue; gfx_a = 1;
    gfx_rect(center_x - size, foot_y - size*3.30, size*2, size*1.75);
    gfx_rect(center_x - size*1.42, foot_y - size*3.05, size*0.48, size*1.30);
    gfx_rect(center_x + size*0.94, foot_y - size*3.05, size*0.48, size*1.30);
    gfx_r = 0.03; gfx_g = 0.08; gfx_b = 0.025;
    gfx_rect(center_x - size, foot_y - size*2.22, size*2, size*0.35);
    gfx_r = 1; gfx_g = 0.74; gfx_b = 0.06;
    gfx_rect(center_x - size*0.25, foot_y - size*2.29, size*0.50, size*0.48);
    gfx_r = 0.96; gfx_g = 0.62; gfx_b = 0.08;
    gfx_rect(center_x - size*0.78, foot_y - size*1.55, size*0.55, size*1.20);
    gfx_rect(center_x + size*0.23, foot_y - size*1.55, size*0.55, size*1.20);
    gfx_r = 0.98; gfx_g = 0.94; gfx_b = 0.66;
    gfx_rect(center_x - size*0.78, foot_y - size*1.20, size*0.55, size*0.22);
    gfx_rect(center_x + size*0.23, foot_y - size*0.72, size*0.55, size*0.22);
    gfx_r = 0.025; gfx_g = 0.045; gfx_b = 0.018;
    gfx_rect(center_x - size*1.02, foot_y - size*0.40, size*0.82, size*0.40);
    gfx_rect(center_x + size*0.20, foot_y - size*0.40, size*0.82, size*0.40);
    gfx_r = 1; gfx_g = 0.72; gfx_b = 0.05;
    gfx_rect(center_x - size*0.84, foot_y - size*0.34, size*0.24, size*0.20);
    gfx_rect(center_x + size*0.56, foot_y - size*0.34, size*0.24, size*0.20);
    draw_leprechaun_face(center_x, foot_y - size*4.18, size*0.92);
  );

  function draw_pixel_mushroom(x, y, scale) (
    gfx_r = 0.90; gfx_g = 0.06; gfx_b = 0.30; gfx_a = 1;
    gfx_rect(x + scale*2, y, scale*6, scale*2);
    gfx_rect(x, y + scale*2, scale*10, scale*3);
    gfx_r = 1; gfx_g = 0.90; gfx_b = 0.56; gfx_a = 1;
    gfx_rect(x + scale*2, y + scale, scale, scale);
    gfx_rect(x + scale*7, y + scale*2, scale, scale);
    gfx_rect(x + scale*4, y + scale*5, scale*3, scale*4);
    gfx_r = 0.42; gfx_g = 0.18; gfx_b = 0.04; gfx_a = 1;
    gfx_rect(x + scale*3, y + scale*8, scale*5, scale);
  );

  function draw_pot_of_gold(center_x, bottom_y, size) local(coin) (
    coin = 0;
    loop(7,
      gfx_r = 1; gfx_g = 0.72 + 0.04*(coin % 2); gfx_b = 0.04; gfx_a = 1;
      gfx_circle(center_x - size*0.36 + coin*size*0.12,
                 bottom_y - size*0.72 - abs(3 - coin)*size*0.035,
                 size*0.13, 1, 1);
      coin += 1;
    );
    gfx_r = 0.025; gfx_g = 0.05; gfx_b = 0.025;
    gfx_triangle(center_x - size*0.48, bottom_y - size*0.62,
                 center_x + size*0.48, bottom_y - size*0.62,
                 center_x + size*0.32, bottom_y,
                 center_x - size*0.32, bottom_y);
    gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.08;
    gfx_rect(center_x - size*0.54, bottom_y - size*0.67, size*1.08, size*0.16);
  );

  function draw_pixel_rainbow(x, y, width, height, scale, alpha)
    local(band, inset) (
    band = 0;
    loop(7,
      inset = band * scale;
      set_rainbow_color(band / 7, alpha);
      gfx_rect(x + inset, y + inset, width - inset*2, scale);
      gfx_rect(x + inset, y + inset, scale, height - inset);
      gfx_rect(x + width - inset - scale, y + inset, scale, height - inset);
      band += 1;
    );
  );

  function draw_pixel_sparkle(x, y, size, red, green, blue) (
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.58;
    gfx_rect(x - size*2, y, size*5, size);
    gfx_rect(x, y - size*2, size, size*5);
    gfx_r = min(1, red*1.25 + 0.08); gfx_g = min(1, green*1.25 + 0.08);
    gfx_b = min(1, blue*1.25 + 0.08); gfx_a = 1;
    gfx_rect(x, y, size, size);
  );

  function draw_gold_coin(x, y, size) (
    gfx_r = 0.55; gfx_g = 0.24; gfx_b = 0.01; gfx_a = 0.88;
    gfx_circle(x + 2, y + 3, size, 1, 1);
    gfx_r = 1; gfx_g = 0.70; gfx_b = 0.03; gfx_a = 1;
    gfx_circle(x, y, size, 1, 1);
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.30; gfx_a = 0.92;
    gfx_rect(x - size*0.45, y - size*0.55, size*0.42, size*0.22);
  );

  function draw_coin_trail(x, y, count, spacing, size) local(coin) (
    coin = 0;
    loop(count,
      draw_gold_coin(x + coin*spacing,
                     y - abs((count - 1)*0.5 - coin)*size*0.65,
                     size);
      coin += 1;
    );
  );

  function draw_pixel_panel(x, y, width, height, red, green, blue, title)
    local(stripe) (
    gfx_r = 0.005; gfx_g = 0.035; gfx_b = 0.014; gfx_a = 0.42;
    gfx_rect(x + 5, y + 6, width, height);
    gfx_r = red*0.42; gfx_g = green*0.42; gfx_b = blue*0.42; gfx_a = 0.48;
    gfx_rect(x, y, width, height);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.20;
    gfx_rect(x + 4, y + 4, width - 8, height - 8);
    gfx_r = min(1, red*1.30 + 0.08); gfx_g = min(1, green*1.30 + 0.08);
    gfx_b = min(1, blue*1.30 + 0.08); gfx_a = 0.88;
    gfx_rect(x + 4, y + 4, width - 8, 3);
    gfx_rect(x + 4, y + 4, 3, height - 8);
    gfx_r = red*0.26; gfx_g = green*0.26; gfx_b = blue*0.26; gfx_a = 0.68;
    gfx_rect(x + 7, y + height - 8, width - 14, 4);
    stripe = 0;
    loop(max(1, floor(width / 18)),
      gfx_a = stripe % 2 ? 0.025 : 0.055;
      gfx_rect(x + 7 + stripe*18, y + 26, 9, height - 36);
      stripe += 1;
    );
    gfx_setfont(5, "Silom", 13, 'b');
    gfx_r = 0.015; gfx_g = 0.055; gfx_b = 0.018; gfx_a = 1;
    gfx_x = x + 14; gfx_y = y + 10; gfx_drawstr(title);
    gfx_x = x + 15; gfx_y = y + 10; gfx_drawstr(title);
  );

  function themed_knob(index, x, y, minimum, maximum, step, label, red, green, blue)
    local(value, shown_value, normalized, hover, new_value, angle, display_value) (
    value = slider(index);
    shown_value = index <= 33 ? modulated_parameter(index, minimum, maximum, step) : value;
    normalized = (shown_value - minimum) / max(0.0000001, maximum - minimum);
    hover = mouse_x >= x - 30 && mouse_x <= x + 30
            && mouse_y >= y - 30 && mouse_y <= y + 30;
    mouse_down && !last_mouse_down && hover ? (
      active_knob = index;
      knob_drag_origin_y = mouse_y;
      knob_drag_origin_value = value;
    );
    mouse_down && active_knob == index ? (
      new_value = knob_drag_origin_value
                  + (knob_drag_origin_y - mouse_y) * (maximum - minimum) / 170;
      step > 0 ? new_value = floor(new_value / step + 0.5) * step;
      new_value = min(maximum, max(minimum, new_value));
      slider_automate(slider(index) = new_value);
      value = new_value;
      shown_value = index <= 33
                    ? modulated_parameter(index, minimum, maximum, step)
                    : value;
      normalized = (shown_value - minimum) / max(0.0000001, maximum - minimum);
    );

    // Pixel shadow, colored bezel, stepped highlights, and a bright gold needle.
    gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.012; gfx_a = 0.82;
    gfx_circle(x + 4, y + 5, 27, 1, 1);
    gfx_r = red*0.38; gfx_g = green*0.38; gfx_b = blue*0.38; gfx_a = 1;
    gfx_circle(x, y, 27, 1, 1);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = hover || active_knob == index ? 1 : 0.84;
    gfx_circle(x, y, 23, 1, 1);
    gfx_r = 0.018; gfx_g = 0.075; gfx_b = 0.032; gfx_a = 1;
    gfx_circle(x, y, 17, 1, 1);
    gfx_r = min(1, red*1.35 + 0.08); gfx_g = min(1, green*1.35 + 0.08);
    gfx_b = min(1, blue*1.35 + 0.08); gfx_a = 0.94;
    gfx_rect(x - 12, y - 15, 7, 4); gfx_rect(x - 16, y - 10, 4, 7);
    angle = $pi * (0.75 + normalized * 1.5);
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.18; gfx_a = 1;
    gfx_line(x, y, x + cos(angle)*18, y + sin(angle)*18, 1);
    gfx_rect(x - 2, y - 2, 4, 4);

    gfx_setfont(6, "Silom", 10, 'b');
    gfx_r = 0.012; gfx_g = 0.045; gfx_b = 0.016; gfx_a = 1;
    gfx_x = x - 42; gfx_y = y + 32; gfx_drawstr(label);
    gfx_x = x - 41; gfx_y = y + 32; gfx_drawstr(label);
    gfx_x = x - 24; gfx_y = y + 45;
    index == 6 ? (
      display_value = 2 ^ ((shown_value | 0) + 10);
      gfx_drawnumber(display_value, 0);
    ) : step >= 1 ? gfx_drawnumber(shown_value, 0)
                  : step >= 0.1 ? gfx_drawnumber(shown_value, 1)
                                : gfx_drawnumber(shown_value, 2);
  );

  function draw_target_name(target) (
    target == 0 ? gfx_drawstr("NONE");
    target == 1 ? gfx_drawstr("LOW CUT");
    target == 2 ? gfx_drawstr("HIGH CUT");
    target == 3 ? gfx_drawstr("EDGE WIDTH");
    target == 4 ? gfx_drawstr("SPECTRAL TILT");
    target == 5 ? gfx_drawstr("OUTPUT");
    target == 6 ? gfx_drawstr("FFT SIZE");
    target == 7 ? gfx_drawstr("SMEAR");
    target == 8 ? gfx_drawstr("GRAIN");
    target == 9 ? gfx_drawstr("PHASE SCATTER");
    target == 10 ? gfx_drawstr("FRAME REPEAT");
    target == 11 ? gfx_drawstr("MORPH A/B");
    target == 12 ? gfx_drawstr("DRAWING SHIFT");
    target == 13 ? gfx_drawstr("SWEEP DEPTH");
    target == 14 ? gfx_drawstr("SWEEP RATE");
    target == 15 ? gfx_drawstr("PRE LEFT TIME");
    target == 16 ? gfx_drawstr("PRE RIGHT TIME");
    target == 17 ? gfx_drawstr("PRE FEEDBACK");
    target == 18 ? gfx_drawstr("PRE PINGPONG");
    target == 19 ? gfx_drawstr("PRE DAMPING");
    target == 20 ? gfx_drawstr("PRE MIX");
    target == 21 ? gfx_drawstr("POST LEFT TIME");
    target == 22 ? gfx_drawstr("POST RIGHT TIME");
    target == 23 ? gfx_drawstr("POST FEEDBACK");
    target == 24 ? gfx_drawstr("POST PINGPONG");
    target == 25 ? gfx_drawstr("POST DAMPING");
    target == 26 ? gfx_drawstr("POST MIX");
    target == 27 ? gfx_drawstr("GOLD");
    target == 28 ? gfx_drawstr("PRE DIFFUSION");
    target == 29 ? gfx_drawstr("POST DIFFUSION");
    target == 30 ? gfx_drawstr("DISTORT SPREAD");
    target == 31 ? gfx_drawstr("LOW DRIVE");
    target == 32 ? gfx_drawstr("MID DRIVE");
    target == 33 ? gfx_drawstr("HIGH DRIVE");
  );

  function draw_shape_name(shape) (
    shape == 0 ? gfx_drawstr("SINE");
    shape == 1 ? gfx_drawstr("TRIANGLE");
    shape == 2 ? gfx_drawstr("SQUARE");
    shape == 3 ? gfx_drawstr("SAW UP");
    shape == 4 ? gfx_drawstr("SAW DOWN");
    shape == 5 ? gfx_drawstr("RANDOM HOLD");
  );

  function themed_selector(index, x, y, width, minimum, maximum, label, kind,
                            red, green, blue)
    local(value, hover) (
    value = slider(index) | 0;
    hover = mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + 32;
    left_pressed && hover ? (
      mouse_x < x + width*0.5 ? value -= 1 : value += 1;
      value < minimum ? value = maximum;
      value > maximum ? value = minimum;
      slider_automate(slider(index) = value);
      button_consumed = 1;
    );
    gfx_r = red*0.30; gfx_g = green*0.30; gfx_b = blue*0.30; gfx_a = 1;
    gfx_rect(x + 3, y + 4, width, 32);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = hover ? 1 : 0.90;
    gfx_rect(x, y, width, 32);
    gfx_r = 0.015; gfx_g = 0.055; gfx_b = 0.020; gfx_a = 0.92;
    gfx_rect(x + 4, y + 4, width - 8, 24);
    gfx_setfont(6, "Silom", 9, 'b');
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.18; gfx_a = 1;
    gfx_x = x + 8; gfx_y = y + 9; gfx_drawstr("<");
    gfx_x = x + width - 14; gfx_y = y + 9; gfx_drawstr(">");
    gfx_r = min(1, red*1.2 + 0.18); gfx_g = min(1, green*1.2 + 0.18);
    gfx_b = min(1, blue*1.2 + 0.18);
    gfx_x = x + 24; gfx_y = y + 9;
    kind == 0 ? draw_target_name(value) : draw_shape_name(value);
    gfx_r = 0.012; gfx_g = 0.045; gfx_b = 0.016;
    gfx_x = x + 4; gfx_y = y - 13; gfx_drawstr(label);
  );

  function draw_lfo_preview(x, y, width, height, shape, phase_value, random_value,
                            red, green, blue)
    local(point, preview_phase, preview_value, px, py, previous_px, previous_py) (
    gfx_r = 0.005; gfx_g = 0.035; gfx_b = 0.014; gfx_a = 0.90;
    gfx_rect(x, y, width, height);
    gfx_r = red*0.55; gfx_g = green*0.55; gfx_b = blue*0.55; gfx_a = 0.50;
    gfx_line(x, y + height*0.5, x + width, y + height*0.5);
    point = 0;
    loop(64,
      preview_phase = point/63;
      preview_value = lfo_wave(shape, preview_phase, random_value);
      px = x + preview_phase*width;
      py = y + height*0.5 - preview_value*height*0.38;
      point > 0 ? (
        gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 1;
        gfx_line(previous_px, previous_py, px, py, 1);
      );
      previous_px = px;
      previous_py = py;
      point += 1;
    );
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.16; gfx_a = 1;
    gfx_circle(x + phase_value*width,
               y + height*0.5 - lfo_wave(shape, phase_value, random_value)*height*0.38,
               4, 1, 1);
  );

  function draw_lfo_card(x, y, width, height, number,
                         target_index, shape_index, rate_index, depth_index,
                         phase_value, random_value, red, green, blue) (
    number == 1 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 1  //  CLOVER CLOCK");
    number == 2 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 2  //  RAINBOW CLOCK");
    number == 3 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 3  //  GOLD CLOCK");
    number == 4 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 4  //  MOON CLOCK");
    themed_selector(target_index, x + 18, y + 48, 250, 0, 33,
                    "TARGET  //  CLICK LEFT OR RIGHT", 0, red, green, blue);
    themed_selector(shape_index, x + 282, y + 48, 160, 0, 5,
                    "SHAPE", 1, red, green, blue);
    themed_knob(rate_index, x + 92, y + 137, 0.05, 20, 0.01,
                "RATE HZ", red, green, blue);
    themed_knob(depth_index, x + 205, y + 137, 0, 100, 0.1,
                "DEPTH %", red, green, blue);
    draw_lfo_preview(x + 285, y + 111, width - 310, 55,
                     slider(shape_index) | 0, phase_value, random_value,
                     red, green, blue);
    draw_leprechaun_face(x + width - 38, y + height - 30, 10);
    draw_pot_of_gold(x + width - 84, y + height - 10, 18);
  );

  gfx_clear = 0x021308;
  margin_left = 58;
  margin_right = 18;
  margin_top = 92;
  margin_bottom = 470;
  graph_width = gfx_w - margin_left - margin_right;
  graph_height = gfx_h - margin_top - margin_bottom;

  // Layered pixel countryside: deep felt sky, checker texture, and rolling hills.
  gfx_r = 0.008; gfx_g = 0.105; gfx_b = 0.040; gfx_a = 1;
  gfx_rect(0, 0, gfx_w, gfx_h);
  texture_row = 0;
  loop(24,
    texture_column = 0;
    loop(34,
      (texture_row + texture_column) % 2 ? (
        gfx_r = 0.03; gfx_g = 0.20; gfx_b = 0.075; gfx_a = 0.10;
        gfx_rect(texture_column*36, 74 + texture_row*32, 18, 16);
      );
      texture_column += 1;
    );
    texture_row += 1;
  );
  gfx_r = 0.02; gfx_g = 0.26; gfx_b = 0.085; gfx_a = 0.86;
  gfx_circle(130, 835, 360, 1, 1); gfx_circle(570, 870, 430, 1, 1); gfx_circle(1050, 840, 340, 1, 1);
  gfx_r = 0.04; gfx_g = 0.38; gfx_b = 0.12; gfx_a = 0.30;
  gfx_rect(0, 790, gfx_w, 40);

  // A crowded lucky kingdom sits behind the translucent controls. These
  // decorations are deliberately drawn before the panels so their silhouettes
  // and colors remain visible without obscuring knob labels.
  draw_pixel_rainbow(36, 405, 248, 370, 5, 0.22);
  draw_pixel_rainbow(315, 455, 220, 330, 4, 0.20);
  draw_pixel_rainbow(620, 405, 270, 370, 5, 0.22);
  draw_pixel_rainbow(910, 470, 210, 315, 4, 0.24);
  draw_pixel_rainbow(458, 615, 236, 184, 3, 0.26);

  draw_pixel_leprechaun(58, 496, 7, 0.05, 0.72, 0.24);
  draw_pixel_leprechaun(156, 626, 8, 0.12, 0.88, 0.30);
  draw_pixel_leprechaun(276, 786, 7, 0.05, 0.62, 0.20);
  draw_pixel_leprechaun(405, 535, 6, 0.18, 0.82, 0.24);
  draw_pixel_leprechaun(515, 778, 8, 0.02, 0.70, 0.28);
  draw_pixel_leprechaun(650, 510, 7, 0.10, 0.84, 0.32);
  draw_pixel_leprechaun(758, 785, 8, 0.02, 0.64, 0.24);
  draw_pixel_leprechaun(865, 622, 7, 0.14, 0.90, 0.34);
  draw_pixel_leprechaun(1000, 790, 7, 0.05, 0.70, 0.20);
  draw_pixel_leprechaun(1100, 520, 6, 0.18, 0.78, 0.28);

  draw_pot_of_gold(100, 520, 22);
  draw_pot_of_gold(220, 647, 25);
  draw_pot_of_gold(344, 800, 23);
  draw_pot_of_gold(465, 558, 20);
  draw_pot_of_gold(580, 806, 27);
  draw_pot_of_gold(706, 538, 22);
  draw_pot_of_gold(824, 805, 26);
  draw_pot_of_gold(930, 650, 23);
  draw_pot_of_gold(1065, 807, 26);
  draw_pot_of_gold(1130, 558, 20);
  draw_coin_trail(75, 570, 8, 17, 4);
  draw_coin_trail(360, 690, 10, 18, 4);
  draw_coin_trail(720, 590, 9, 18, 4);
  draw_coin_trail(945, 710, 8, 17, 4);

  // Seven-color lucky rainbow ribbon.
  rainbow_strip = 0;
  loop(7,
    set_rainbow_color(rainbow_strip / 7, 1);
    gfx_rect(0, rainbow_strip*3, gfx_w, 3);
    rainbow_strip += 1;
  );

  draw_leprechaun_hat(14, 27, 47);
  gfx_setfont(1, "Silom", 26, 'b');
  gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.01; gfx_a = 0.9;
  gfx_x = 84; gfx_y = 29; gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_r = 1; gfx_g = 0.78; gfx_b = 0.08; gfx_a = 1;
  gfx_x = 81; gfx_y = 26;
  gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_x = 82; gfx_y = 26;
  gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_setfont(2, "Silom", 10, 'b');
  gfx_r = 0.28; gfx_g = 0.94; gfx_b = 0.40;
  gfx_x = 83; gfx_y = 57;
  gfx_drawstr("DRAW A POT O' FREQUENCY GOLD  //  EVERY CONTROL IS CUSTOM");
  draw_pixel_rainbow(500, 31, 82, 38, 2, 0.94);
  draw_pixel_sparkle(486, 40, 2, 1.00, 0.88, 0.18);
  draw_pixel_sparkle(582, 57, 2, 0.48, 1.00, 0.72);

  // Shape selection, copy, and reset buttons.
  button_y = 34;
  button_h = 30;
  button_main_x = 592;
  button_lfo_x = 682;
  button_random_x = gfx_w - 350;
  button_a_x = gfx_w - 244;
  button_b_x = gfx_w - 202;
  button_copy_x = gfx_w - 160;
  button_flat_x = gfx_w - 94;

  left_down = mouse_cap & 1;
  mouse_down = left_down;
  right_down = mouse_cap & 2;
  left_pressed = left_down && !last_left_down;
  !left_down ? active_knob = 0;
  button_consumed = 0;

  left_pressed && mouse_y >= button_y && mouse_y < button_y + button_h ? (
    mouse_x >= button_main_x && mouse_x < button_main_x + 84 ? (
      ui_page = 0;
      button_consumed = 1;
    );
    mouse_x >= button_lfo_x && mouse_x < button_lfo_x + 116 ? (
      ui_page = 1;
      button_consumed = 1;
    );
  );

  gfx_r = ui_page == 0 ? 0.12 : 0.025;
  gfx_g = ui_page == 0 ? 0.86 : 0.25;
  gfx_b = ui_page == 0 ? 0.36 : 0.08;
  gfx_a = 1;
  gfx_rect(button_main_x, button_y, 84, button_h);
  gfx_r = ui_page == 1 ? 0.74 : 0.16;
  gfx_g = ui_page == 1 ? 0.26 : 0.12;
  gfx_b = ui_page == 1 ? 1.00 : 0.28;
  gfx_rect(button_lfo_x, button_y, 116, button_h);
  gfx_r = 1; gfx_g = 0.78; gfx_b = 0.08; gfx_a = 1;
  gfx_line(button_main_x, button_y, button_main_x + 84, button_y);
  gfx_line(button_main_x, button_y + button_h, button_main_x + 84, button_y + button_h);
  gfx_line(button_lfo_x, button_y, button_lfo_x + 116, button_y);
  gfx_line(button_lfo_x, button_y + button_h, button_lfo_x + 116, button_y + button_h);
  gfx_setfont(3, "Silom", 10, 'b');
  gfx_x = button_main_x + 17; gfx_y = button_y + 8; gfx_drawstr("MIXER");
  gfx_x = button_lfo_x + 14; gfx_y = button_y + 8; gfx_drawstr("LFO GROVE");

  left_pressed && mouse_y >= button_y && mouse_y < button_y + button_h ? (
    mouse_x >= button_random_x && mouse_x < button_random_x + 96 ? (
      randomize_parameters();
      button_consumed = 1;
    );
    mouse_x >= button_a_x && mouse_x < button_a_x + 36 ? (
      active_shape = 0; button_consumed = 1;
    );
    mouse_x >= button_b_x && mouse_x < button_b_x + 36 ? (
      active_shape = 1; button_consumed = 1;
    );
    mouse_x >= button_copy_x && mouse_x < button_copy_x + 60 ? (
      active_shape ? memcpy(shape_a, shape_b, shape_point_count)
                   : memcpy(shape_b, shape_a, shape_point_count);
      sliderchange(-1);
      button_consumed = 1;
    );
    mouse_x >= button_flat_x && mouse_x < button_flat_x + 76 ? (
      edit_buffer = active_shape ? shape_b : shape_a;
      memset(edit_buffer, 0, shape_point_count);
      sliderchange(-1);
      button_consumed = 1;
    );
  );

  // Magenta randomizer plus emerald-and-gold drawing buttons.
  random_hover = mouse_x >= button_random_x && mouse_x < button_random_x + 96
                 && mouse_y >= button_y && mouse_y < button_y + button_h;
  gfx_r = random_hover ? 1.00 : 0.76; gfx_g = random_hover ? 0.30 : 0.08;
  gfx_b = random_hover ? 0.78 : 0.52; gfx_a = 1;
  gfx_rect(button_random_x, button_y, 96, button_h);
  gfx_r = active_shape ? 0.03 : 0.10; gfx_g = active_shape ? 0.25 : 0.74;
  gfx_b = active_shape ? 0.08 : 0.20; gfx_a = 1;
  gfx_rect(button_a_x, button_y, 36, button_h);
  gfx_r = active_shape ? 0.62 : 0.03; gfx_g = active_shape ? 0.18 : 0.25;
  gfx_b = active_shape ? 0.90 : 0.08;
  gfx_rect(button_b_x, button_y, 36, button_h);
  gfx_r = 0.03; gfx_g = 0.34; gfx_b = 0.11;
  gfx_rect(button_copy_x, button_y, 60, button_h);
  gfx_rect(button_flat_x, button_y, 76, button_h);
  gfx_r = 1; gfx_g = 0.75; gfx_b = 0.06;
  gfx_line(button_random_x, button_y, button_random_x + 96, button_y);
  gfx_line(button_random_x + 96, button_y, button_random_x + 96, button_y + button_h);
  gfx_line(button_random_x + 96, button_y + button_h, button_random_x, button_y + button_h);
  gfx_line(button_random_x, button_y + button_h, button_random_x, button_y);
  gfx_line(button_a_x, button_y, button_a_x + 36, button_y);
  gfx_line(button_a_x + 36, button_y, button_a_x + 36, button_y + button_h);
  gfx_line(button_a_x + 36, button_y + button_h, button_a_x, button_y + button_h);
  gfx_line(button_a_x, button_y + button_h, button_a_x, button_y);
  gfx_line(button_b_x, button_y, button_b_x + 36, button_y);
  gfx_line(button_b_x + 36, button_y, button_b_x + 36, button_y + button_h);
  gfx_line(button_b_x + 36, button_y + button_h, button_b_x, button_y + button_h);
  gfx_line(button_b_x, button_y + button_h, button_b_x, button_y);
  gfx_line(button_copy_x, button_y, button_copy_x + 60, button_y);
  gfx_line(button_copy_x + 60, button_y, button_copy_x + 60, button_y + button_h);
  gfx_line(button_copy_x + 60, button_y + button_h, button_copy_x, button_y + button_h);
  gfx_line(button_copy_x, button_y + button_h, button_copy_x, button_y);
  gfx_line(button_flat_x, button_y, button_flat_x + 76, button_y);
  gfx_line(button_flat_x + 76, button_y, button_flat_x + 76, button_y + button_h);
  gfx_line(button_flat_x + 76, button_y + button_h, button_flat_x, button_y + button_h);
  gfx_line(button_flat_x, button_y + button_h, button_flat_x, button_y);
  gfx_setfont(3, "Silom", 11, 'b');
  gfx_r = 1; gfx_g = 0.91; gfx_b = 0.45;
  gfx_x = button_random_x + 17; gfx_y = button_y + 8; gfx_drawstr("RANDOM");
  gfx_x = button_a_x + 13; gfx_y = button_y + 8; gfx_drawstr("A");
  gfx_x = button_b_x + 13; gfx_y = button_y + 8; gfx_drawstr("B");
  gfx_x = button_copy_x + 10; gfx_y = button_y + 8; gfx_drawstr("COPY");
  gfx_x = button_flat_x + 17; gfx_y = button_y + 8; gfx_drawstr("FLAT");

  // An unapologetically oversized pixel-rainbow portal frames the spectrum.
  draw_pixel_rainbow(margin_left - 10, margin_top - 10,
                     graph_width + 20, graph_height + 20, 2, 0.92);
  // Deep emerald graph with transparent rainbow frequency bands.
  gfx_r = 0.008; gfx_g = 0.085; gfx_b = 0.035; gfx_a = 0.72;
  gfx_rect(margin_left, margin_top, graph_width, graph_height);
  rainbow_band = 0;
  loop(7,
    set_rainbow_color(rainbow_band / 7, 0.09);
    band_left = margin_left + rainbow_band*graph_width/7;
    gfx_rect(band_left, margin_top, graph_width/7 + 1, graph_height);
    rainbow_band += 1;
  );

  gfx_setfont(4, "Silom", 9, 'b');
  grid_db = 12;
  loop(7,
    grid_y = margin_top + (12 - grid_db) / 72 * graph_height;
    gfx_r = 0.30; gfx_g = 0.47; gfx_b = 0.23; gfx_a = 0.75;
    gfx_line(margin_left, grid_y, margin_left + graph_width, grid_y);
    gfx_r = 0.92; gfx_g = 0.72; gfx_b = 0.18; gfx_a = 1;
    gfx_x = 7; gfx_y = grid_y - 6;
    gfx_drawnumber(grid_db, 0); gfx_drawstr(" dB");
    grid_db -= 12;
  );

  // Log-frequency grid.
  frequency_label = 20;
  loop(11,
    frequency_x = margin_left + log(frequency_label / 20) / log(20000 / 20) * graph_width;
    gfx_r = 0.18; gfx_g = 0.43; gfx_b = 0.20; gfx_a = 0.7;
    gfx_line(frequency_x, margin_top, frequency_x, margin_top + graph_height);
    frequency_label == 20 || frequency_label == 100 || frequency_label == 1000
      || frequency_label == 10000 || frequency_label == 20000 ? (
      gfx_r = 0.92; gfx_g = 0.72; gfx_b = 0.18; gfx_a = 1;
      gfx_x = frequency_x - 12; gfx_y = margin_top + graph_height + 8;
      frequency_label >= 1000 ? (
        gfx_drawnumber(frequency_label / 1000, 0); gfx_drawstr("k");
      ) : gfx_drawnumber(frequency_label, 0);
    );
    frequency_label *= (frequency_label == 20 ? 2.5 : 2);
  );
  gfx_r = 1; gfx_g = 0.72; gfx_b = 0.04; gfx_a = 1;
  gfx_line(margin_left, margin_top, margin_left + graph_width, margin_top);
  gfx_line(margin_left + graph_width, margin_top,
           margin_left + graph_width, margin_top + graph_height);
  gfx_line(margin_left + graph_width, margin_top + graph_height,
           margin_left, margin_top + graph_height);
  gfx_line(margin_left, margin_top + graph_height, margin_left, margin_top);

  // One-curve view: show only the selected editable drawing. The previous UI
  // stacked A, B, and the composite response, then drew each with extra offset
  // strokes; that made one gesture look like several separate curves.
  visible_shape = active_shape ? shape_b : shape_a;
  point = 0;
  loop(max(1, graph_width | 0),
    shape_index = min(shape_point_count - 1,
                      floor(point / max(1, graph_width - 1) * (shape_point_count - 1)));
    current_x = margin_left + point;
    curve_y = margin_top + (12 - max(-60, min(12, visible_shape[shape_index]))) / 72 * graph_height;
    point > 0 ? (
      // Preserve the old rainbow filter line without bringing back the extra
      // A/B/composite traces: this is still exactly one visible stroke.
      set_rainbow_color(point / max(1, graph_width - 1), 1);
      gfx_line(previous_x, previous_curve_y, current_x, curve_y, 1);
    );
    previous_x = current_x;
    previous_curve_y = curve_y;
    point += 1;
  );

  gfx_setfont(4, "Silom", 9, 'b');
  gfx_r = active_shape ? 0.86 : 0.35;
  gfx_g = active_shape ? 0.48 : 1.00;
  gfx_b = active_shape ? 1.00 : 0.45;
  gfx_x = margin_left + 10; gfx_y = margin_top + 9;
  active_shape ? gfx_drawstr("ONE-CURVE VIEW  //  EDITING B")
               : gfx_drawstr("ONE-CURVE VIEW  //  EDITING A");

  // Left-drag draws the selected shape; right-drag erases toward 0 dB.
  inside_graph = mouse_x >= margin_left && mouse_x < margin_left + graph_width
                 && mouse_y >= margin_top && mouse_y < margin_top + graph_height;
  inside_graph && (left_down || right_down) && !button_consumed && active_knob == 0 ? (
    draw_index = floor((mouse_x - margin_left) / graph_width * shape_point_count);
    draw_index = max(0, min(shape_point_count - 1, draw_index));
    draw_value = right_down ? 0
                 : 12 - (mouse_y - margin_top) / graph_height * 72;
    draw_value = max(-60, min(12, draw_value));
    edit_buffer = active_shape ? shape_b : shape_a;

    last_draw_index >= 0 && last_draw_index != draw_index ? (
      draw_distance = abs(draw_index - last_draw_index);
      draw_step = draw_index > last_draw_index ? 1 : -1;
      fill_count = 1;
      loop(draw_distance,
        fill_index = last_draw_index + fill_count*draw_step;
        fill_fraction = fill_count / draw_distance;
        edit_buffer[fill_index] = last_draw_value
                                  + (draw_value - last_draw_value)*fill_fraction;
        fill_count += 1;
      );
    ) : edit_buffer[draw_index] = draw_value;

    last_draw_index = draw_index;
    last_draw_value = draw_value;
    drawing_changed = 1;
  ) : last_draw_index = -1;

  input_released = !left_down && !right_down && (last_left_down || last_right_down);
  input_released && drawing_changed ? (
    sliderchange(-1);
    drawing_changed = 0;
  );
  ui_page == 0 ? (
  // Every hidden JSFX slider is represented by a custom 16-bit control.
  draw_pixel_panel(20, 378, 535, 125, 0.01, 0.78, 0.32, "SPECTRAL FILTER");
  themed_knob(1, 70, 435, 10, 1000, 1, "LOW CUT HZ", 0.03, 0.96, 0.42);
  themed_knob(2, 175, 435, 1000, 24000, 10, "HIGH CUT HZ", 0.03, 0.96, 0.42);
  themed_knob(3, 280, 435, 0.1, 4, 0.1, "EDGE OCT", 0.03, 0.96, 0.42);
  themed_knob(4, 385, 435, -12, 12, 0.1, "TILT DB/OCT", 0.03, 0.96, 0.42);
  themed_knob(6, 500, 435, 0, 5, 1, "FFT SIZE", 0.03, 0.96, 0.42);
  draw_pixel_sparkle(536, 394, 2, 0.82, 1.00, 0.36);

  // Master output is deliberately isolated and red so it never gets lost.
  draw_pixel_panel(570, 378, 135, 125, 1.00, 0.16, 0.30, "MASTER OUTPUT");
  themed_knob(5, 630, 435, -24, 12, 0.1, "OUTPUT DB", 1.00, 0.22, 0.38);
  draw_pixel_sparkle(678, 394, 2, 1.00, 0.82, 0.28);

  draw_pixel_panel(710, 378, 430, 125, 1.00, 0.44, 0.01, "FFT DAMAGE");
  themed_knob(7, 755, 435, 0, 100, 1, "SMEAR %", 1.00, 0.58, 0.04);
  themed_knob(8, 860, 435, 0, 100, 1, "GRAIN %", 1.00, 0.58, 0.04);
  themed_knob(9, 965, 435, 0, 100, 1, "PHASE %", 1.00, 0.58, 0.04);
  themed_knob(10, 1070, 435, 0, 4, 1, "REPEAT", 1.00, 0.58, 0.04);

  draw_pixel_panel(20, 515, 460, 125, 0.72, 0.12, 1.00, "DRAWING MAGIC");
  themed_knob(11, 85, 572, 0, 100, 0.1, "MORPH A/B %", 0.88, 0.28, 1.00);
  themed_knob(12, 195, 572, -4, 4, 0.01, "SHIFT OCT", 0.88, 0.28, 1.00);
  themed_knob(13, 305, 572, 0, 4, 0.01, "SWEEP OCT", 0.88, 0.28, 1.00);
  themed_knob(14, 415, 572, 0, 10, 0.01, "SWEEP HZ", 0.88, 0.28, 1.00);
  draw_pixel_sparkle(458, 531, 2, 1.00, 0.66, 1.00);

  draw_pixel_panel(495, 515, 645, 125, 0.00, 0.82, 0.58, "PRE-DELAY  //  BEFORE THE MAGIC");
  themed_knob(15, 535, 572, 1, 2000, 1, "LEFT MS", 0.04, 1.00, 0.68);
  themed_knob(16, 625, 572, 1, 2000, 1, "RIGHT MS", 0.04, 1.00, 0.68);
  themed_knob(17, 715, 572, 0, 95, 0.1, "FDBK %", 0.04, 1.00, 0.68);
  themed_knob(18, 805, 572, 0, 100, 0.1, "PINGPONG", 0.04, 1.00, 0.68);
  themed_knob(19, 895, 572, 0, 100, 0.1, "DAMP %", 0.04, 1.00, 0.68);
  themed_knob(28, 985, 572, 0, 100, 0.1, "DIFFUSE %", 1.00, 0.34, 0.88);
  themed_knob(20, 1075, 572, 0, 100, 0.1, "MIX %", 0.04, 1.00, 0.68);
  draw_pixel_sparkle(1015, 545, 2, 1.00, 0.80, 1.00);
  draw_pixel_sparkle(1030, 620, 1, 0.62, 1.00, 0.92);

  draw_pixel_panel(20, 652, 645, 145, 0.04, 0.46, 1.00, "POST-DELAY  //  AFTER THE MAGIC");
  themed_knob(21, 60, 712, 1, 2000, 1, "LEFT MS", 0.12, 0.64, 1.00);
  themed_knob(22, 150, 712, 1, 2000, 1, "RIGHT MS", 0.12, 0.64, 1.00);
  themed_knob(23, 240, 712, 0, 95, 0.1, "FDBK %", 0.12, 0.64, 1.00);
  themed_knob(24, 330, 712, 0, 100, 0.1, "PINGPONG", 0.12, 0.64, 1.00);
  themed_knob(25, 420, 712, 0, 100, 0.1, "DAMP %", 0.12, 0.64, 1.00);
  themed_knob(29, 510, 712, 0, 100, 0.1, "DIFFUSE %", 1.00, 0.30, 0.82);
  themed_knob(26, 600, 712, 0, 100, 0.1, "MIX %", 0.12, 0.64, 1.00);
  draw_pixel_sparkle(540, 684, 2, 1.00, 0.82, 1.00);
  draw_pixel_sparkle(555, 770, 1, 0.62, 0.92, 1.00);

  draw_pixel_panel(680, 652, 460, 145, 1.00, 0.68, 0.01, "CHARACTER CAULDRON  //  3-BAND");
  themed_knob(31, 720, 712, 0, 60, 0.1, "LOW DRIVE", 1.00, 0.72, 0.04);
  themed_knob(32, 810, 712, 0, 60, 0.1, "MID DRIVE", 1.00, 0.52, 0.06);
  themed_knob(33, 900, 712, 0, 60, 0.1, "HIGH DRIVE", 1.00, 0.28, 0.18);
  themed_knob(27, 990, 712, 0, 100, 0.1, "GOLD", 1.00, 0.82, 0.04);
  themed_knob(30, 1080, 712, 0, 100, 0.1, "SPREAD %", 1.00, 0.38, 0.66);
  gfx_setfont(6, "Silom", 8, 'b');
  gfx_r = 0.08; gfx_g = 0.04; gfx_b = 0.01; gfx_a = 1;
  gfx_x = 697; gfx_y = 774;
  gfx_drawstr("250 HZ / 2.5K SPLIT  //  ANCHORED LOWS  //  WIDE MIDS + HIGHS");
  draw_pixel_sparkle(1118, 671, 2, 1.00, 0.92, 0.25);

  // Two extra lucky sentries watch the mixer page.
  draw_leprechaun_face(26, 788, 9);
  draw_pot_of_gold(1118, 797, 19);
  ) : (
  draw_lfo_card(20, 378, 550, 195, 1, 34, 35, 36, 37,
                lfo1_phase, lfo1_random, 0.04, 0.92, 0.34);
  draw_lfo_card(590, 378, 550, 195, 2, 38, 39, 40, 41,
                lfo2_phase, lfo2_random, 0.98, 0.22, 0.62);
  draw_lfo_card(20, 590, 550, 207, 3, 42, 43, 44, 45,
                lfo3_phase, lfo3_random, 1.00, 0.66, 0.03);
  draw_lfo_card(590, 590, 550, 207, 4, 46, 47, 48, 49,
                lfo4_phase, lfo4_random, 0.48, 0.28, 1.00);
  draw_pixel_rainbow(508, 770, 144, 43, 3, 0.95);
  draw_leprechaun_face(565, 787, 13);
  draw_pot_of_gold(605, 811, 24);
  draw_gold_coin(540, 806, 5);
  draw_gold_coin(658, 811, 4);
  );

  draw_shamrock(25, gfx_h - 20, 7);
  gfx_setfont(4, "Silom", 9, 'b');
  gfx_r = 1; gfx_g = 0.79; gfx_b = 0.15; gfx_a = 1;
  gfx_x = margin_left;
  gfx_y = gfx_h - 18;
  gfx_drawstr("LEFT DRAG: MAKE MAGIC   RIGHT DRAG: FLATTEN   //   FFT ");
  gfx_drawnumber(fftsize, 0);
  gfx_drawstr("   //   ");
  gfx_drawnumber(fftsize / srate * 1000, 1);
  gfx_drawstr(" ms   //   UI 2.7.1   //   FOUR LUCKY LFOS");
  last_mouse_y = mouse_y;
  last_mouse_down = mouse_down;
  last_left_down = left_down;
  last_right_down = right_down;
