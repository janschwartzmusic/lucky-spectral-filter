                 center_x + size*0.02, shoulder_y + size*0.42,
                 center_x + size*0.22, seat_y - size*0.33);
    gfx_r = 0.10; gfx_g = 0.075; gfx_b = 0.055;
    gfx_triangle(center_x - size*0.28, shoulder_y + size*0.33,
                 center_x + size*0.30, shoulder_y + size*0.33,
                 center_x + size*0.22, seat_y - size*0.36,
                 center_x - size*0.20, seat_y - size*0.36);
    gfx_r = 0.74; gfx_g = 0.65; gfx_b = 0.48;
