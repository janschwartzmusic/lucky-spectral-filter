    gfx_circle(center_x + size*0.28, shoulder_y + size*0.35, size*0.055, 1, 1);
    gfx_r = 0.10; gfx_g = 0.72; gfx_b = 0.27;
    gfx_circle(center_x - size*0.39, shoulder_y + size*0.31, size*0.055, 1, 1);
