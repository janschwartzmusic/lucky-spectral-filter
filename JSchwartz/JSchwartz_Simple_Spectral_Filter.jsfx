  function draw_period_leprechaun(center_x, seat_y, size)
    local(head_x, head_y, shoulder_y, knee_x, knee_y) (
    head_x = center_x - size*0.22;
    head_y = seat_y - size*3.12;
    shoulder_y = seat_y - size*2.30;
    knee_x = center_x - size*0.78;
    knee_y = seat_y - size*0.62;

    // Coat tails settle naturally over the pot rather than forming a sprite block.
    gfx_r = 0.012; gfx_g = 0.040; gfx_b = 0.032; gfx_a = 0.48;
    gfx_triangle(center_x - size*0.90, shoulder_y + size*0.30,
                 center_x + size*0.78, shoulder_y + size*0.20,
                 center_x + size*1.05, seat_y + size*0.18,
                 center_x - size*0.48, seat_y + size*0.12);
    gfx_r = 0.018; gfx_g = 0.16; gfx_b = 0.115; gfx_a = 1;
    gfx_triangle(center_x - size*0.82, shoulder_y + size*0.20,
                 center_x + size*0.70, shoulder_y + size*0.16,
                 center_x + size*0.62, seat_y + size*0.08,
                 center_x - size*0.42, seat_y - size*0.02);

    // Long tailored overcoat with satin lapels and a period waistcoat beneath.
    gfx_r = 0.025; gfx_g = 0.25; gfx_b = 0.17;
    gfx_triangle(center_x - size*0.86, shoulder_y,
                 center_x + size*0.76, shoulder_y - size*0.02,
