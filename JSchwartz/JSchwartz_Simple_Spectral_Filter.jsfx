    gfx_circle(center_x - size*0.345, shoulder_y + size*0.23, size*0.055, 1, 1);

    // One sleeve hangs loose; the other bends so his elbow rests on his knee.
    gfx_r = 0.018; gfx_g = 0.19; gfx_b = 0.135;
    gfx_triangle(center_x + size*0.64, shoulder_y + size*0.08,
                 center_x + size*1.06, shoulder_y + size*0.96,
