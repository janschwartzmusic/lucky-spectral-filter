                 knee_x - size*0.26, knee_y + size*0.22);
    gfx_r = 0.12; gfx_g = 0.065; gfx_b = 0.035;
    gfx_triangle(center_x + size*0.10, seat_y + size*1.08,
                 center_x + size*0.55, seat_y + size*1.06,
                 center_x + size*0.78, seat_y + size*1.28,
                 center_x + size*0.10, seat_y + size*1.30);
    gfx_triangle(knee_x - size*0.27, knee_y + size*0.15,
                 knee_x + size*0.33, knee_y + size*0.16,
                 knee_x - size*0.58, knee_y + size*0.58,
                 knee_x - size*1.12, knee_y + size*0.52);
    gfx_r = 0.80; gfx_g = 0.57; gfx_b = 0.17;
    gfx_rect(knee_x - size*0.67, knee_y + size*0.37, size*0.18, size*0.16);

    // More natural head proportions with restrained auburn sideburns and beard.
    gfx_r = 0.91; gfx_g = 0.65; gfx_b = 0.49;
    gfx_circle(head_x, head_y, size*0.47, 1, 1);
    gfx_r = 0.60; gfx_g = 0.18; gfx_b = 0.055;
    gfx_circle(head_x - size*0.36, head_y + size*0.23, size*0.13, 1, 1);
    gfx_circle(head_x + size*0.35, head_y + size*0.23, size*0.13, 1, 1);
    gfx_triangle(head_x - size*0.31, head_y + size*0.26,
                 head_x + size*0.31, head_y + size*0.26,
                 head_x + size*0.03, head_y + size*0.56);
    gfx_r = 0.20; gfx_g = 0.12; gfx_b = 0.08;
    gfx_rect(head_x - size*0.30, head_y - size*0.14, size*0.19, size*0.045);
    gfx_rect(head_x + size*0.11, head_y - size*0.14, size*0.19, size*0.045);
    gfx_r = 0.035; gfx_g = 0.10; gfx_b = 0.075;
    gfx_circle(head_x - size*0.20, head_y - size*0.03, size*0.045, 1, 1);
    gfx_circle(head_x + size*0.20, head_y - size*0.03, size*0.045, 1, 1);
    gfx_r = 0.82; gfx_g = 0.52; gfx_b = 0.36;
    gfx_triangle(head_x - size*0.03, head_y,
                 head_x + size*0.11, head_y + size*0.18,
                 head_x - size*0.08, head_y + size*0.18);
    gfx_r = 0.82; gfx_g = 0.72; gfx_b = 0.58;
    gfx_line(head_x - size*0.12, head_y + size*0.27,
             head_x + size*0.16, head_y + size*0.25, 1);

    // Period flat cap, subtly green: evocative rather than costume-like.
    gfx_r = 0.035; gfx_g = 0.12; gfx_b = 0.085;
    gfx_triangle(head_x - size*0.48, head_y - size*0.36,
                 head_x + size*0.42, head_y - size*0.38,
                 head_x + size*0.28, head_y - size*0.68,
                 head_x - size*0.30, head_y - size*0.67);
    gfx_r = 0.075; gfx_g = 0.24; gfx_b = 0.15;
    gfx_triangle(head_x - size*0.30, head_y - size*0.65,
                 head_x + size*0.28, head_y - size*0.66,
                 head_x + size*0.13, head_y - size*0.76,
                 head_x - size*0.16, head_y - size*0.76);
    gfx_r = 0.025; gfx_g = 0.07; gfx_b = 0.05;
    gfx_triangle(head_x - size*0.08, head_y - size*0.37,
                 head_x + size*0.54, head_y - size*0.38,
                 head_x + size*0.26, head_y - size*0.28);

    // Slim blackthorn cane and a single coin held loosely in the raised hand.
    gfx_r = 0.08; gfx_g = 0.045; gfx_b = 0.025;
    gfx_line(center_x + size*1.03, shoulder_y + size*1.08,
             center_x + size*1.21, seat_y + size*1.20, 3);
    gfx_circle(center_x + size*1.02, shoulder_y + size*1.04, size*0.11, 0, 1);
    gfx_r = 1; gfx_g = 0.71; gfx_b = 0.08;
    gfx_circle(knee_x + size*0.05, knee_y - size*0.94, size*0.10, 1, 1);
    gfx_r = 1; gfx_g = 0.90; gfx_b = 0.31;
    gfx_circle(knee_x + size*0.03, knee_y - size*0.96, size*0.035, 1, 1);
  );

  function draw_pixel_mushroom(x, y, scale) (
    gfx_r = 0.90; gfx_g = 0.06; gfx_b = 0.30; gfx_a = 1;
    gfx_rect(x + scale*2, y, scale*6, scale*2);
    gfx_rect(x, y + scale*2, scale*10, scale*3);
    gfx_r = 1; gfx_g = 0.90; gfx_b = 0.56; gfx_a = 1;
    gfx_rect(x + scale*2, y + scale, scale, scale);
    gfx_rect(x + scale*7, y + scale*2, scale, scale);
    gfx_rect(x + scale*4, y + scale*5, scale*3, scale*4);
    gfx_r = 0.42; gfx_g = 0.18; gfx_b = 0.04; gfx_a = 1;
    gfx_rect(x + scale*3, y + scale*8, scale*5, scale);
  );

  function draw_pot_of_gold(center_x, bottom_y, size) local(coin) (
    coin = 0;
    loop(7,
      gfx_r = 1; gfx_g = 0.72 + 0.04*(coin % 2); gfx_b = 0.04; gfx_a = 1;
      gfx_circle(center_x - size*0.36 + coin*size*0.12,
                 bottom_y - size*0.72 - abs(3 - coin)*size*0.035,
                 size*0.13, 1, 1);
      coin += 1;
    );
    gfx_r = 0.025; gfx_g = 0.05; gfx_b = 0.025;
    gfx_triangle(center_x - size*0.48, bottom_y - size*0.62,
                 center_x + size*0.48, bottom_y - size*0.62,
                 center_x + size*0.32, bottom_y,
                 center_x - size*0.32, bottom_y);
    gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.08;
    gfx_rect(center_x - size*0.54, bottom_y - size*0.67, size*1.08, size*0.16);
  );

  function draw_pixel_rainbow(x, y, width, height, scale, alpha)
    local(band, inset) (
    band = 0;
    loop(7,
      inset = band * scale;
      set_rainbow_color(band / 7, alpha);
      gfx_rect(x + inset, y + inset, width - inset*2, scale);
      gfx_rect(x + inset, y + inset, scale, height - inset);
      gfx_rect(x + width - inset - scale, y + inset, scale, height - inset);
      band += 1;
    );
  );

  function draw_giant_pixel_rainbow(center_x, ground_y, outer_radius, alpha)
    local(band, point, angle, radius, block_x, block_y, block_size) (
    block_size = 5;
    band = 0;
    loop(7,
      radius = outer_radius - band*7;
      set_rainbow_color(band/7, alpha);
      point = 0;
      loop(260,
        angle = $pi + point/259*$pi;
        block_x = center_x + cos(angle)*radius;
        block_y = ground_y + sin(angle)*radius;
        gfx_rect(floor(block_x/block_size)*block_size,
                 floor(block_y/block_size)*block_size,
                 block_size + 3, block_size + 3);
        point += 1;
      );
      band += 1;
    );
  );

  function draw_pastoral_cloud(x, y, size, alpha) (
    gfx_r = 0.92; gfx_g = 0.95; gfx_b = 0.84; gfx_a = alpha*0.30;
    gfx_circle(x + size*0.08, y + size*0.12, size*0.48, 1, 1);
    gfx_circle(x + size*0.76, y + size*0.08, size*0.58, 1, 1);
    gfx_circle(x + size*1.48, y + size*0.18, size*0.43, 1, 1);
    gfx_r = 1.00; gfx_g = 0.88; gfx_b = 0.74; gfx_a = alpha*0.28;
    gfx_rect(x - size*0.20, y + size*0.18, size*2.08, size*0.31);
    gfx_r = 0.72; gfx_g = 0.82; gfx_b = 0.72; gfx_a = alpha*0.16;
    gfx_rect(x, y + size*0.42, size*1.62, size*0.12);
  );

  function draw_pastoral_tree(x, ground_y, size, red, green, blue) (
    gfx_r = 0.16; gfx_g = 0.075; gfx_b = 0.025; gfx_a = 0.78;
    gfx_triangle(x - size*0.10, ground_y,
                 x + size*0.12, ground_y,
                 x + size*0.05, ground_y - size*1.18,
                 x - size*0.04, ground_y - size*1.18);
    gfx_r = red*0.45; gfx_g = green*0.45; gfx_b = blue*0.45; gfx_a = 0.88;
    gfx_circle(x - size*0.22, ground_y - size*1.05, size*0.62, 1, 1);
    gfx_circle(x + size*0.34, ground_y - size*1.12, size*0.55, 1, 1);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.86;
    gfx_circle(x, ground_y - size*1.42, size*0.62, 1, 1);
    gfx_circle(x - size*0.46, ground_y - size*1.35, size*0.42, 1, 1);
    gfx_r = min(1, red*1.45); gfx_g = min(1, green*1.35); gfx_b = min(1, blue*1.25); gfx_a = 0.42;
    gfx_circle(x - size*0.20, ground_y - size*1.67, size*0.28, 1, 1);
  );

  function draw_pastoral_mountain(x, base_y, width, height, red, green, blue) (
    gfx_r = red*0.52; gfx_g = green*0.52; gfx_b = blue*0.52; gfx_a = 0.62;
    gfx_triangle(x - width*0.06, base_y,
                 x + width*0.48, base_y - height,
                 x + width*1.06, base_y);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.72;
    gfx_triangle(x, base_y,
                 x + width*0.48, base_y - height*0.91,
                 x + width*0.54, base_y);
    gfx_r = min(1, red*1.45); gfx_g = min(1, green*1.35); gfx_b = min(1, blue*1.25); gfx_a = 0.34;
    gfx_triangle(x + width*0.48, base_y - height*0.91,
                 x + width*0.27, base_y - height*0.28,
                 x + width*0.52, base_y - height*0.48);
  );

  function draw_rolling_hill(top_y, base_y, amplitude, phase_offset,
                             red, green, blue, alpha, highlight)
    local(segment, segment_count, x1, x2, y1, y2, wave1, wave2) (
    segment_count = 58;
    segment = 0;
    loop(segment_count,
      x1 = segment*gfx_w/segment_count;
      x2 = (segment + 1)*gfx_w/segment_count + 1;
      wave1 = sin(segment/segment_count*$pi*2 + phase_offset)*0.68
              + sin(segment/segment_count*$pi*5 + phase_offset*0.63)*0.23
              + sin(segment/segment_count*$pi*9 + phase_offset*1.31)*0.09;
      wave2 = sin((segment + 1)/segment_count*$pi*2 + phase_offset)*0.68
              + sin((segment + 1)/segment_count*$pi*5 + phase_offset*0.63)*0.23
              + sin((segment + 1)/segment_count*$pi*9 + phase_offset*1.31)*0.09;
      y1 = top_y - wave1*amplitude;
      y2 = top_y - wave2*amplitude;
      gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = alpha;
      gfx_triangle(x1, y1, x2, y2, x2, base_y, x1, base_y);
      highlight > 0 ? (
        gfx_r = min(1, red*1.55 + 0.04);
        gfx_g = min(1, green*1.35 + 0.04);
        gfx_b = min(1, blue*1.20 + 0.02);
        gfx_a = highlight;
        gfx_line(x1, y1, x2, y2, 1);
      );
      segment += 1;
    );
  );

  function draw_winding_country_path(horizon_y, bottom_y, start_x, end_x,
                                     start_width, end_width)
    local(segment, segment_count, t1, t2, y1, y2, center1, center2, width1, width2) (
    segment_count = 22;
    segment = 0;
    loop(segment_count,
      t1 = segment/segment_count;
      t2 = (segment + 1)/segment_count;
      y1 = horizon_y + (bottom_y - horizon_y)*t1;
      y2 = horizon_y + (bottom_y - horizon_y)*t2;
      center1 = start_x + (end_x - start_x)*t1
                + sin(t1*$pi*2.4)*gfx_w*0.045*t1;
      center2 = start_x + (end_x - start_x)*t2
                + sin(t2*$pi*2.4)*gfx_w*0.045*t2;
      width1 = start_width + (end_width - start_width)*t1*t1;
      width2 = start_width + (end_width - start_width)*t2*t2;
      gfx_r = 0.58; gfx_g = 0.52; gfx_b = 0.32; gfx_a = 0.54;
      gfx_triangle(center1 - width1, y1, center1 + width1, y1,
                   center2 + width2, y2, center2 - width2, y2);
      gfx_r = 0.94; gfx_g = 0.77; gfx_b = 0.44; gfx_a = 0.20;
      gfx_line(center1 - width1*0.72, y1,
               center2 - width2*0.72, y2, 1);
      segment += 1;
    );
  );

  function draw_fine_stone_wall(y, height)
    local(row, column, columns, stone_x, stone_y, stone_width, stone_height, offset) (
    row = 0;
    loop(3,
      columns = 34 + row*3;
      column = 0;
      offset = row % 2 ? -18 : 0;
      loop(columns,
        stone_width = gfx_w/columns + ((column*7 + row*5)%5) - 2;
        stone_height = height/3 + ((column*3 + row*11)%4) - 2;
        stone_x = offset + column*gfx_w/columns;
        stone_y = y + row*height/3 + ((column*5 + row)%3);
        gfx_r = 0.27 + row*0.025; gfx_g = 0.30 + row*0.025;
        gfx_b = 0.235 + row*0.018; gfx_a = 0.62;
        gfx_rect(stone_x, stone_y, stone_width - 2, stone_height - 2);
        gfx_r = 0.66; gfx_g = 0.70; gfx_b = 0.54; gfx_a = 0.18;
        gfx_line(stone_x + 2, stone_y + 2,
                 stone_x + stone_width - 5, stone_y + 2, 1);
        column += 1;
      );
      row += 1;
    );
    gfx_r = 0.14; gfx_g = 0.42; gfx_b = 0.13; gfx_a = 0.54;
    gfx_rect(0, y - 4, gfx_w, 5);
  );

  function draw_pixel_sparkle(x, y, size, red, green, blue) (
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.58;
    gfx_rect(x - size*2, y, size*5, size);
    gfx_rect(x, y - size*2, size, size*5);
    gfx_r = min(1, red*1.25 + 0.08); gfx_g = min(1, green*1.25 + 0.08);
    gfx_b = min(1, blue*1.25 + 0.08); gfx_a = 1;
    gfx_rect(x, y, size, size);
  );

  function draw_gold_coin(x, y, size) (
    gfx_r = 0.55; gfx_g = 0.24; gfx_b = 0.01; gfx_a = 0.88;
    gfx_circle(x + 2, y + 3, size, 1, 1);
    gfx_r = 1; gfx_g = 0.70; gfx_b = 0.03; gfx_a = 1;
    gfx_circle(x, y, size, 1, 1);
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.30; gfx_a = 0.92;
    gfx_rect(x - size*0.45, y - size*0.55, size*0.42, size*0.22);
  );

  function draw_coin_trail(x, y, count, spacing, size) local(coin) (
    coin = 0;
    loop(count,
      draw_gold_coin(x + coin*spacing,
                     y - abs((count - 1)*0.5 - coin)*size*0.65,
                     size);
      coin += 1;
    );
  );

  function draw_pixel_panel(x, y, width, height, red, green, blue, title)
    local(stripe) (
    gfx_r = 0.005; gfx_g = 0.035; gfx_b = 0.014; gfx_a = 0.20;
    gfx_rect(x + 5, y + 6, width, height);
    gfx_r = red*0.62; gfx_g = green*0.62; gfx_b = blue*0.62; gfx_a = 0.27;
    gfx_rect(x, y, width, height);
    gfx_r = 0.004; gfx_g = 0.040; gfx_b = 0.020; gfx_a = 0.30;
    gfx_rect(x + 4, y + 27, width - 8, height - 35);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 0.10;
    gfx_rect(x + 4, y + 4, width - 8, height - 8);
    gfx_r = min(1, red*1.30 + 0.08); gfx_g = min(1, green*1.30 + 0.08);
    gfx_b = min(1, blue*1.30 + 0.08); gfx_a = 0.88;
    gfx_rect(x + 4, y + 4, width - 8, 3);
    gfx_rect(x + 4, y + 4, 3, height - 8);
    gfx_r = red*0.26; gfx_g = green*0.26; gfx_b = blue*0.26; gfx_a = 0.68;
    gfx_rect(x + 7, y + height - 8, width - 14, 4);
    gfx_r = min(1, red*0.9 + 0.16); gfx_g = min(1, green*0.9 + 0.16);
    gfx_b = min(1, blue*0.9 + 0.16); gfx_a = 0.26;
    gfx_rect(x + 9, y + 29, width - 18, 1);
    gfx_rect(x + 9, y + 31, width - 18, 1);
    stripe = 0;
    loop(max(1, floor(width / 12)),
      gfx_a = stripe % 2 ? 0.014 : 0.032;
      gfx_rect(x + 7 + stripe*12, y + 32, 5, height - 42);
      stripe += 1;
    );
    // Small illuminated-manuscript corner notches, kept subtle behind controls.
    gfx_r = 1; gfx_g = 0.76; gfx_b = 0.12; gfx_a = 0.54;
    gfx_rect(x + 8, y + 8, 11, 2); gfx_rect(x + 8, y + 8, 2, 11);
    gfx_rect(x + width - 19, y + 8, 11, 2); gfx_rect(x + width - 10, y + 8, 2, 11);
    gfx_rect(x + 8, y + height - 10, 11, 2); gfx_rect(x + 8, y + height - 19, 2, 11);
    gfx_rect(x + width - 19, y + height - 10, 11, 2);
    gfx_rect(x + width - 10, y + height - 19, 2, 11);
    gfx_setfont(5, "Silom", 13, 'b');
    gfx_r = 0.015; gfx_g = 0.055; gfx_b = 0.018; gfx_a = 1;
    gfx_x = x + 14; gfx_y = y + 10; gfx_drawstr(title);
    gfx_x = x + 15; gfx_y = y + 10; gfx_drawstr(title);
    gfx_r = 1; gfx_g = 0.91; gfx_b = 0.34; gfx_a = 1;
    gfx_x = x + 13; gfx_y = y + 8; gfx_drawstr(title);
    gfx_x = x + 14; gfx_y = y + 8; gfx_drawstr(title);
  );

  // Controls opt in with their existing hover hitbox. The bubble is rendered
  // last, so help never changes audio state, automation, or hit testing.
  function offer_help(hover, line_1, line_2) (
    help_mode && hover && active_knob == 0 && tab_drag_id == 0
      && !mouse_down && !right_down ? (
      strcpy(#help_line_1, line_1);
      strcpy(#help_line_2, line_2);
      help_hovered = 1;
    );
  );

  // Slider-index descriptions avoid ambiguous repeated labels such as MIX,
  // LOW CUT, RATE, and FEEDBACK across Filter, Gate, Delay, and LFO pages.
  function offer_parameter_help(hover, index) (
    help_mode && hover ? (
      index == 1 ? offer_help(hover, "FILTER LOW CUT",
        "Attenuates frequencies below this point.");
      index == 2 ? offer_help(hover, "FILTER HIGH CUT",
        "Attenuates frequencies above this point.");
      index == 3 ? offer_help(hover, "FILTER EDGE WIDTH",
        "Sets the octave width of both cutoff transitions.");
      index == 4 ? offer_help(hover, "SPECTRAL TILT",
        "Tilts around 1 kHz and can boost one side; SAFE RND protects it.");
      index == 5 ? offer_help(hover, "MASTER OUTPUT",
        "Final output gain. SAFE RND never changes this control.");
      index == 6 ? offer_help(hover, "FFT SIZE",
        "Larger sizes improve frequency detail but add latency.");
      index == 7 ? offer_help(hover, "TRANSIENT SMEAR",
        "Carries bin energy between frames for a blurred, warbly tone.");
      index == 8 ? offer_help(hover, "SPECTRAL GRAIN",
        "Quantizes bin magnitudes for stepped spectral texture.");
      index == 9 ? offer_help(hover, "PHASE SCATTER",
        "Randomizes bin phase while preserving spectral magnitude.");
      index == 10 ? offer_help(hover, "FRAME REPEAT",
        "Replays processed FFT frames for a frozen stutter.");
      index == 11 ? offer_help(hover, "FILTER MORPH A/B",
        "Blends continuously between filter curves A and B.");
      index == 12 ? offer_help(hover, "FILTER SHIFT",
        "Moves the drawn filter response by octaves.");
      index == 13 ? offer_help(hover, "FILTER SWEEP DEPTH",
        "Sets the automatic octave travel of the drawn response.");
      index == 14 ? offer_help(hover, "FILTER SWEEP RATE",
        "Sets sweep speed; SYNC replaces Hz with a tempo division.");
      (index == 15 || index == 16) ? offer_help(hover, "PRE-DELAY TIME",
        "Delay time before the spectral stages; SYNC shows a division.");
      index == 17 ? offer_help(hover, "PRE-DELAY FEEDBACK",
        "Returns echoes into the delay. SAFE RND never changes it.");
      index == 18 ? offer_help(hover, "PRE-DELAY PING-PONG",
        "Crossfeeds repeats between the left and right channels.");
      index == 19 ? offer_help(hover, "PRE-DELAY DAMPING",
        "Darkens each repeat by removing more high frequency energy.");
      index == 20 ? offer_help(hover, "PRE-DELAY MIX",
        "Blends the pre-delay with dry audio; protected by SAFE RND.");
      (index == 21 || index == 22) ? offer_help(hover, "POST-DELAY TIME",
        "Delay time after the spectral stages; SYNC shows a division.");
      index == 23 ? offer_help(hover, "POST-DELAY FEEDBACK",
        "Returns echoes into the delay. SAFE RND never changes it.");
      index == 24 ? offer_help(hover, "POST-DELAY PING-PONG",
        "Crossfeeds repeats between the left and right channels.");
      index == 25 ? offer_help(hover, "POST-DELAY DAMPING",
        "Darkens each repeat by removing more high frequency energy.");
      index == 26 ? offer_help(hover, "POST-DELAY MIX",
        "Blends the post-delay with dry audio; protected by SAFE RND.");
      index == 27 ? offer_help(hover, "CAULDRON GOLD",
        "Moves the three-band character from clean to crushed.");
      index == 28 ? offer_help(hover, "PRE-DELAY DIFFUSION",
        "Smears pre-delay attacks into a denser echo cloud.");
      index == 29 ? offer_help(hover, "POST-DELAY DIFFUSION",
        "Smears post-delay attacks into a denser echo cloud.");
      index == 30 ? offer_help(hover, "CAULDRON SPREAD",
        "Widens left/right character differences above the bass.");
      index == 31 ? offer_help(hover, "LOW-BAND DRIVE",
        "Drive below 250 Hz. SAFE RND preserves all drive levels.");
      index == 32 ? offer_help(hover, "MID-BAND DRIVE",
        "Drive from 250 Hz to 2.5 kHz; protected by SAFE RND.");
      index == 33 ? offer_help(hover, "HIGH-BAND DRIVE",
        "Drive above 2.5 kHz; protected by SAFE RND.");
      (index == 34 || index == 38 || index == 42 || index == 46)
        ? offer_help(hover, "LFO TARGET",
          "Chooses a Filter or Gate parameter for this LFO.");
      (index == 35 || index == 39 || index == 43 || index == 47)
        ? offer_help(hover, "LFO SHAPE",
          "Chooses sine, triangle, square, saw, or random hold.");
      (index == 36 || index == 40 || index == 44 || index == 48)
        ? offer_help(hover, "LFO RATE",
          "Sets free speed in Hz or the active tempo subdivision.");
      (index == 37 || index == 41 || index == 45 || index == 49)
        ? offer_help(hover, "LFO DEPTH",
          "Sets how strongly this LFO moves its target.");
      index == 50 ? offer_help(hover, "FILTER SWEEP SYNC",
        "Toggles the filter sweep between free Hz and project tempo.");
      index == 51 ? offer_help(hover, "PRE-DELAY LINK",
        "Links left/right time and sync controls.");
      (index == 52 || index == 53) ? offer_help(hover, "PRE-DELAY SYNC",
        "Toggles this time between milliseconds and project tempo.");
      index == 54 ? offer_help(hover, "POST-DELAY LINK",
        "Links left/right time and sync controls.");
      (index == 55 || index == 56) ? offer_help(hover, "POST-DELAY SYNC",
        "Toggles this time between milliseconds and project tempo.");
      (index >= 57 && index <= 60) ? offer_help(hover, "LFO TEMPO SYNC",
        "Toggles the LFO between free Hz and a tempo subdivision.");
      index == 61 ? offer_help(hover, "CAULDRON MIX",
        "Blends the complete Character Cauldron with clean audio.");
      (index == 62 || index == 63) ? offer_help(hover, "FILTER CURVE SHAPE",
        "Choose a generated shape or FREE to draw this curve.");
      index == 64 ? offer_help(hover, "GATE MIX",
        "Blends per-bin gating with the ungated spectrum; SAFE RND protects it.");
      index == 65 ? offer_help(hover, "GATE THRESHOLD",
        "Bins below this detector level move toward the closed range.");
      index == 66 ? offer_help(hover, "GATE RANGE",
        "Maximum attenuation applied when a spectral bin closes.");
      index == 67 ? offer_help(hover, "GATE ATTACK",
        "How quickly bins reopen; resolution is limited by the FFT hop.");
      index == 68 ? offer_help(hover, "GATE RELEASE",
        "How quickly bins close after their level falls.");
      index == 69 ? offer_help(hover, "GATE KNEE",
        "Softens the transition around the spectral threshold.");
      index == 70 ? offer_help(hover, "GATE LOW CUT",
        "Bins below this detector range pass without gating.");
      index == 71 ? offer_help(hover, "GATE HIGH CUT",
        "Bins above this detector range pass without gating.");
      index == 72 ? offer_help(hover, "GATE EDGE WIDTH",
        "Fades gating across the low and high detector boundaries.");
      index == 73 ? offer_help(hover, "GATE DETECTOR TILT",
        "Offsets threshold by octave around 1 kHz.");
      index == 74 ? offer_help(hover, "GATE STEREO LINK",
        "100% shares detection; lower values allow channel independence.");
      index == 75 ? offer_help(hover, "GATE FREQUENCY SMOOTH",
        "Smooths gain across neighboring bins to reduce musical noise.");
      index == 76 ? offer_help(hover, "GATE DRAWING CONTOUR",
        "Scales how strongly the drawn curve offsets threshold.");
      index == 77 ? offer_help(hover, "GATE MORPH A/B",
        "Blends continuously between gate threshold curves A and B.");
      index == 78 ? offer_help(hover, "GATE SHIFT",
        "Moves the drawn gate threshold contour by octaves.");
      index == 79 ? offer_help(hover, "GATE SWEEP DEPTH",
        "Sets automatic octave travel for the gate contour.");
      index == 80 ? offer_help(hover, "GATE SWEEP RATE",
        "Sets gate contour speed in Hz or its synced division.");
      index == 81 ? offer_help(hover, "GATE SWEEP SYNC",
        "Toggles gate sweep between free Hz and project tempo.");
      index == 82 ? offer_help(hover, "GATE HYSTERESIS",
        "Separates opening and closing thresholds to prevent chatter.");
      index == 83 ? offer_help(hover, "GATE HOLD",
        "Keeps a bin open briefly after it drops below threshold.");
      (index == 84 || index == 85) ? offer_help(hover, "GATE CURVE SHAPE",
        "Choose a generated contour or FREE to draw this curve.");
      index == 86 ? offer_help(hover, "GATE MAKEUP",
        "Gain after gating. SAFE RND never changes this control.");
      (index >= 87 && index <= 90) ? offer_help(hover, "LFO TARGET BANK",
        "The target menu automatically selects the Filter or Gate bank.");
      index == 91 ? offer_help(hover, "GATE DETECTOR GAIN",
        "Offsets detector level only; SAFE RND never changes it.");
      index == 92 ? offer_help(hover, "SPECTRAL ORDER",
        "Drag FILTER or GATE to choose their left-to-right processing order.");
    );
  );

  function draw_help_toggle(x, y, width, height)
    local(hover) (
    hover = active_knob == 0 && tab_drag_id == 0
            && mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + height;
    left_pressed && hover ? (
      help_mode = !help_mode;
      button_consumed = 1;
    );
    gfx_r = 0.004; gfx_g = 0.035; gfx_b = 0.016; gfx_a = 0.76;
    gfx_rect(x + 3, y + 3, width, height);
    gfx_r = help_mode ? 1.00 : hover ? 0.56 : 0.08;
    gfx_g = help_mode ? 0.76 : hover ? 1.00 : 0.48;
    gfx_b = help_mode ? 0.08 : hover ? 0.66 : 0.24; gfx_a = 1;
    gfx_rect(x, y, width, height);
    gfx_r = 0.004; gfx_g = 0.035; gfx_b = 0.016; gfx_a = 0.94;
    gfx_rect(x + 3, y + 3, width - 6, height - 6);
    gfx_setfont(3, "Silom", 15, 'b');
    gfx_r = 1; gfx_g = 0.92; gfx_b = 0.38; gfx_a = 1;
    gfx_x = x + width*0.5 - 4; gfx_y = y + 5; gfx_drawstr("?");
    offer_help(hover, "HELP MODE",
      "Click ? to show or hide cursor-following control descriptions.");
  );

  function draw_help_bubble()
    local(box_x, box_y, box_width, box_height, box_min_y, box_max_y) (
    help_mode && help_hovered ? (
      box_width = max(1, min(470, gfx_w - 16));
      box_height = 54;
      box_x = mouse_x + 18;
      box_x + box_width > gfx_w - 8 ? box_x = mouse_x - box_width - 18;
      box_x = min(gfx_w - box_width - 8, max(8, box_x));
      box_y = mouse_y + 22;
      box_y + box_height > gfx_h - 8 ? box_y = mouse_y - box_height - 18;
      box_max_y = max(8, gfx_h - box_height - 8);
      box_min_y = min(70, box_max_y);
      box_y = min(box_max_y, max(box_min_y, box_y));

      gfx_r = 0.002; gfx_g = 0.020; gfx_b = 0.008; gfx_a = 0.68;
      gfx_rect(box_x + 5, box_y + 5, box_width, box_height);
      gfx_r = 1.00; gfx_g = 0.74; gfx_b = 0.06; gfx_a = 1;
      gfx_rect(box_x, box_y, box_width, box_height);
      gfx_r = 0.006; gfx_g = 0.070; gfx_b = 0.030; gfx_a = 1;
      gfx_rect(box_x + 3, box_y + 3, box_width - 6, box_height - 6);
      gfx_r = 0.18; gfx_g = 1.00; gfx_b = 0.64; gfx_a = 1;
      gfx_rect(box_x + 8, box_y + 8, 5, box_height - 16);
      gfx_setfont(3, "Silom", 10, 'b');
      gfx_r = 1.00; gfx_g = 0.94; gfx_b = 0.48; gfx_a = 1;
      gfx_x = box_x + 22; gfx_y = box_y + 8; gfx_drawstr(#help_line_1);
      gfx_setfont(6, "Silom", 8, 'b');
      gfx_r = 0.88; gfx_g = 1.00; gfx_b = 0.86; gfx_a = 1;
      gfx_x = box_x + 22; gfx_y = box_y + 29; gfx_drawstr(#help_line_2);
    );
  );

  // JSFX resolves user functions in declaration order, so this helper must
  // precede themed_knob(), which uses it for the active sync readout.
  function draw_sync_name(value) (
    value == 0 ? gfx_drawstr("FREE");
    value == 1 ? gfx_drawstr("1/32");
    value == 2 ? gfx_drawstr("1/16T");
    value == 3 ? gfx_drawstr("1/16");
    value == 4 ? gfx_drawstr("1/8T");
    value == 5 ? gfx_drawstr("1/8");
    value == 6 ? gfx_drawstr("1/4T");
    value == 7 ? gfx_drawstr("1/4");
    value == 8 ? gfx_drawstr("1/2T");
    value == 9 ? gfx_drawstr("1/2");
    value == 10 ? gfx_drawstr("1 BAR");
    value == 11 ? gfx_drawstr("2 BARS");
    value == 12 ? gfx_drawstr("4 BARS");
  );

  function draw_spectral_shape_name(mode) (
    mode == 0 ? gfx_drawstr("FREE");
    mode == 1 ? gfx_drawstr("SINE");
    mode == 2 ? gfx_drawstr("TRIANGLE");
    mode == 3 ? gfx_drawstr("RECTANGLE");
    mode == 4 ? gfx_drawstr("SAW UP");
    mode == 5 ? gfx_drawstr("SAW DOWN");
    mode == 6 ? gfx_drawstr("RANDOM");
  );

  function spectral_edit_button(which, x, y, width, label, red, green, blue)
    local(hover, selected) (
    hover = mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + 30;
    which ? offer_help(hover, "EDIT CURVE B",
      "Select curve B for drawing, COPY, and FLAT actions.")
      : offer_help(hover, "EDIT CURVE A",
        "Select curve A for drawing, COPY, and FLAT actions.");
    left_pressed && hover ? (
      active_shape = which;
      button_consumed = 1;
    );
    selected = active_shape == which;
    gfx_r = selected ? min(1, red*1.20 + 0.12) : red*0.28;
    gfx_g = selected ? min(1, green*1.20 + 0.12) : green*0.28;
    gfx_b = selected ? min(1, blue*1.20 + 0.12) : blue*0.28; gfx_a = 1;
    gfx_rect(x, y, width, 30);
    gfx_r = 0.006; gfx_g = 0.030; gfx_b = 0.014; gfx_a = 0.90;
    gfx_rect(x + 3, y + 3, width - 6, 24);
    selected ? (
      gfx_r = 1; gfx_g = 0.78; gfx_b = 0.08; gfx_a = 1;
      gfx_rect(x + 3, y + 2, width - 6, 2);
    );
    gfx_setfont(3, "Silom", 10, 'b');
    gfx_r = hover || selected ? 1.00 : 0.72;
    gfx_g = hover || selected ? 0.94 : 0.78;
    gfx_b = hover || selected ? 0.54 : 0.34; gfx_a = 1;
    gfx_x = x + 8; gfx_y = y + 8; gfx_drawstr(label);
  );

  function spectral_shape_dropdown(index, buffer, x, y, width,
                                    red, green, blue)
    local(value, hover, choice) (
    value = slider(index) | 0;
    hover = mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + 30;
    offer_parameter_help(hover, index);
    left_pressed && hover ? (
      gfx_x = x;
      gfx_y = y + 30;
      choice = gfx_showmenu("FREE (DRAW)|SINE|TRIANGLE|RECTANGLE|SAW UP|SAW DOWN|RANDOM STEPS");
      choice > 0 ? (
        value = choice - 1;
        slider_automate(slider(index) = value);
        generate_spectral_shape(buffer, value);
        index == 62 ? last_shape_mode_a = value;
        index == 63 ? last_shape_mode_b = value;
        index == 84 ? last_gate_shape_mode_a = value;
        index == 85 ? last_gate_shape_mode_b = value;
        sliderchange(-1);
      );
      button_consumed = 1;
    );
    gfx_r = red*0.28; gfx_g = green*0.28; gfx_b = blue*0.28; gfx_a = 1;
    gfx_rect(x + 2, y + 3, width, 30);
    gfx_r = hover ? min(1, red*1.18 + 0.08) : red;
    gfx_g = hover ? min(1, green*1.18 + 0.08) : green;
    gfx_b = hover ? min(1, blue*1.18 + 0.08) : blue; gfx_a = 1;
    gfx_rect(x, y, width, 30);
    gfx_r = 0.006; gfx_g = 0.030; gfx_b = 0.014; gfx_a = 0.94;
    gfx_rect(x + 3, y + 3, width - 6, 24);
    gfx_setfont(3, "Silom", 8, 'b');
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.54; gfx_a = 1;
    gfx_x = x + 6; gfx_y = y + 9;
    draw_spectral_shape_name(value);
    gfx_r = 1; gfx_g = 0.72; gfx_b = 0.08; gfx_a = 1;
    gfx_triangle(x + width - 15, y + 11,
                 x + width - 5, y + 11,
                 x + width - 10, y + 18);
  );

  function themed_knob(index, x, y, minimum, maximum, step, label, red, green, blue)
    local(value, shown_value, normalized, hover, new_value, angle, display_value,
          sync_index, rate_sync_index, link_index, partner_index, sync_mode, compact, hit_radius,
          outer_radius, bezel_radius, inner_radius, needle_length, box_half,
          label_left, display_left, click_now, double_click, default_value,
          help_hover) (
    compact = compact_knob_mode >= 0.5;
    hit_radius = compact ? 25 : 30;
    outer_radius = compact ? 22 : 27;
    bezel_radius = compact ? 19 : 23;
    inner_radius = compact ? 14 : 17;
    needle_length = compact ? 14 : 18;
    box_half = compact ? 36 : 46;
    label_left = compact ? 33 : 41;
    display_left = compact ? 18 : 24;
    value = slider(index);
    rate_sync_index = index == 14 ? 50
                      : index == 36 ? 57 : index == 40 ? 58
                      : index == 44 ? 59 : index == 48 ? 60
                      : index == 80 ? 81 : 0;
    sync_index = index == 15 ? 52 : index == 16 ? 53 : index == 21 ? 55 : index == 22 ? 56 : 0;
    link_index = index == 15 || index == 16 ? 51 : index == 21 || index == 22 ? 54 : 0;
    partner_index = index == 15 ? 16 : index == 16 ? 15 : index == 21 ? 22 : index == 22 ? 21 : 0;
    hover = mouse_x >= x - hit_radius && mouse_x <= x + hit_radius
            && mouse_y >= y - hit_radius && mouse_y <= y + hit_radius;
    help_hover = hover || (mouse_x >= x - box_half && mouse_x <= x + box_half
                           && mouse_y >= y + 29 && mouse_y <= y + 60);
    offer_parameter_help(help_hover, index);
    mouse_down && !last_mouse_down && hover ? (
      click_now = time_precise();
      double_click = last_knob_click_index == index
                     && click_now - last_knob_click_time <= 0.36;
      double_click ? (
        default_value = min(maximum, max(minimum, knob_factory_default(index)));
        slider_automate(slider(index) = default_value);
        // A synced knob's factory state is its declared free-time value.
        rate_sync_index > 0 ? slider_automate(slider(rate_sync_index) = 0);
        sync_index > 0 ? slider_automate(slider(sync_index) = 0);
        // Preserve an engaged delay link while making the clicked knob land
        // visibly and audibly on its own factory value.
        link_index > 0 && slider(link_index) >= 0.5 ? (
          slider_automate(slider(partner_index) = default_value);
          index == 15 || index == 16 ? (
            slider_automate(slider52 = 0);
            slider_automate(slider53 = 0);
          ) : (
            slider_automate(slider55 = 0);
            slider_automate(slider56 = 0);
          );
        );
        active_knob = 0;
        last_knob_click_index = -1;
        last_knob_click_time = -10;
        sliderchange(-1);
      ) : (
        active_knob = index;
        knob_drag_origin_y = mouse_y;
        knob_drag_origin_value = value;
        last_knob_click_index = index;
        last_knob_click_time = click_now;
      );
    );
    value = slider(index);
    shown_value = modulated_parameter(index, minimum, maximum, step);
    rate_sync_index > 0 && slider(rate_sync_index) > 0
      ? shown_value = sync_rate(slider(rate_sync_index) | 0, value);
    sync_index > 0 && slider(sync_index) > 0 ? shown_value = sync_seconds(slider(sync_index) | 0)*1000;
    link_index > 0 && slider(link_index) >= 0.5 && (index == 16 || index == 22) ? (
      shown_value = index == 16
                    ? (slider52 > 0 ? sync_seconds(slider52 | 0)*1000 : slider15)
                    : (slider55 > 0 ? sync_seconds(slider55 | 0)*1000 : slider21);
    );
    shown_value = min(maximum, max(minimum, shown_value));
    normalized = (shown_value - minimum) / max(0.0000001, maximum - minimum);
    mouse_down && active_knob == index ? (
      new_value = knob_drag_origin_value
                  + (knob_drag_origin_y - mouse_y) * (maximum - minimum) / 170;
      step > 0 ? new_value = floor(new_value / step + 0.5) * step;
      new_value = min(maximum, max(minimum, new_value));
      rate_sync_index > 0 && slider(rate_sync_index) > 0 ? (
        sync_mode = nearest_sync_mode(1/max(0.0001, new_value));
        slider_automate(slider(rate_sync_index) = sync_mode);
        new_value = min(maximum, sync_rate(sync_mode, new_value));
      );
      sync_index > 0 && slider(sync_index) > 0 ? (
        sync_mode = nearest_sync_mode(new_value/1000);
        slider_automate(slider(sync_index) = sync_mode);
        new_value = min(maximum, sync_seconds(sync_mode)*1000);
      );
      slider_automate(slider(index) = new_value);
      link_index > 0 && slider(link_index) >= 0.5 ? (
        slider_automate(slider(partner_index) = new_value);
        index == 15 || index == 16 ? (
          slider_automate(slider52 = slider(sync_index));
          slider_automate(slider53 = slider(sync_index));
        ) : (
          slider_automate(slider55 = slider(sync_index));
          slider_automate(slider56 = slider(sync_index));
        );
      );
      value = new_value;
      shown_value = rate_sync_index > 0 && slider(rate_sync_index) > 0
                    ? sync_rate(slider(rate_sync_index) | 0, value)
                    : sync_index > 0 && slider(sync_index) > 0
                    ? sync_seconds(slider(sync_index) | 0)*1000
                    : modulated_parameter(index, minimum, maximum, step);
      shown_value = min(maximum, max(minimum, shown_value));
      normalized = (shown_value - minimum) / max(0.0000001, maximum - minimum);
    );

    // Pixel shadow, colored bezel, stepped highlights, and a bright gold needle.
    gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.012; gfx_a = 0.82;
    gfx_circle(x + 4, y + 5, outer_radius, 1, 1);
    gfx_r = red*0.38; gfx_g = green*0.38; gfx_b = blue*0.38; gfx_a = 1;
    gfx_circle(x, y, outer_radius, 1, 1);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = hover || active_knob == index ? 1 : 0.84;
    gfx_circle(x, y, bezel_radius, 1, 1);
    gfx_r = 0.018; gfx_g = 0.075; gfx_b = 0.032; gfx_a = 1;
    gfx_circle(x, y, inner_radius, 1, 1);
    gfx_r = min(1, red*1.35 + 0.08); gfx_g = min(1, green*1.35 + 0.08);
    gfx_b = min(1, blue*1.35 + 0.08); gfx_a = 0.94;
    compact ? (
      gfx_rect(x - 10, y - 12, 6, 3); gfx_rect(x - 13, y - 8, 3, 6);
    ) : (
      gfx_rect(x - 12, y - 15, 7, 4); gfx_rect(x - 16, y - 10, 4, 7);
    );
    angle = $pi * (0.75 + normalized * 1.5);
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.18; gfx_a = 1;
    gfx_line(x, y, x + cos(angle)*needle_length, y + sin(angle)*needle_length, 1);
    gfx_rect(x - 2, y - 2, 4, 4);

    gfx_r = 0.002; gfx_g = 0.018; gfx_b = 0.008; gfx_a = 0.92;
    gfx_rect(x - box_half, y + 29, box_half*2, 31);
    compact ? gfx_setfont(6, "Silom", 8, 'b') : gfx_setfont(6, "Silom", 11, 'b');
    gfx_r = 0.012; gfx_g = 0.045; gfx_b = 0.016; gfx_a = 1;
    gfx_x = x - label_left; gfx_y = y + 33; gfx_drawstr(label);
    gfx_r = 1; gfx_g = 0.93; gfx_b = 0.56; gfx_a = 1;
    gfx_x = x - label_left - 1; gfx_y = y + 31; gfx_drawstr(label);
    gfx_x = x - label_left; gfx_y = y + 31; gfx_drawstr(label);
    gfx_r = 0.96; gfx_g = 1.00; gfx_b = 0.82; gfx_a = 1;
    gfx_x = x - display_left; gfx_y = y + 45;
    rate_sync_index > 0 && slider(rate_sync_index) > 0 ? (
      draw_sync_name(slider(rate_sync_index) | 0);
    ) : sync_index > 0 && slider(sync_index) > 0 ? (
      draw_sync_name(slider(sync_index) | 0);
    ) : index == 6 ? (
      display_value = 2 ^ ((shown_value | 0) + 10);
      gfx_drawnumber(display_value, 0);
    ) : step >= 1 ? gfx_drawnumber(shown_value, 0)
                  : step >= 0.1 ? gfx_drawnumber(shown_value, 1)
                                : gfx_drawnumber(shown_value, 2);
  );

  function draw_gate_target_name(target) (
    target == 0 ? gfx_drawstr("NONE");
    target == 1 ? gfx_drawstr("GATE MIX");
    target == 2 ? gfx_drawstr("GATE THRESHOLD");
    target == 3 ? gfx_drawstr("GATE RANGE");
    target == 4 ? gfx_drawstr("GATE ATTACK");
    target == 5 ? gfx_drawstr("GATE RELEASE");
    target == 6 ? gfx_drawstr("GATE KNEE");
    target == 7 ? gfx_drawstr("GATE LOW CUT");
    target == 8 ? gfx_drawstr("GATE HIGH CUT");
    target == 9 ? gfx_drawstr("GATE EDGE");
    target == 10 ? gfx_drawstr("GATE TILT");
    target == 11 ? gfx_drawstr("GATE LINK");
    target == 12 ? gfx_drawstr("GATE SMOOTH");
    target == 13 ? gfx_drawstr("GATE CONTOUR");
    target == 14 ? gfx_drawstr("GATE MORPH");
    target == 15 ? gfx_drawstr("GATE SHIFT");
    target == 16 ? gfx_drawstr("GATE SWEEP DEPTH");
    target == 17 ? gfx_drawstr("GATE SWEEP RATE");
    target == 18 ? gfx_drawstr("GATE HYSTERESIS");
    target == 19 ? gfx_drawstr("GATE HOLD");
    target == 20 ? gfx_drawstr("GATE MAKEUP");
    target == 21 ? gfx_drawstr("GATE DET GAIN");
  );

  function draw_target_name(target, bank) (
    bank >= 0.5 ? (
      draw_gate_target_name(target);
    ) : (
    target == 0 ? gfx_drawstr("NONE");
    target == 1 ? gfx_drawstr("LOW CUT");
    target == 2 ? gfx_drawstr("HIGH CUT");
    target == 3 ? gfx_drawstr("EDGE WIDTH");
    target == 4 ? gfx_drawstr("SPECTRAL TILT");
    target == 5 ? gfx_drawstr("OUTPUT");
    target == 6 ? gfx_drawstr("FFT SIZE");
    target == 7 ? gfx_drawstr("SMEAR");
    target == 8 ? gfx_drawstr("GRAIN");
    target == 9 ? gfx_drawstr("PHASE SCATTER");
    target == 10 ? gfx_drawstr("FRAME REPEAT");
    target == 11 ? gfx_drawstr("MORPH A/B");
    target == 12 ? gfx_drawstr("DRAWING SHIFT");
    target == 13 ? gfx_drawstr("SWEEP DEPTH");
    target == 14 ? gfx_drawstr("SWEEP RATE");
    target == 15 ? gfx_drawstr("PRE LEFT TIME");
    target == 16 ? gfx_drawstr("PRE RIGHT TIME");
    target == 17 ? gfx_drawstr("PRE FEEDBACK");
    target == 18 ? gfx_drawstr("PRE PINGPONG");
    target == 19 ? gfx_drawstr("PRE DAMPING");
    target == 20 ? gfx_drawstr("PRE MIX");
    target == 21 ? gfx_drawstr("POST LEFT TIME");
    target == 22 ? gfx_drawstr("POST RIGHT TIME");
    target == 23 ? gfx_drawstr("POST FEEDBACK");
    target == 24 ? gfx_drawstr("POST PINGPONG");
    target == 25 ? gfx_drawstr("POST DAMPING");
    target == 26 ? gfx_drawstr("POST MIX");
    target == 27 ? gfx_drawstr("GOLD");
    target == 28 ? gfx_drawstr("PRE DIFFUSION");
    target == 29 ? gfx_drawstr("POST DIFFUSION");
    target == 30 ? gfx_drawstr("DISTORT SPREAD");
    target == 31 ? gfx_drawstr("LOW DRIVE");
    target == 32 ? gfx_drawstr("MID DRIVE");
    target == 33 ? gfx_drawstr("HIGH DRIVE");
    );
  );

  function draw_shape_name(shape) (
    shape == 0 ? gfx_drawstr("SINE");
    shape == 1 ? gfx_drawstr("TRIANGLE");
    shape == 2 ? gfx_drawstr("SQUARE");
    shape == 3 ? gfx_drawstr("SAW UP");
    shape == 4 ? gfx_drawstr("SAW DOWN");
    shape == 5 ? gfx_drawstr("RANDOM HOLD");
  );

  function themed_selector(index, x, y, width, minimum, maximum, label, kind,
                            red, green, blue)
    local(value, hover, choice, selected_value, bank_index, bank_value) (
    value = slider(index) | 0;
    bank_index = index == 34 ? 87 : index == 38 ? 88
                 : index == 42 ? 89 : index == 46 ? 90 : 0;
    bank_value = bank_index > 0 ? slider(bank_index) : 0;
    hover = mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + 32;
    offer_parameter_help(hover, index);
    left_pressed && hover ? (
      gfx_x = x;
      gfx_y = y + 32;
      kind == 0 ? (
        choice = gfx_showmenu("NONE|LOW CUT|HIGH CUT|EDGE WIDTH|SPECTRAL TILT|OUTPUT|FFT SIZE|SMEAR|GRAIN|PHASE SCATTER|FRAME REPEAT|MORPH A/B|DRAWING SHIFT|SWEEP DEPTH|SWEEP RATE|PRE LEFT TIME|PRE RIGHT TIME|PRE FEEDBACK|PRE PINGPONG|PRE DAMPING|PRE MIX|POST LEFT TIME|POST RIGHT TIME|POST FEEDBACK|POST PINGPONG|POST DAMPING|POST MIX|GOLD|PRE DIFFUSION|POST DIFFUSION|DISTORT SPREAD|LOW DRIVE|MID DRIVE|HIGH DRIVE|GATE MIX|GATE THRESHOLD|GATE RANGE|GATE ATTACK|GATE RELEASE|GATE KNEE|GATE LOW CUT|GATE HIGH CUT|GATE EDGE|GATE TILT|GATE LINK|GATE SMOOTH|GATE CONTOUR|GATE MORPH|GATE SHIFT|GATE SWEEP DEPTH|GATE SWEEP RATE|GATE HYSTERESIS|GATE HOLD|GATE MAKEUP|GATE DETECTOR GAIN");
      ) : (
        choice = gfx_showmenu("SINE|TRIANGLE|SQUARE|SAW UP|SAW DOWN|RANDOM HOLD");
      );
      choice > 0 ? (
        kind == 0 && choice > 34 ? (
          selected_value = choice - 34;
          bank_value = 1;
          slider_automate(slider(bank_index) = 1);
        ) : (
          selected_value = min(maximum, max(minimum, minimum + choice - 1));
          kind == 0 && bank_index > 0 ? (
            bank_value = 0;
            slider_automate(slider(bank_index) = 0);
          );
        );
        slider_automate(slider(index) = selected_value);
        value = selected_value;
      );
      button_consumed = 1;
    );
    gfx_r = red*0.30; gfx_g = green*0.30; gfx_b = blue*0.30; gfx_a = 1;
    gfx_rect(x + 3, y + 4, width, 32);
    gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = hover ? 1 : 0.90;
    gfx_rect(x, y, width, 32);
    gfx_r = 0.015; gfx_g = 0.055; gfx_b = 0.020; gfx_a = 0.92;
    gfx_rect(x + 4, y + 4, width - 8, 24);
    gfx_setfont(6, "Silom", 10, 'b');
    gfx_r = min(1, red*1.2 + 0.18); gfx_g = min(1, green*1.2 + 0.18);
    gfx_b = min(1, blue*1.2 + 0.18);
    gfx_x = x + 10; gfx_y = y + 9;
    kind == 0 ? draw_target_name(value, bank_value) : draw_shape_name(value);
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.18; gfx_a = 1;
    gfx_triangle(x + width - 20, y + 12,
                 x + width - 8, y + 12,
                 x + width - 14, y + 20);
    gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.010; gfx_a = 1;
    gfx_x = x + 5; gfx_y = y - 12; gfx_drawstr(label);
    gfx_r = 1; gfx_g = 0.94; gfx_b = 0.58; gfx_a = 1;
    gfx_x = x + 4; gfx_y = y - 14; gfx_drawstr(label);
  );

  function compact_selector(index, x, y, width, label, maximum)
    local(value, hover) (
    value = slider(index) | 0;
    hover = mouse_x >= x && mouse_x < x + width && mouse_y >= y && mouse_y < y + 20;
    offer_parameter_help(hover, index);
    left_pressed && hover ? (
      mouse_x < x + width*0.5 ? value -= 1 : value += 1;
      value < 0 ? value = maximum;
      value > maximum ? value = 0;
      slider_automate(slider(index) = value);
      button_consumed = 1;
    );
    gfx_r = hover ? 0.18 : 0.04; gfx_g = hover ? 0.72 : 0.32; gfx_b = 0.18; gfx_a = 1;
    gfx_rect(x, y, width, 20);
    gfx_setfont(6, "Silom", 9, 'b'); gfx_r = 1; gfx_g = 0.94; gfx_b = 0.48;
    gfx_x = x + 4; gfx_y = y + 5; gfx_drawstr(label); gfx_drawstr(": ");
    maximum == 1 ? (value ? gfx_drawstr("LINK") : gfx_drawstr("FREE")) : draw_sync_name(value);
  );

  function delay_link_button(index, left_time, right_time, left_sync, right_sync,
                             x, y, width) local(hover, linked) (
    linked = slider(index) >= 0.5;
    hover = mouse_x >= x && mouse_x < x + width && mouse_y >= y && mouse_y < y + 20;
    offer_parameter_help(hover, index);
    left_pressed && hover ? (
      linked = !linked;
      slider_automate(slider(index) = linked);
      linked ? (
        slider_automate(slider(right_time) = slider(left_time));
        slider_automate(slider(right_sync) = slider(left_sync));
      );
      button_consumed = 1;
    );
    gfx_r = linked ? 0.10 : 0.025; gfx_g = linked ? 0.92 : 0.24;
    gfx_b = linked ? 0.34 : 0.08; gfx_a = 1; gfx_rect(x, y, width, 20);
    gfx_setfont(6, "Silom", 10, 'b');
    linked ? (
      gfx_r = 0.002; gfx_g = 0.055; gfx_b = 0.018; gfx_a = 1;
    ) : (
      gfx_r = 1; gfx_g = 0.94; gfx_b = 0.48; gfx_a = 1;
    );
    gfx_x = x + 8; gfx_y = y + 5; gfx_drawstr("LINK");
    gfx_x = x + width - 17; gfx_y = y + 5; linked ? gfx_drawstr("ON") : gfx_drawstr("--");
  );

  function sweep_sync_button(sync_index, rate_index, x, y, width)
    local(hover, enabled, mode, rate) (
    enabled = slider(sync_index) > 0;
    hover = mouse_x >= x && mouse_x < x + width && mouse_y >= y && mouse_y < y + 20;
    offer_parameter_help(hover, sync_index);
    left_pressed && hover ? (
      enabled ? slider_automate(slider(sync_index) = 0) : (
        rate = max(0.0001, slider(rate_index));
        mode = nearest_sync_mode(1/rate);
        slider_automate(slider(sync_index) = mode);
        slider_automate(slider(rate_index) = min(10, sync_rate(mode, rate)));
      );
      button_consumed = 1;
    );
    enabled = slider(sync_index) > 0;
    gfx_r = enabled ? 0.52 : 0.055; gfx_g = enabled ? 0.28 : 0.24;
    gfx_b = enabled ? 1.00 : 0.18; gfx_a = 1; gfx_rect(x, y, width, 20);
    gfx_setfont(6, "Silom", 9, 'b'); gfx_r = 1; gfx_g = 0.94; gfx_b = 0.48;
    gfx_x = x + 6; gfx_y = y + 5;
    enabled ? gfx_drawstr("SWEEP SYNC: ON") : gfx_drawstr("SWEEP SYNC: OFF");
  );

  function lfo_sync_button(sync_index, rate_index, x, y, width,
                           red, green, blue) local(hover, enabled, mode, rate) (
    enabled = slider(sync_index) > 0;
    hover = mouse_x >= x && mouse_x < x + width
            && mouse_y >= y && mouse_y < y + 32;
    offer_parameter_help(hover, sync_index);
    left_pressed && hover ? (
      enabled ? slider_automate(slider(sync_index) = 0) : (
        rate = max(0.0001, slider(rate_index));
        mode = nearest_sync_mode(1/rate);
        slider_automate(slider(sync_index) = mode);
        slider_automate(slider(rate_index) = min(20, sync_rate(mode, rate)));
      );
      button_consumed = 1;
    );
    enabled = slider(sync_index) > 0;
    gfx_r = enabled ? min(1, red*0.90 + 0.18) : red*0.22;
    gfx_g = enabled ? min(1, green*0.90 + 0.18) : green*0.22;
    gfx_b = enabled ? min(1, blue*0.90 + 0.18) : blue*0.22;
    gfx_a = 1; gfx_rect(x, y, width, 32);
    gfx_r = 0.012; gfx_g = 0.045; gfx_b = 0.016; gfx_a = 0.94;
    gfx_rect(x + 4, y + 4, width - 8, 24);
    gfx_setfont(6, "Silom", 10, 'b');
    gfx_r = enabled ? 0.20 : 1.00;
    gfx_g = enabled ? 1.00 : 0.94;
    gfx_b = enabled ? 0.62 : 0.48; gfx_a = 1;
    gfx_x = x + 10; gfx_y = y + 9; gfx_drawstr("TEMPO SYNC");
    gfx_x = x + width - 30; gfx_y = y + 9;
    enabled ? gfx_drawstr("ON") : gfx_drawstr("OFF");
  );

  function delay_sync_button(index, time_index, link_index, partner_time,
                             partner_sync, x, y, width, label)
    local(hover, enabled, mode, snapped_ms) (
    enabled = slider(index) > 0;
    hover = mouse_x >= x && mouse_x < x + width && mouse_y >= y && mouse_y < y + 20;
    offer_parameter_help(hover, index);
    left_pressed && hover ? (
      enabled ? slider_automate(slider(index) = 0) : (
        mode = nearest_sync_mode(slider(time_index)/1000);
        snapped_ms = sync_seconds(mode)*1000;
        slider_automate(slider(index) = mode);
        slider_automate(slider(time_index) = snapped_ms);
      );
      slider(link_index) >= 0.5 ? (
        slider_automate(slider(partner_sync) = slider(index));
        slider_automate(slider(partner_time) = slider(time_index));
      );
      button_consumed = 1;
    );
    enabled = slider(index) > 0;
    gfx_r = enabled ? 0.30 : 0.035; gfx_g = enabled ? 0.58 : 0.28;
    gfx_b = enabled ? 1.0 : 0.12; gfx_a = 1; gfx_rect(x, y, width, 20);
    gfx_setfont(6, "Silom", 9, 'b'); gfx_r = 1; gfx_g = 0.94; gfx_b = 0.48;
    gfx_x = x + 5; gfx_y = y + 5; gfx_drawstr(label); gfx_drawstr(" SYNC ");
    enabled ? gfx_drawstr("ON") : gfx_drawstr("OFF");
  );

  function draw_delay_link_visual(left_x, right_x, y, linked) (
    linked ? (
      gfx_r = 0.20; gfx_g = 1.00; gfx_b = 0.42; gfx_a = 1;
      gfx_line(left_x + 27, y, right_x - 27, y, 2);
      gfx_circle(left_x + 31, y, 5, 0, 1);
      gfx_circle(right_x - 31, y, 5, 0, 1);
      gfx_rect((left_x + right_x)*0.5 - 4, y - 4, 8, 8);
    ) : (
      gfx_r = 0.25; gfx_g = 0.38; gfx_b = 0.28; gfx_a = 0.65;
      gfx_line(left_x + 27, y, left_x + 37, y, 1);
      gfx_line(right_x - 37, y, right_x - 27, y, 1);
    );
  );

  function draw_lfo_preview(x, y, width, height, shape, phase_value, random_value,
                            red, green, blue)
    local(point, preview_phase, preview_value, px, py, previous_px, previous_py) (
    offer_help(mouse_x >= x && mouse_x < x + width
               && mouse_y >= y && mouse_y < y + height,
               "LFO PREVIEW", "Shows the selected waveform and its live phase position.");
    gfx_r = 0.005; gfx_g = 0.035; gfx_b = 0.014; gfx_a = 0.90;
    gfx_rect(x, y, width, height);
    gfx_r = red*0.55; gfx_g = green*0.55; gfx_b = blue*0.55; gfx_a = 0.50;
    gfx_line(x, y + height*0.5, x + width, y + height*0.5);
    point = 0;
    loop(64,
      preview_phase = point/63;
      preview_value = lfo_wave(shape, preview_phase, random_value);
      px = x + preview_phase*width;
      py = y + height*0.5 - preview_value*height*0.38;
      point > 0 ? (
        gfx_r = red; gfx_g = green; gfx_b = blue; gfx_a = 1;
        gfx_line(previous_px, previous_py, px, py, 1);
      );
      previous_px = px;
      previous_py = py;
      point += 1;
    );
    gfx_r = 1; gfx_g = 0.84; gfx_b = 0.16; gfx_a = 1;
    gfx_circle(x + phase_value*width,
               y + height*0.5 - lfo_wave(shape, phase_value, random_value)*height*0.38,
               4, 1, 1);
  );

  function draw_lfo_card(x, y, width, height, number,
                         target_index, shape_index, rate_index, depth_index,
                         phase_value, random_value, red, green, blue) (
    number == 1 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 1  //  CLOVER CLOCK");
    number == 2 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 2  //  RAINBOW CLOCK");
    number == 3 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 3  //  GOLD CLOCK");
    number == 4 ? draw_pixel_panel(x, y, width, height, red, green, blue, "LFO 4  //  MOON CLOCK");
    themed_selector(target_index, x + 18, y + 44, 250, 0, 33,
                    "TARGET  //  DROPDOWN", 0, red, green, blue);
    themed_selector(shape_index, x + 282, y + 44, 160, 0, 5,
                    "SHAPE  //  DROPDOWN", 1, red, green, blue);
    themed_knob(rate_index, x + 92, y + 125, 0.05, 20, 0.01,
                "RATE", red, green, blue);
    themed_knob(depth_index, x + 205, y + 125, 0, 100, 0.1,
                "DEPTH %", red, green, blue);
    lfo_sync_button(56 + number, rate_index, x + 285, y + 82,
                    width - 310, red, green, blue);
    draw_lfo_preview(x + 285, y + 118, width - 310, 42,
                     slider(shape_index) | 0, phase_value, random_value,
                     red, green, blue);
  );

  gfx_clear = 0x063A1C;
  margin_left = 58;
  margin_right = 18;
  margin_top = 92;
  margin_bottom = 470;
  graph_width = gfx_w - margin_left - margin_right;
  graph_height = gfx_h - margin_top - margin_bottom;

  gfx_getimgdim(0, landscape_image_width, landscape_image_height);
  landscape_image_loaded = landscape_image_width > 0 && landscape_image_height > 0;
  landscape_image_loaded ? (
    // Cover-crop the original generated artwork at any window aspect ratio.
    landscape_destination_aspect = gfx_w/max(1, gfx_h);
    landscape_source_aspect = landscape_image_width/landscape_image_height;
    landscape_destination_aspect < landscape_source_aspect ? (
      landscape_crop_height = landscape_image_height;
      landscape_crop_width = landscape_crop_height*landscape_destination_aspect;
      landscape_crop_x = (landscape_image_width - landscape_crop_width)*0.5;
      landscape_crop_y = 0;
    ) : (
      landscape_crop_width = landscape_image_width;
      landscape_crop_height = landscape_crop_width/landscape_destination_aspect;
      landscape_crop_x = 0;
      landscape_crop_y = (landscape_image_height - landscape_crop_height)*0.5;
    );
    gfx_a = 1;
    gfx_blit(0, 1, 0,
             landscape_crop_x, landscape_crop_y,
             landscape_crop_width, landscape_crop_height,
             0, 0, gfx_w, gfx_h);
  ) : (
  // Procedural fallback when the optional bundled artwork cannot be loaded.
  // Thirty fine sky bands create a soft, high-bit-depth green-to-apricot sunset.
  gfx_r = 0.025; gfx_g = 0.105; gfx_b = 0.12; gfx_a = 1;
  gfx_rect(0, 0, gfx_w, gfx_h);
  sky_band = 0;
  loop(30,
    sky_fraction = sky_band/29;
    gfx_r = 0.045 + sky_fraction*0.50;
    gfx_g = 0.19 + sky_fraction*0.31;
    gfx_b = 0.25 - sky_fraction*0.055;
    gfx_a = 0.82;
    gfx_rect(0, 350 + sky_band*7, gfx_w, 8);
    sky_band += 1;
  );
  gfx_r = 1.00; gfx_g = 0.70; gfx_b = 0.31; gfx_a = 0.38;
  gfx_circle(166, 493, 58, 1, 1);
  gfx_r = 1.00; gfx_g = 0.90; gfx_b = 0.59; gfx_a = 0.31;
  gfx_circle(166, 493, 39, 1, 1);
  draw_pastoral_cloud(22, 405, 24, 0.64);
  draw_pastoral_cloud(652, 431, 19, 0.47);
  draw_pastoral_cloud(904, 389, 28, 0.48);

  // Distant fantasy range, intentionally generic and softened into the haze.
  draw_pastoral_mountain(-75, 556, 300, 118, 0.15, 0.28, 0.27);
  draw_pastoral_mountain(135, 556, 290, 146, 0.13, 0.31, 0.27);
  draw_pastoral_mountain(365, 556, 270, 104, 0.16, 0.34, 0.27);
  draw_pastoral_mountain(570, 556, 325, 152, 0.13, 0.30, 0.27);
  draw_pastoral_mountain(835, 556, 280, 116, 0.12, 0.29, 0.26);
  draw_pastoral_mountain(1040, 556, 270, 140, 0.14, 0.33, 0.26);
  gfx_r = 0.78; gfx_g = 0.82; gfx_b = 0.66; gfx_a = 0.16;
  gfx_rect(0, 532, gfx_w, 27);

  // Smooth multi-frequency ridges replace the old flat polygons and green lumps.
  draw_rolling_hill(555, 665, 18, 0.45, 0.10, 0.36, 0.14, 0.96, 0.20);
  draw_rolling_hill(606, 744, 31, 2.15, 0.15, 0.50, 0.17, 0.95, 0.18);
  draw_rolling_hill(678, 830, 46, 4.30, 0.11, 0.41, 0.13, 1.00, 0.17);
  draw_rolling_hill(754, 840, 28, 1.18, 0.18, 0.54, 0.16, 0.82, 0.15);

  // Winding lane and stream-like light lead through the fields toward the sunset.
  draw_winding_country_path(548, 836, gfx_w*0.45, gfx_w*0.58, 3, 92);
  gfx_r = 0.56; gfx_g = 0.76; gfx_b = 0.71; gfx_a = 0.20;
  gfx_line(gfx_w*0.43, 558, gfx_w*0.26, 812, 3);
  gfx_r = 0.96; gfx_g = 0.79; gfx_b = 0.43; gfx_a = 0.14;
  gfx_line(gfx_w*0.44, 558, gfx_w*0.30, 812, 1);

  // Hedges follow the contours; tree clusters frame rather than fill the valley.
  hedge = 0;
  loop(42,
    hedge_x = hedge*30 - 28;
    hedge_y = 631 + sin(hedge/41*$pi*2 + 2.15)*15
                    + sin(hedge/41*$pi*5 + 1.35)*5;
    gfx_r = 0.025; gfx_g = 0.23; gfx_b = 0.075; gfx_a = 0.78;
    gfx_circle(hedge_x, hedge_y, 10 + hedge%4, 1, 1);
    gfx_r = 0.30; gfx_g = 0.71; gfx_b = 0.22; gfx_a = 0.28;
    gfx_circle(hedge_x - 3, hedge_y - 4, 4 + hedge%2, 1, 1);
    hedge += 1;
  );
  draw_pastoral_tree(72, 664, 34, 0.10, 0.43, 0.15);
  draw_pastoral_tree(154, 688, 20, 0.15, 0.54, 0.18);
  draw_pastoral_tree(292, 650, 16, 0.13, 0.48, 0.15);
  draw_pastoral_tree(860, 672, 18, 0.12, 0.46, 0.15);
  draw_pastoral_tree(1012, 662, 31, 0.08, 0.39, 0.13);
  draw_pastoral_tree(1112, 695, 21, 0.15, 0.51, 0.17);

  // Foreground stonework, moss, grass, flowers, and restrained magical glints.
  draw_fine_stone_wall(768, 62);
  grass = 0;
  loop(156,
    grass_x = 6 + (grass*67) % max(1, gfx_w - 12);
    grass_y = 650 + (grass*41) % 178;
    grass_scale = 1.2 + (grass_y - 650)/88;
    gfx_r = 0.38; gfx_g = 0.82; gfx_b = 0.23; gfx_a = 0.29;
    gfx_line(grass_x, grass_y, grass_x - grass_scale, grass_y - grass_scale*4, 1);
    gfx_line(grass_x, grass_y, grass_x + grass_scale*1.3, grass_y - grass_scale*3, 1);
    grass % 13 == 0 ? (
      flower_kind = floor(grass/13)%4;
      gfx_r = flower_kind == 0 ? 1 : flower_kind == 1 ? 0.72 : flower_kind == 2 ? 0.98 : 0.80;
      gfx_g = flower_kind == 0 ? 0.84 : flower_kind == 1 ? 0.80 : flower_kind == 2 ? 0.58 : 0.92;
      gfx_b = flower_kind == 0 ? 0.24 : flower_kind == 1 ? 0.98 : flower_kind == 2 ? 0.72 : 1.00;
      gfx_a = 0.62;
      gfx_circle(grass_x, grass_y - grass_scale*4, 1.7, 1, 1);
    );
    grass += 1;
  );
  firefly = 0;
  loop(18,
    firefly_x = 24 + (firefly*149)%max(1, gfx_w - 48);
    firefly_y = 580 + (firefly*37)%150;
    gfx_r = 0.92; gfx_g = 1.00; gfx_b = 0.44; gfx_a = 0.30 + (firefly%3)*0.10;
    gfx_circle(firefly_x, firefly_y, firefly%4 == 0 ? 2.2 : 1.2, 1, 1);
    firefly += 1;
  );
  );

  // The bundled landscape already contains the integrated arch and pots.
  // Retain the procedural scene only as a safe fallback if the image is absent.
  landscape_image_loaded == 0 ? (
    draw_giant_pixel_rainbow(gfx_w*0.5, 805, min(395, gfx_w*0.35), 0.52);
    draw_pot_of_gold(76, 798, 68);
    draw_pot_of_gold(gfx_w - 125, 800, 85);
    draw_coin_trail(38, 810, 6, 15, 5);
    draw_coin_trail(gfx_w - 113, 810, 6, 15, 5);
  );

  draw_leprechaun_hat(14, 27, 47);
  gfx_setfont(1, "Silom", 26, 'b');
  gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.01; gfx_a = 0.9;
  gfx_x = 84; gfx_y = 29; gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_r = 1; gfx_g = 0.78; gfx_b = 0.08; gfx_a = 1;
  gfx_x = 81; gfx_y = 26;
  gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_x = 82; gfx_y = 26;
  gfx_drawstr("LUCKY SPECTRAL LEPRECHAUN");
  gfx_setfont(2, "Silom", 11, 'b');
  gfx_r = 0.005; gfx_g = 0.025; gfx_b = 0.01; gfx_a = 1;
  gfx_x = 84; gfx_y = 58;
  gfx_drawstr("DRAW A POT O' FREQUENCY GOLD  //  EVERY CONTROL IS CUSTOM");
  gfx_r = 0.58; gfx_g = 1.00; gfx_b = 0.68; gfx_a = 1;
  gfx_x = 83; gfx_y = 57;
  gfx_drawstr("DRAW A POT O' FREQUENCY GOLD  //  EVERY CONTROL IS CUSTOM");
  draw_pixel_sparkle(486, 40, 2, 1.00, 0.88, 0.18);
  draw_pixel_sparkle(582, 57, 2, 0.48, 1.00, 0.72);

  // Shape selection, copy, and reset buttons.
  button_y = 34;
  button_h = 30;
  routing_display_order = tab_drag_id > 0
                          ? tab_drag_preview_order : slider92 >= 0.5;
  button_main_w = 56;
  button_gate_w = 68;
  routing_display_order < 0.5 ? (
    button_main_x = 500;
    button_gate_x = 560;
  ) : (
    button_gate_x = 500;
    button_main_x = 572;
  );
  button_lfo_x = 632;
  button_lfo_w = 88;
  button_preset_x = 724;
  button_preset_w = 62;
  button_random_x = gfx_w - 368;
  button_random_w = 58;
  shape_a_edit_x = gfx_w - 306;
  shape_a_menu_x = gfx_w - 280;
  shape_b_edit_x = gfx_w - 204;
  shape_b_menu_x = gfx_w - 178;
  shape_edit_w = 24;
  shape_menu_w = 72;
  button_copy_x = gfx_w - 102;
  button_copy_w = 44;
  button_flat_x = gfx_w - 54;
  button_flat_w = 46;

  left_down = mouse_cap & 1;
  mouse_down = left_down;
  right_down = mouse_cap & 2;
  left_pressed = left_down && !last_left_down;
  left_released = !left_down && last_left_down;
  !left_down ? active_knob = 0;
  button_consumed = 0;
  help_hovered = 0;

  filter_tab_hover = mouse_x >= button_main_x
                     && mouse_x < button_main_x + button_main_w
                     && mouse_y >= button_y && mouse_y < button_y + button_h;
  gate_tab_hover = mouse_x >= button_gate_x
                   && mouse_x < button_gate_x + button_gate_w
                   && mouse_y >= button_y && mouse_y < button_y + button_h;
  lfo_tab_hover = mouse_x >= button_lfo_x
                  && mouse_x < button_lfo_x + button_lfo_w
                  && mouse_y >= button_y && mouse_y < button_y + button_h;
  preset_tab_hover = mouse_x >= button_preset_x
                     && mouse_x < button_preset_x + button_preset_w
                     && mouse_y >= button_y && mouse_y < button_y + button_h;
  offer_help(filter_tab_hover, "FILTER TAB",
    "Click to open Filter; drag horizontally to reorder Filter and Gate.");
  offer_help(gate_tab_hover, "GATE TAB",
    "Click to open Gate; drag left to process Gate before Filter.");
  offer_help(lfo_tab_hover, "LFO GROVE",
    "Opens four LFOs with target, shape, rate, depth, and sync.");
  offer_help(preset_tab_hover, "PRESET VAULT",
    "Opens eight slots stored in this FX instance. Save the REAPER project to keep them.");

  left_pressed && mouse_y >= button_y && mouse_y < button_y + button_h ? (
    mouse_x >= button_main_x && mouse_x < button_main_x + button_main_w ? (
      ui_page = 0;
      preset_editing_name = 0;
      preset_name_select_all = 0;
      preset_edit_just_focused = 0;
      tab_drag_id = 1;
      tab_drag_origin_order = slider92 >= 0.5;
      tab_drag_preview_order = tab_drag_origin_order;
      tab_drag_origin_mouse_x = mouse_x;
      tab_drag_offset_x = mouse_x - button_main_x;
      tab_drag_moved = 0;
      button_consumed = 1;
    );
    mouse_x >= button_gate_x && mouse_x < button_gate_x + button_gate_w ? (
      ui_page = 3;
      preset_editing_name = 0;
      preset_name_select_all = 0;
      preset_edit_just_focused = 0;
      tab_drag_id = 2;
      tab_drag_origin_order = slider92 >= 0.5;
      tab_drag_preview_order = tab_drag_origin_order;
      tab_drag_origin_mouse_x = mouse_x;
      tab_drag_offset_x = mouse_x - button_gate_x;
      tab_drag_moved = 0;
      button_consumed = 1;
    );
    mouse_x >= button_lfo_x && mouse_x < button_lfo_x + button_lfo_w ? (
      ui_page = 1;
      preset_editing_name = 0;
      preset_name_select_all = 0;
      preset_edit_just_focused = 0;
      button_consumed = 1;
    );
    mouse_x >= button_preset_x && mouse_x < button_preset_x + button_preset_w ? (
      ui_page = 2;
      preset_editing_name = 0;
      preset_name_select_all = 0;
      preset_edit_just_focused = 0;
      button_consumed = 1;
    );
  );

  // FILTER and GATE remain ordinary page buttons on a click. A horizontal
  // drag previews their serial order, then commits one automatable topology
  // change on release. Dropping away from the two-tab rail cancels the move.
  tab_drag_id > 0 ? (
    button_consumed = 1;
    left_down ? (
      abs(mouse_x - tab_drag_origin_mouse_x) >= 6 ? tab_drag_moved = 1;
      tab_drag_moved ? (
        dragged_tab_width = tab_drag_id == 1 ? button_main_w : button_gate_w;
        dragged_tab_center = mouse_x - tab_drag_offset_x + dragged_tab_width*0.5;
        dragged_tab_center < 560 ? (
          tab_drag_preview_order = tab_drag_id == 1 ? 0 : 1;
        );
        dragged_tab_center > 568 ? (
          tab_drag_preview_order = tab_drag_id == 1 ? 1 : 0;
        );
      );
    ) : left_released ? (
      tab_drop_valid = mouse_x >= 492 && mouse_x <= 628
                       && mouse_y >= 24 && mouse_y <= 74;
      tab_drag_moved && tab_drop_valid ? (
        tab_drag_preview_order != (slider92 >= 0.5) ? (
          slider_automate(slider92 = tab_drag_preview_order);
          sliderchange(-1);
        );
      ) : (
        // A canceled drop snaps back in this same paint frame rather than
        // briefly displaying a route that was never committed.
        tab_drag_preview_order = tab_drag_origin_order;
        routing_display_order = tab_drag_origin_order;
        routing_display_order < 0.5 ? (
          button_main_x = 500;
          button_gate_x = 560;
        ) : (
          button_gate_x = 500;
          button_main_x = 572;
        );
      );
      tab_drag_id = 0;
      tab_drag_moved = 0;
    );
  );

  gfx_r = ui_page == 0 ? 0.12 : 0.025;
  gfx_g = ui_page == 0 ? 0.86 : 0.25;
  gfx_b = ui_page == 0 ? 0.36 : 0.08;
  gfx_a = 1;
  gfx_rect(button_main_x, button_y, button_main_w, button_h);
  gfx_r = ui_page == 3 ? 1.00 : 0.26;
  gfx_g = ui_page == 3 ? 0.62 : 0.18;
  gfx_b = ui_page == 3 ? 0.04 : 0.03;
  gfx_rect(button_gate_x, button_y, button_gate_w, button_h);
  gfx_r = ui_page == 1 ? 0.74 : 0.16;
  gfx_g = ui_page == 1 ? 0.26 : 0.12;
  gfx_b = ui_page == 1 ? 1.00 : 0.28;
  gfx_rect(button_lfo_x, button_y, button_lfo_w, button_h);
  gfx_r = ui_page == 2 ? 0.92 : 0.22;
  gfx_g = ui_page == 2 ? 0.58 : 0.18;
  gfx_b = ui_page == 2 ? 0.05 : 0.04;
  gfx_rect(button_preset_x, button_y, button_preset_w, button_h);
  // A compact arrow between the movable stages makes left-to-right signal
  // flow explicit even while their colors and positions are swapping.
  stage_left_end = routing_display_order < 0.5
                   ? button_main_x + button_main_w
                   : button_gate_x + button_gate_w;
  gfx_r = 1; gfx_g = 0.86; gfx_b = 0.20; gfx_a = 1;
  gfx_line(stage_left_end, button_y + 15, stage_left_end + 3, button_y + 15);
  gfx_triangle(stage_left_end + 1, button_y + 12,
               stage_left_end + 4, button_y + 15,
               stage_left_end + 1, button_y + 18);
  gfx_r = 1; gfx_g = 0.78; gfx_b = 0.08; gfx_a = 1;
  gfx_line(button_main_x, button_y, button_main_x + button_main_w, button_y);
  gfx_line(button_main_x, button_y + button_h,
           button_main_x + button_main_w, button_y + button_h);
  gfx_line(button_gate_x, button_y, button_gate_x + button_gate_w, button_y);
  gfx_line(button_gate_x, button_y + button_h,
           button_gate_x + button_gate_w, button_y + button_h);
  gfx_line(button_lfo_x, button_y, button_lfo_x + button_lfo_w, button_y);
  gfx_line(button_lfo_x, button_y + button_h,
           button_lfo_x + button_lfo_w, button_y + button_h);
  gfx_line(button_preset_x, button_y, button_preset_x + button_preset_w, button_y);
  gfx_line(button_preset_x, button_y + button_h,
           button_preset_x + button_preset_w, button_y + button_h);
  // Dark inset title rails keep every page name legible over saturated tabs.
  gfx_r = 0.002; gfx_g = 0.016; gfx_b = 0.008; gfx_a = 0.78;
  gfx_rect(button_main_x + 4, button_y + 4, button_main_w - 8, button_h - 8);
  gfx_rect(button_gate_x + 4, button_y + 4, button_gate_w - 8, button_h - 8);
  gfx_rect(button_lfo_x + 4, button_y + 4, button_lfo_w - 8, button_h - 8);
  gfx_rect(button_preset_x + 4, button_y + 4, button_preset_w - 8, button_h - 8);
  tab_drag_id > 0 && tab_drag_moved ? (
    dragged_outline_x = tab_drag_id == 1 ? button_main_x : button_gate_x;
    dragged_outline_w = tab_drag_id == 1 ? button_main_w : button_gate_w;
    gfx_r = 1; gfx_g = 1; gfx_b = 0.58; gfx_a = 1;
    gfx_line(dragged_outline_x, button_y - 2,
             dragged_outline_x + dragged_outline_w, button_y - 2, 1);
    gfx_line(dragged_outline_x, button_y + button_h + 2,
             dragged_outline_x + dragged_outline_w, button_y + button_h + 2, 1);
  );
  gfx_setfont(3, "Silom", 9, 'b');
  gfx_r = 0.002; gfx_g = 0.012; gfx_b = 0.006; gfx_a = 1;
  gfx_x = button_main_x + 5; gfx_y = button_y + 10; gfx_drawstr("FILTER");
  gfx_x = button_gate_x + 15; gfx_y = button_y + 10; gfx_drawstr("GATE");
  gfx_x = button_lfo_x + 9; gfx_y = button_y + 10; gfx_drawstr("LFO GROVE");
  gfx_x = button_preset_x + 7; gfx_y = button_y + 10; gfx_drawstr("PRESETS");
  gfx_r = 1; gfx_g = 0.95; gfx_b = 0.56; gfx_a = 1;
  gfx_x = button_main_x + 4; gfx_y = button_y + 8; gfx_drawstr("FILTER");
  gfx_x = button_gate_x + 14; gfx_y = button_y + 8; gfx_drawstr("GATE");
  gfx_x = button_lfo_x + 8; gfx_y = button_y + 8; gfx_drawstr("LFO GROVE");
  gfx_x = button_preset_x + 6; gfx_y = button_y + 8; gfx_drawstr("PRESETS");

  // The top-right corner is above the packed 30-pixel toolbar, so help adds
  // no layout shift and never competes with draggable routing tabs.
  draw_help_toggle(gfx_w - 42, 3, 30, 27);

  gate_curve_page = ui_page == 3;
  context_shape_a = gate_curve_page ? gate_shape_a : shape_a;
  context_shape_b = gate_curve_page ? gate_shape_b : shape_b;
  context_shape_mode_a = gate_curve_page ? 84 : 62;
  context_shape_mode_b = gate_curve_page ? 85 : 63;

  left_pressed && mouse_y >= button_y && mouse_y < button_y + button_h ? (
    mouse_x >= button_random_x && mouse_x < button_random_x + button_random_w ? (
      gate_curve_page ? randomize_gate_parameters() : randomize_parameters();
      button_consumed = 1;
    );
    mouse_x >= button_copy_x && mouse_x < button_copy_x + button_copy_w ? (
      active_shape ? (
        memcpy(context_shape_a, context_shape_b, shape_point_count);
        slider_automate(slider(context_shape_mode_a)
                        = slider(context_shape_mode_b));
        gate_curve_page
          ? last_gate_shape_mode_a = slider(context_shape_mode_b) | 0
          : last_shape_mode_a = slider(context_shape_mode_b) | 0;
      ) : (
        memcpy(context_shape_b, context_shape_a, shape_point_count);
        slider_automate(slider(context_shape_mode_b)
                        = slider(context_shape_mode_a));
        gate_curve_page
          ? last_gate_shape_mode_b = slider(context_shape_mode_a) | 0
          : last_shape_mode_b = slider(context_shape_mode_a) | 0;
      );
      sliderchange(-1);
      button_consumed = 1;
    );
    mouse_x >= button_flat_x && mouse_x < button_flat_x + button_flat_w ? (
      edit_buffer = active_shape ? context_shape_b : context_shape_a;
      memset(edit_buffer, 0, shape_point_count);
      active_shape ? (
        slider_automate(slider(context_shape_mode_b) = 0);
        gate_curve_page ? last_gate_shape_mode_b = 0 : last_shape_mode_b = 0;
      ) : (
        slider_automate(slider(context_shape_mode_a) = 0);
        gate_curve_page ? last_gate_shape_mode_a = 0 : last_shape_mode_a = 0;
      );
      sliderchange(-1);
      button_consumed = 1;
    );
  );

  spectral_edit_button(0, shape_a_edit_x, button_y, shape_edit_w,
                       "A", 0.10, 0.74, 0.20);
  spectral_shape_dropdown(context_shape_mode_a, context_shape_a,
                          shape_a_menu_x, button_y,
                          shape_menu_w, 0.10, 0.74, 0.20);
  spectral_edit_button(1, shape_b_edit_x, button_y, shape_edit_w,
                       "B", 0.62, 0.18, 0.90);
  spectral_shape_dropdown(context_shape_mode_b, context_shape_b,
                          shape_b_menu_x, button_y,
                          shape_menu_w, 0.62, 0.18, 0.90);

  // Level-safe randomizer plus compact copy/reset controls flank the A/B menus.
  random_hover = mouse_x >= button_random_x && mouse_x < button_random_x + button_random_w
                 && mouse_y >= button_y && mouse_y < button_y + button_h;
  copy_hover = mouse_x >= button_copy_x && mouse_x < button_copy_x + button_copy_w
               && mouse_y >= button_y && mouse_y < button_y + button_h;
  flat_hover = mouse_x >= button_flat_x && mouse_x < button_flat_x + button_flat_w
               && mouse_y >= button_y && mouse_y < button_y + button_h;
  safe_random_blocked = gate_curve_page
                        && time_precise() < safe_random_notice_until;
  safe_random_blocked ? offer_help(random_hover, "SAFE RND PAUSED",
    "Positive Gate Makeup is active; set it to 0 dB or disable Gate Mix.")
    : gate_curve_page ? offer_help(random_hover, "SAFE GATE RANDOM",
    "Randomizes Gate safely; Mix, Makeup, and Detector Gain stay fixed.")
    : offer_help(random_hover, "SAFE FILTER RANDOM",
      "Randomizes a safe whitelist; gain, feedback, tilt, and drive stay fixed.");
  active_shape ? offer_help(copy_hover, "COPY B TO A",
    "Copies curve B and its generated shape mode into curve A.")
    : offer_help(copy_hover, "COPY A TO B",
      "Copies curve A and its generated shape mode into curve B.");
  offer_help(flat_hover, "FLATTEN CURVE",
    "Resets the selected curve to a neutral 0 dB FREE line.");
  gfx_r = safe_random_blocked ? 1.00 : random_hover ? 1.00 : 0.76;
  gfx_g = safe_random_blocked ? 0.48 : random_hover ? 0.30 : 0.08;
  gfx_b = safe_random_blocked ? 0.08 : random_hover ? 0.78 : 0.52; gfx_a = 1;
  gfx_rect(button_random_x, button_y, button_random_w, button_h);
  gfx_r = 0.03; gfx_g = 0.34; gfx_b = 0.11;
  gfx_rect(button_copy_x, button_y, button_copy_w, button_h);
  gfx_rect(button_flat_x, button_y, button_flat_w, button_h);
  gfx_r = 1; gfx_g = 0.75; gfx_b = 0.06;
  gfx_line(button_random_x, button_y, button_random_x + button_random_w, button_y);
  gfx_line(button_random_x + button_random_w, button_y,
           button_random_x + button_random_w, button_y + button_h);
  gfx_line(button_random_x + button_random_w, button_y + button_h,
           button_random_x, button_y + button_h);
  gfx_line(button_random_x, button_y + button_h, button_random_x, button_y);
  gfx_line(button_copy_x, button_y, button_copy_x + button_copy_w, button_y);
  gfx_line(button_copy_x + button_copy_w, button_y,
           button_copy_x + button_copy_w, button_y + button_h);
  gfx_line(button_copy_x + button_copy_w, button_y + button_h,
           button_copy_x, button_y + button_h);
  gfx_line(button_copy_x, button_y + button_h, button_copy_x, button_y);
  gfx_line(button_flat_x, button_y, button_flat_x + button_flat_w, button_y);
  gfx_line(button_flat_x + button_flat_w, button_y,
           button_flat_x + button_flat_w, button_y + button_h);
  gfx_line(button_flat_x + button_flat_w, button_y + button_h,
           button_flat_x, button_y + button_h);
  gfx_line(button_flat_x, button_y + button_h, button_flat_x, button_y);
  gfx_r = 1; gfx_g = 0.91; gfx_b = 0.45;
  safe_random_blocked ? (
    gfx_setfont(3, "Silom", 6, 'b');
    gfx_x = button_random_x + 8; gfx_y = button_y + 5; gfx_drawstr("MAKEUP");
    gfx_x = button_random_x + 15; gfx_y = button_y + 16; gfx_drawstr("LOCK");
  ) : (
    gfx_setfont(3, "Silom", 7, 'b');
    gfx_x = button_random_x + 6; gfx_y = button_y + 10; gfx_drawstr("SAFE RND");
  );
  gfx_setfont(3, "Silom", 9, 'b');
  gfx_x = button_copy_x + 5; gfx_y = button_y + 9; gfx_drawstr("COPY");
  gfx_x = button_flat_x + 6; gfx_y = button_y + 9; gfx_drawstr("FLAT");

  // Layered gold-and-emerald bezel makes the FFT the unmistakable focal point.
  gfx_r = 0.02; gfx_g = 0.48; gfx_b = 0.20; gfx_a = 0.95;
  gfx_rect(margin_left - 11, margin_top - 11, graph_width + 22, 3);
  gfx_rect(margin_left - 11, margin_top + graph_height + 8, graph_width + 22, 3);
  gfx_rect(margin_left - 11, margin_top - 11, 3, graph_height + 22);
  gfx_rect(margin_left + graph_width + 8, margin_top - 11, 3, graph_height + 22);
  gfx_r = 1; gfx_g = 0.74; gfx_b = 0.06; gfx_a = 0.96;
  gfx_rect(margin_left - 8, margin_top - 8, graph_width + 16, 4);
  gfx_rect(margin_left - 8, margin_top + graph_height + 4, graph_width + 16, 4);
  gfx_rect(margin_left - 8, margin_top - 8, 4, graph_height + 16);
  gfx_rect(margin_left + graph_width + 4, margin_top - 8, 4, graph_height + 16);

  // Translucent faceted emerald glass keeps the FFT dominant while allowing
  // the landscape's natural rainbow arc to remain continuous behind it.
  gfx_r = 0.004; gfx_g = 0.075; gfx_b = 0.038; gfx_a = 0.72;
  gfx_rect(margin_left, margin_top, graph_width, graph_height);
  emerald_row = 0;
  loop(10,
    emerald_column = 0;
    loop(34,
      emerald_shade = (emerald_column*5 + emerald_row*7) % 8;
      gfx_r = 0.008 + emerald_shade*0.006;
      gfx_g = 0.12 + emerald_shade*0.027;
      gfx_b = 0.055 + emerald_shade*0.010;
      gfx_a = emerald_shade % 2 ? 0.13 : 0.08;
      tile_x = margin_left + emerald_column*graph_width/34;
      tile_y = margin_top + emerald_row*graph_height/10;
      gfx_rect(tile_x, tile_y, graph_width/34 + 1, graph_height/10 + 1);
      (emerald_column + emerald_row*3) % 7 == 0 ? (
        gfx_r = 0.10; gfx_g = 0.72; gfx_b = 0.30; gfx_a = 0.09;
        gfx_triangle(tile_x, tile_y,
                     tile_x + graph_width/34, tile_y,
                     tile_x + graph_width/34, tile_y + graph_height/10);
      );
      emerald_column += 1;
    );
    emerald_row += 1;
  );
  emerald_glint = 0;
  loop(28,
    glint_x = margin_left + 18 + (emerald_glint*137) % max(1, graph_width - 36);
    glint_y = margin_top + 16 + (emerald_glint*61) % max(1, graph_height - 32);
    glint_size = emerald_glint % 5 == 0 ? 3 : emerald_glint % 3 == 0 ? 2 : 1;
    gfx_r = 0.40; gfx_g = 1.00; gfx_b = 0.62;
    gfx_a = emerald_glint % 4 == 0 ? 0.68 : 0.34;
    gfx_rect(glint_x - glint_size*2, glint_y, glint_size*5, glint_size);
    gfx_rect(glint_x, glint_y - glint_size*2, glint_size, glint_size*5);
    gfx_r = 0.88; gfx_g = 1.00; gfx_b = 0.78; gfx_a = 0.70;
    gfx_rect(glint_x, glint_y, glint_size, glint_size);
    emerald_glint += 1;
  );

  // Live stereo spectrum analyzer. Reuse the analysis magnitudes already
  // produced by the STFT, normalize for the Hann coherent gain, and draw the
  // result behind the editable response curve and grid.
  analysis_point = 0;
  analysis_previous_valid = 0;
  loop(max(1, ceil(graph_width/2)),
    analysis_x_offset = min(graph_width - 1, analysis_point*2);
    analysis_normalized = analysis_x_offset/max(1, graph_width - 1);
    analysis_frequency = 20*exp(log(20000/20)*analysis_normalized);
    analysis_bin_position = min(fftsize/2, analysis_frequency*fftsize/srate);
    analysis_bin_a = floor(analysis_bin_position);
    analysis_bin_b = min(fftsize/2, analysis_bin_a + 1);
    analysis_bin_fraction = analysis_bin_position - analysis_bin_a;
    analysis_left = left_magnitude[analysis_bin_a]*(1 - analysis_bin_fraction)
                    + left_magnitude[analysis_bin_b]*analysis_bin_fraction;
    analysis_right = right_magnitude[analysis_bin_a]*(1 - analysis_bin_fraction)
                     + right_magnitude[analysis_bin_b]*analysis_bin_fraction;
    analysis_magnitude = sqrt(max(0, (analysis_left*analysis_left
                                      + analysis_right*analysis_right)*0.5));
    analysis_db = 20*log(max(0.000000000001,
                             analysis_magnitude*4/max(1, fftsize)))/log(10);
    analysis_db = min(12, max(-60, analysis_db));
    analysis_x = margin_left + analysis_x_offset;
    analysis_y = margin_top + (12 - analysis_db)/72*graph_height;

    gfx_r = 0.05; gfx_g = 0.84; gfx_b = 0.72; gfx_a = 0.13;
    gfx_rect(analysis_x, analysis_y, 2,
             margin_top + graph_height - analysis_y);
    analysis_previous_valid ? (
      gfx_r = 0.01; gfx_g = 0.08; gfx_b = 0.05; gfx_a = 0.92;
      gfx_line(analysis_previous_x, analysis_previous_y + 1,
               analysis_x, analysis_y + 1, 1);
      gfx_r = 0.34; gfx_g = 1.00; gfx_b = 0.82; gfx_a = 0.96;
      gfx_line(analysis_previous_x, analysis_previous_y,
               analysis_x, analysis_y, 1);
    );
    analysis_previous_x = analysis_x;
    analysis_previous_y = analysis_y;
    analysis_previous_valid = 1;
    analysis_point += 1;
  );

  // On the Gate page, overlay the current stereo-average per-bin reduction.
  // It shares the graph's dB scale and stays behind the editable A/B guides.
  gate_curve_page ? (
    gate_plot_point = 0;
    gate_plot_previous_valid = 0;
    loop(max(1, ceil(graph_width/3)),
      gate_plot_x_offset = min(graph_width - 1, gate_plot_point*3);
      gate_plot_normalized = gate_plot_x_offset/max(1, graph_width - 1);
      gate_plot_frequency = 20*exp(log(20000/20)*gate_plot_normalized);
      gate_plot_bin = min(fftsize/2,
                          floor(gate_plot_frequency*fftsize/srate + 0.5));
      gate_plot_db = (gate_gain_left[gate_plot_bin]
                      + gate_gain_right[gate_plot_bin])*0.5*gate_mix;
      gate_plot_db = min(0, max(-60, gate_plot_db));
      gate_plot_x = margin_left + gate_plot_x_offset;
      gate_plot_y = margin_top + (12 - gate_plot_db)/72*graph_height;
      gate_plot_previous_valid ? (
        gfx_r = 1.00; gfx_g = 0.28; gfx_b = 0.08; gfx_a = 0.92;
        gfx_line(gate_plot_previous_x, gate_plot_previous_y,
                 gate_plot_x, gate_plot_y, 2);
      );
      gate_plot_previous_x = gate_plot_x;
      gate_plot_previous_y = gate_plot_y;
      gate_plot_previous_valid = 1;
      gate_plot_point += 1;
    );
  );

  // Opaque label rails prevent the landscape and analyzer from competing
  // with graph scales at any window size.
  gfx_r = 0.002; gfx_g = 0.020; gfx_b = 0.010; gfx_a = 0.94;
  gfx_rect(0, margin_top - 5, margin_left - 4, graph_height + 10);
  gfx_rect(margin_left - 4, margin_top + graph_height + 5,
           graph_width + 8, 21);

  gfx_setfont(4, "Silom", 10, 'b');
  grid_db = 12;
  loop(7,
    grid_y = margin_top + (12 - grid_db) / 72 * graph_height;
    gfx_r = 0.28; gfx_g = 0.62; gfx_b = 0.34; gfx_a = 0.40;
    gfx_line(margin_left, grid_y, margin_left + graph_width, grid_y);
    gfx_r = 1; gfx_g = 0.91; gfx_b = 0.38; gfx_a = 1;
    gfx_x = 7; gfx_y = grid_y - 6;
    gfx_drawnumber(grid_db, 0); gfx_drawstr(" dB");
    grid_db -= 12;
  );

  // Explicit 1/2/5 log-frequency sequence covers the entire audible range.
  // The old multiplier skipped the exact 1k, 10k, and 20k label conditions.
  frequency_step = 0;
  loop(10,
    frequency_label = frequency_step == 0 ? 20
                      : frequency_step == 1 ? 50
                      : frequency_step == 2 ? 100
                      : frequency_step == 3 ? 200
                      : frequency_step == 4 ? 500
                      : frequency_step == 5 ? 1000
                      : frequency_step == 6 ? 2000
                      : frequency_step == 7 ? 5000
                      : frequency_step == 8 ? 10000 : 20000;
    frequency_x = margin_left + log(frequency_label / 20) / log(20000 / 20) * graph_width;
    gfx_r = 0.20; gfx_g = 0.58; gfx_b = 0.30; gfx_a = 0.38;
    gfx_line(frequency_x, margin_top, frequency_x, margin_top + graph_height);
    gfx_r = 1; gfx_g = 0.91; gfx_b = 0.38; gfx_a = 1;
    gfx_x = frequency_x - (frequency_label < 100 ? 8 : 12);
    gfx_y = margin_top + graph_height + 8;
    frequency_label >= 1000 ? (
      gfx_drawnumber(frequency_label / 1000, 0); gfx_drawstr("k");
    ) : gfx_drawnumber(frequency_label, 0);
    frequency_step += 1;
  );
  gfx_r = 1; gfx_g = 0.72; gfx_b = 0.04; gfx_a = 1;
  gfx_line(margin_left, margin_top, margin_left + graph_width, margin_top);
  gfx_line(margin_left + graph_width, margin_top,
           margin_left + graph_width, margin_top + graph_height);
  gfx_line(margin_left + graph_width, margin_top + graph_height,
           margin_left, margin_top + graph_height);
  gfx_line(margin_left, margin_top + graph_height, margin_left, margin_top);

  // Sweep range and current 1 kHz reference. The bracket shows the complete
  // manual-shift +/- sweep-depth travel; the marker follows the audible phase.
  graph_shape_morph = gate_curve_page ? gate_shape_morph : shape_morph;
  graph_manual_shift_octaves = gate_curve_page
                               ? gate_shape_manual_shift_octaves
                               : shape_manual_shift_octaves;
  graph_sweep_depth_octaves = gate_curve_page
                              ? gate_auto_sweep_depth_octaves
                              : auto_sweep_depth_octaves;
  graph_total_shift_octaves = gate_curve_page
                              ? gate_shape_total_shift_octaves
                              : shape_total_shift_octaves;
  sweep_low_octaves = graph_manual_shift_octaves - graph_sweep_depth_octaves;
  sweep_high_octaves = graph_manual_shift_octaves + graph_sweep_depth_octaves;
  sweep_low_frequency = min(20000, max(20, 1000*(2 ^ sweep_low_octaves)));
  sweep_high_frequency = min(20000, max(20, 1000*(2 ^ sweep_high_octaves)));
  sweep_current_frequency = min(20000, max(20, 1000*(2 ^ graph_total_shift_octaves)));
  sweep_low_x = margin_left
                + log(sweep_low_frequency/20)/log(20000/20)*graph_width;
  sweep_high_x = margin_left
                 + log(sweep_high_frequency/20)/log(20000/20)*graph_width;
  sweep_current_x = margin_left
                    + log(sweep_current_frequency/20)/log(20000/20)*graph_width;
  sweep_active = graph_sweep_depth_octaves > 0.0001
                 || abs(graph_manual_shift_octaves) > 0.0001;
  gfx_r = 1.00; gfx_g = 0.38; gfx_b = 0.92;
  gfx_a = sweep_active ? 0.72 : 0.24;
  gfx_line(sweep_low_x, margin_top + 35, sweep_high_x, margin_top + 35, 2);
  gfx_line(sweep_low_x, margin_top + 31, sweep_low_x, margin_top + 40, 2);
  gfx_line(sweep_high_x, margin_top + 31, sweep_high_x, margin_top + 40, 2);
  gfx_r = 0.18; gfx_g = 1.00; gfx_b = 0.88;
  gfx_a = sweep_active ? 0.58 : 0.20;
  gfx_line(sweep_current_x, margin_top + 35,
           sweep_current_x, margin_top + graph_height, 1);
  gfx_triangle(sweep_current_x, margin_top + 31,
               sweep_current_x - 5, margin_top + 39,
               sweep_current_x + 5, margin_top + 39);

  // A and B are each drawn once as source guides. While hand drawing, hide the
  // derived morph response so only the selected guide moves with the gesture;
  // the swept/morphed rainbow response returns immediately on mouse release.
  active_shape_mode = active_shape
                      ? slider(context_shape_mode_b) | 0
                      : slider(context_shape_mode_a) | 0;
  graph_draw_in_progress = active_shape_mode == 0 && (left_down || right_down)
                           && mouse_x >= margin_left
                           && mouse_x < margin_left + graph_width
                           && mouse_y >= margin_top
                           && mouse_y < margin_top + graph_height;
  sweep_octave_span = log(20000/20)/log(2);
  sweep_normalized_offset = graph_total_shift_octaves/sweep_octave_span;
  point = 0;
  loop(max(1, graph_width | 0),
    shape_index = min(shape_point_count - 1,
      floor(point/max(1, graph_width - 1)*(shape_point_count - 1)));
    swept_normalized = min(1, max(0,
      point/max(1, graph_width - 1) - sweep_normalized_offset));
    swept_scaled = swept_normalized*(shape_point_count - 1);
    swept_index_a = floor(swept_scaled);
    swept_index_b = min(shape_point_count - 1, swept_index_a + 1);
    swept_fraction = swept_scaled - swept_index_a;
    current_x = margin_left + point;
    curve_a_value = max(-60, min(12, context_shape_a[shape_index]));
    curve_b_value = max(-60, min(12, context_shape_b[shape_index]));
    swept_curve_a = context_shape_a[swept_index_a]
                    + (context_shape_a[swept_index_b]
                       - context_shape_a[swept_index_a])*swept_fraction;
    swept_curve_b = context_shape_b[swept_index_a]
                    + (context_shape_b[swept_index_b]
                       - context_shape_b[swept_index_a])*swept_fraction;
    curve_morph_value = max(-60, min(12,
      swept_curve_a + (swept_curve_b - swept_curve_a)*graph_shape_morph));
    curve_a_y = margin_top + (12 - curve_a_value)/72*graph_height;
    curve_b_y = margin_top + (12 - curve_b_value)/72*graph_height;
    curve_morph_y = margin_top + (12 - curve_morph_value)/72*graph_height;
    point > 0 ? (
      gfx_r = 0.28; gfx_g = 1.00; gfx_b = 0.52;
      gfx_a = active_shape == 0 ? 0.90 : 0.38;
      gfx_line(previous_x, previous_a_y, current_x, curve_a_y, 1);
      gfx_r = 0.92; gfx_g = 0.42; gfx_b = 1.00;
      gfx_a = active_shape == 1 ? 0.90 : 0.38;
      gfx_line(previous_x, previous_b_y, current_x, curve_b_y, 1);
      !graph_draw_in_progress ? (
        set_rainbow_color(point / max(1, graph_width - 1), 1);
        gfx_line(previous_x, previous_morph_y,
                 current_x, curve_morph_y, 1);
      );
    );
    previous_x = current_x;
    previous_a_y = curve_a_y;
    previous_b_y = curve_b_y;
    previous_morph_y = curve_morph_y;
    point += 1;
  );

  gfx_r = 0.002; gfx_g = 0.018; gfx_b = 0.008; gfx_a = 0.90;
  gfx_rect(margin_left + 6, margin_top + 5, 390, 23);
  gfx_setfont(4, "Silom", 11, 'b');
  gfx_r = active_shape ? 1.00 : 0.58;
  gfx_g = active_shape ? 0.68 : 1.00;
  gfx_b = active_shape ? 1.00 : 0.68;
  gfx_x = margin_left + 10; gfx_y = margin_top + 9;
  active_shape ? gfx_drawstr("EDITING B  //  ") : gfx_drawstr("EDITING A  //  ");
  draw_spectral_shape_name(active_shape_mode);
  gate_curve_page ? gfx_drawstr("  //  GATE") : gfx_drawstr("  //  FILTER");
  gfx_drawstr("  //  MORPH ");
  gfx_drawnumber(graph_shape_morph*100, 0);
  gfx_drawstr("% TO B");

  gfx_r = 0.002; gfx_g = 0.018; gfx_b = 0.008; gfx_a = 0.90;
  gfx_rect(margin_left + graph_width - 282, margin_top + 5, 276, 23);
  gfx_setfont(4, "Silom", 10, 'b');
  gfx_r = 0.28; gfx_g = 1.00; gfx_b = 0.84; gfx_a = 1;
  gfx_x = margin_left + graph_width - 276; gfx_y = margin_top + 9;
  gfx_drawstr("SWEEP ");
  gfx_drawnumber(graph_total_shift_octaves, 2);
  gfx_drawstr(" OCT  //  RANGE +/-");
  gfx_drawnumber(graph_sweep_depth_octaves, 2);

  // Left-drag draws the selected shape; right-drag erases toward 0 dB.
  inside_graph = mouse_x >= margin_left && mouse_x < margin_left + graph_width
                 && mouse_y >= margin_top && mouse_y < margin_top + graph_height;
  gate_curve_page ? offer_help(inside_graph, "GATE THRESHOLD GRAPH",
    "Select A or B and FREE; left-drag draws, right-drag returns to 0 dB.")
    : offer_help(inside_graph, "FILTER RESPONSE GRAPH",
      "Select A or B and FREE; left-drag draws, right-drag returns to 0 dB.");
  inside_graph && (left_down || right_down) && !button_consumed
    && active_knob == 0 && active_shape_mode == 0 ? (
    draw_index = floor((mouse_x - margin_left) / graph_width * shape_point_count);
    draw_index = max(0, min(shape_point_count - 1, draw_index));
    draw_value = right_down ? 0
                 : 12 - (mouse_y - margin_top) / graph_height * 72;
    draw_value = max(-60, min(12, draw_value));
    edit_buffer = active_shape ? context_shape_b : context_shape_a;

    last_draw_index >= 0 && last_draw_index != draw_index ? (
      draw_distance = abs(draw_index - last_draw_index);
      draw_step = draw_index > last_draw_index ? 1 : -1;
      fill_count = 1;
      loop(draw_distance,
        fill_index = last_draw_index + fill_count*draw_step;
        fill_fraction = fill_count / draw_distance;
        edit_buffer[fill_index] = last_draw_value
                                  + (draw_value - last_draw_value)*fill_fraction;
        fill_count += 1;
      );
    ) : edit_buffer[draw_index] = draw_value;

    last_draw_index = draw_index;
    last_draw_value = draw_value;
    drawing_changed = 1;
  ) : last_draw_index = -1;

  input_released = !left_down && !right_down && (last_left_down || last_right_down);
  input_released && drawing_changed ? (
    sliderchange(-1);
    drawing_changed = 0;
  );
  ui_page == 0 ? (
  // Every hidden JSFX slider is represented by a custom 16-bit control.
  draw_pixel_panel(20, 378, 535, 125, 0.01, 0.78, 0.32, "SPECTRAL FILTER");
  themed_knob(1, 70, 435, 10, 1000, 1, "LOW CUT HZ", 0.03, 0.96, 0.42);
  themed_knob(2, 175, 435, 1000, 24000, 10, "HIGH CUT HZ", 0.03, 0.96, 0.42);
  themed_knob(3, 280, 435, 0.1, 4, 0.1, "EDGE OCT", 0.03, 0.96, 0.42);
  themed_knob(4, 385, 435, -12, 12, 0.1, "TILT DB/OCT", 0.03, 0.96, 0.42);
  themed_knob(6, 500, 435, 0, 5, 1, "FFT SIZE", 0.03, 0.96, 0.42);
  draw_pixel_sparkle(536, 394, 2, 0.82, 1.00, 0.36);

  // Master output is deliberately isolated and red so it never gets lost.
  draw_pixel_panel(570, 378, 135, 125, 1.00, 0.16, 0.30, "MASTER OUTPUT");
  themed_knob(5, 630, 435, -24, 12, 0.1, "OUTPUT DB", 1.00, 0.22, 0.38);
  draw_pixel_sparkle(678, 394, 2, 1.00, 0.82, 0.28);

  draw_pixel_panel(710, 378, 430, 125, 1.00, 0.44, 0.01, "FFT DAMAGE");
  themed_knob(7, 755, 435, 0, 100, 1, "SMEAR %", 1.00, 0.58, 0.04);
  themed_knob(8, 860, 435, 0, 100, 1, "GRAIN %", 1.00, 0.58, 0.04);
  themed_knob(9, 965, 435, 0, 100, 1, "PHASE %", 1.00, 0.58, 0.04);
  themed_knob(10, 1070, 435, 0, 4, 1, "REPEAT", 1.00, 0.58, 0.04);

  draw_pixel_panel(20, 515, 460, 125, 0.72, 0.12, 1.00, "DRAWING MAGIC");
  themed_knob(11, 85, 572, 0, 100, 0.1, "MORPH A/B %", 0.88, 0.28, 1.00);
  themed_knob(12, 195, 572, -4, 4, 0.01, "SHIFT OCT", 0.88, 0.28, 1.00);
  themed_knob(13, 305, 572, 0, 4, 0.01, "SWEEP OCT", 0.88, 0.28, 1.00);
  themed_knob(14, 415, 572, 0, 10, 0.01, "SWEEP HZ", 0.88, 0.28, 1.00);
  sweep_sync_button(50, 14, 330, 520, 140);
  draw_pixel_sparkle(458, 531, 2, 1.00, 0.66, 1.00);

  draw_pixel_panel(495, 515, 645, 125, 0.00, 0.82, 0.58, "PRE-DELAY  //  BEFORE THE MAGIC");
  themed_knob(15, 535, 572, 1, 2000, 1, "LEFT MS", 0.04, 1.00, 0.68);
  themed_knob(16, 625, 572, 1, 2000, 1, "RIGHT MS", 0.04, 1.00, 0.68);
  themed_knob(17, 715, 572, 0, 95, 0.1, "FDBK %", 0.04, 1.00, 0.68);
  themed_knob(18, 805, 572, 0, 100, 0.1, "PINGPONG", 0.04, 1.00, 0.68);
  themed_knob(19, 895, 572, 0, 100, 0.1, "DAMP %", 0.04, 1.00, 0.68);
  themed_knob(28, 985, 572, 0, 100, 0.1, "DIFFUSE %", 1.00, 0.34, 0.88);
  themed_knob(20, 1075, 572, 0, 100, 0.1, "MIX %", 0.04, 1.00, 0.68);
  delay_link_button(51, 15, 16, 52, 53, 820, 520, 88);
  delay_sync_button(52, 15, 51, 16, 53, 914, 520, 104, "L");
  delay_sync_button(53, 16, 51, 15, 52, 1024, 520, 104, "R");
  draw_delay_link_visual(535, 625, 572, slider51 >= 0.5);
  draw_pixel_sparkle(1015, 545, 2, 1.00, 0.80, 1.00);
  draw_pixel_sparkle(1030, 620, 1, 0.62, 1.00, 0.92);

  draw_pixel_panel(20, 652, 645, 145, 0.04, 0.46, 1.00, "POST-DELAY  //  AFTER THE MAGIC");
  themed_knob(21, 60, 712, 1, 2000, 1, "LEFT MS", 0.12, 0.64, 1.00);
  themed_knob(22, 150, 712, 1, 2000, 1, "RIGHT MS", 0.12, 0.64, 1.00);
  themed_knob(23, 240, 712, 0, 95, 0.1, "FDBK %", 0.12, 0.64, 1.00);
  themed_knob(24, 330, 712, 0, 100, 0.1, "PINGPONG", 0.12, 0.64, 1.00);
  themed_knob(25, 420, 712, 0, 100, 0.1, "DAMP %", 0.12, 0.64, 1.00);
  themed_knob(29, 510, 712, 0, 100, 0.1, "DIFFUSE %", 1.00, 0.30, 0.82);
  themed_knob(26, 600, 712, 0, 100, 0.1, "MIX %", 0.12, 0.64, 1.00);
  delay_link_button(54, 21, 22, 55, 56, 347, 657, 88);
  delay_sync_button(55, 21, 54, 22, 56, 441, 657, 104, "L");
  delay_sync_button(56, 22, 54, 21, 55, 551, 657, 104, "R");
  draw_delay_link_visual(60, 150, 712, slider54 >= 0.5);
  draw_pixel_sparkle(540, 684, 2, 1.00, 0.82, 1.00);
  draw_pixel_sparkle(555, 770, 1, 0.62, 0.92, 1.00);

  draw_pixel_panel(680, 652, 460, 145, 1.00, 0.68, 0.01, "CHARACTER CAULDRON");
  compact_knob_mode = 1;
  themed_knob(31, 718, 712, 0, 60, 0.1, "LOW DRIVE", 1.00, 0.72, 0.04);
  themed_knob(32, 796, 712, 0, 60, 0.1, "MID DRIVE", 1.00, 0.52, 0.06);
  themed_knob(33, 874, 712, 0, 60, 0.1, "HIGH DRIVE", 1.00, 0.28, 0.18);
  themed_knob(27, 952, 712, 0, 100, 0.1, "GOLD", 1.00, 0.82, 0.04);
  themed_knob(30, 1030, 712, 0, 100, 0.1, "SPREAD %", 1.00, 0.38, 0.66);
  themed_knob(61, 1104, 712, 0, 100, 0.1, "MIX %", 0.22, 1.00, 0.72);
  compact_knob_mode = 0;
  gfx_setfont(6, "Silom", 10, 'b');
  gfx_r = 1; gfx_g = 0.93; gfx_b = 0.54; gfx_a = 1;
  gfx_x = 697; gfx_y = 774;
  gfx_drawstr("250 HZ / 2.5K SPLIT  //  ANCHORED LOWS  //  WIDE MIDS + HIGHS");
  draw_pixel_sparkle(1118, 671, 2, 1.00, 0.92, 0.25);

  ) : ui_page == 3 ? (
  // A fully independent gate control surface. The FFT size remains shared
  // because both processors intentionally run inside the same STFT engine.
  draw_pixel_panel(20, 378, 535, 125, 1.00, 0.48, 0.02, "SPECTRAL GATE");
  themed_knob(70, 70, 435, 20, 1000, 1, "LOW CUT HZ", 1.00, 0.56, 0.04);
  themed_knob(71, 175, 435, 1000, 20000, 10, "HIGH CUT HZ", 1.00, 0.56, 0.04);
  themed_knob(72, 280, 435, 0.1, 4, 0.1, "EDGE OCT", 1.00, 0.56, 0.04);
  themed_knob(65, 385, 435, -96, 0, 0.1, "THRESH DB", 1.00, 0.34, 0.10);
  themed_knob(6, 500, 435, 0, 5, 1, "FFT SIZE", 1.00, 0.56, 0.04);

  draw_pixel_panel(570, 378, 135, 125, 0.98, 0.18, 0.38, "GATE OUTPUT");
  themed_knob(64, 630, 435, 0, 100, 0.1, "MIX %", 1.00, 0.24, 0.46);

  draw_pixel_panel(710, 378, 430, 125, 0.92, 0.34, 0.05, "GATE DYNAMICS");
  compact_knob_mode = 1;
  themed_knob(66, 750, 435, 0, 96, 0.1, "RANGE DB", 1.00, 0.54, 0.04);
  themed_knob(67, 830, 435, 0.5, 500, 0.1, "ATTACK MS", 1.00, 0.40, 0.06);
  themed_knob(83, 910, 435, 0, 1000, 1, "HOLD MS", 1.00, 0.72, 0.06);
  themed_knob(68, 990, 435, 5, 5000, 1, "RELEASE MS", 0.96, 0.24, 0.12);
  themed_knob(69, 1070, 435, 0, 24, 0.1, "KNEE DB", 1.00, 0.44, 0.16);
  compact_knob_mode = 0;

  draw_pixel_panel(20, 515, 560, 125, 0.74, 0.12, 1.00,
                   "GATE DRAWING  //  THRESHOLD CONTOUR");
  themed_knob(77, 65, 572, 0, 100, 0.1, "MORPH A/B %", 0.88, 0.28, 1.00);
  themed_knob(78, 170, 572, -4, 4, 0.01, "SHIFT OCT", 0.88, 0.28, 1.00);
  themed_knob(79, 275, 572, 0, 4, 0.01, "SWEEP OCT", 0.88, 0.28, 1.00);
  themed_knob(80, 380, 572, 0, 10, 0.01, "SWEEP HZ", 0.88, 0.28, 1.00);
  themed_knob(76, 485, 572, 0, 100, 0.1, "CONTOUR %", 0.96, 0.34, 1.00);
  sweep_sync_button(81, 80, 430, 520, 140);

  draw_pixel_panel(595, 515, 545, 125, 0.02, 0.78, 0.68, "STEREO DETECTOR");
  themed_knob(73, 640, 572, -12, 12, 0.1, "TILT DB/OCT", 0.06, 1.00, 0.78);
  themed_knob(74, 745, 572, 0, 100, 0.1, "LINK %", 0.06, 1.00, 0.78);
  themed_knob(75, 850, 572, 0, 100, 0.1, "SMOOTH %", 0.06, 1.00, 0.78);
  themed_knob(82, 955, 572, 0, 24, 0.1, "HYST DB", 0.06, 1.00, 0.78);
  themed_knob(91, 1060, 572, -24, 24, 0.1, "DET GAIN DB", 0.06, 1.00, 0.78);

  draw_pixel_panel(20, 652, 1120, 145, 1.00, 0.34, 0.04,
                   "SPECTRAL GATE ACTIVITY  //  PER-BIN GAIN REDUCTION");
  themed_knob(86, 75, 712, -12, 24, 0.1, "MAKEUP DB", 1.00, 0.30, 0.12);
  activity_x = 145; activity_y = 684; activity_w = 960; activity_h = 78;
  offer_help(mouse_x >= activity_x && mouse_x < activity_x + activity_w
             && mouse_y >= activity_y && mouse_y < activity_y + activity_h,
             "GATE ACTIVITY",
             "Shows live left/right per-bin gain reduction across frequency.");
  gfx_r = 0.002; gfx_g = 0.020; gfx_b = 0.010; gfx_a = 0.94;
  gfx_rect(activity_x, activity_y, activity_w, activity_h);
  gfx_r = 1.00; gfx_g = 0.68; gfx_b = 0.08; gfx_a = 0.28;
  gfx_line(activity_x, activity_y + 3, activity_x + activity_w, activity_y + 3);
  gfx_line(activity_x, activity_y + activity_h - 3,
           activity_x + activity_w, activity_y + activity_h - 3);
  activity_point = 0;
  activity_previous_valid = 0;
  activity_range_db = max(12, gate_range_db);
  loop(max(1, ceil(activity_w/4)),
    activity_offset = min(activity_w - 1, activity_point*4);
    activity_normalized = activity_offset/max(1, activity_w - 1);
    activity_frequency = 20*exp(log(20000/20)*activity_normalized);
    activity_bin = min(fftsize/2,
                       floor(activity_frequency*fftsize/srate + 0.5));
    activity_left_y = activity_y + 3
                      + (-gate_gain_left[activity_bin]/activity_range_db)
                        *(activity_h - 6);
    activity_right_y = activity_y + 3
                       + (-gate_gain_right[activity_bin]/activity_range_db)
                         *(activity_h - 6);
    activity_current_x = activity_x + activity_offset;
    activity_previous_valid ? (
      gfx_r = 0.20; gfx_g = 1.00; gfx_b = 0.64; gfx_a = 0.92;
      gfx_line(activity_previous_x, activity_previous_left_y,
               activity_current_x, activity_left_y, 1);
      gfx_r = 1.00; gfx_g = 0.34; gfx_b = 0.82; gfx_a = 0.92;
      gfx_line(activity_previous_x, activity_previous_right_y,
               activity_current_x, activity_right_y, 1);
    );
    activity_previous_x = activity_current_x;
    activity_previous_left_y = activity_left_y;
    activity_previous_right_y = activity_right_y;
    activity_previous_valid = 1;
    activity_point += 1;
  );
  gfx_setfont(6, "Silom", 9, 'b');
  gfx_r = 0.20; gfx_g = 1.00; gfx_b = 0.64; gfx_a = 1;
  gfx_x = activity_x + 8; gfx_y = activity_y + 8; gfx_drawstr("L");
  gfx_r = 1.00; gfx_g = 0.34; gfx_b = 0.82;
  gfx_x = activity_x + 26; gfx_y = activity_y + 8; gfx_drawstr("R");
  gfx_r = 1.00; gfx_g = 0.90; gfx_b = 0.42;
  gfx_x = activity_x + activity_w - 178; gfx_y = activity_y + 8;
  gfx_drawstr("AVG REDUCTION ");
  gfx_drawnumber(-gate_activity_db*gate_mix, 1); gfx_drawstr(" DB");

  ) : ui_page == 1 ? (
  draw_lfo_card(20, 378, 550, 188, 1, 34, 35, 36, 37,
                lfo1_phase, lfo1_random, 0.04, 0.92, 0.34);
  draw_lfo_card(590, 378, 550, 188, 2, 38, 39, 40, 41,
                lfo2_phase, lfo2_random, 0.98, 0.22, 0.62);
  draw_lfo_card(20, 572, 550, 188, 3, 42, 43, 44, 45,
                lfo3_phase, lfo3_random, 1.00, 0.66, 0.03);
  draw_lfo_card(590, 572, 550, 188, 4, 46, 47, 48, 49,
                lfo4_phase, lfo4_random, 0.48, 0.28, 1.00);
  draw_gold_coin(540, 764, 5);
  draw_gold_coin(658, 764, 4);
  ) : (
  draw_pixel_panel(110, 390, 940, 390, 1.00, 0.62, 0.04, "USER PRESET VAULT  //  8 INSTANCE SLOTS  //  SAVE REAPER PROJECT TO KEEP");
  preset_row = 0;
  loop(preset_slot_count,
    preset_x = 145 + (preset_row % 2)*440;
    preset_y = 440 + floor(preset_row/2)*55;
    preset_hover = mouse_x >= preset_x && mouse_x < preset_x + 410
                   && mouse_y >= preset_y && mouse_y < preset_y + 42;
    offer_help(preset_hover, "LUCKY SLOT",
      "Select a slot, edit its name, then SAVE. Slots belong to this FX instance.");
    left_pressed && preset_hover ? (
      preset_selected = preset_row;
      preset_valid[preset_selected] ? strcpy(#preset_name_input, preset_names + preset_selected)
                                    : sprintf(#preset_name_input, "Lucky Slot %d", preset_selected + 1);
      sanitize_preset_name();
      preset_editing_name = 0;
      preset_name_select_all = 0;
      preset_edit_just_focused = 0;
      button_consumed = 1;
    );
    gfx_r = preset_selected == preset_row ? 0.92 : preset_hover ? 0.34 : 0.08;
    gfx_g = preset_selected == preset_row ? 0.58 : preset_hover ? 0.48 : 0.26;
    gfx_b = preset_selected == preset_row ? 0.05 : 0.12; gfx_a = 1;
    gfx_rect(preset_x, preset_y, 410, 42);
    gfx_setfont(6, "Silom", 11, 'b'); gfx_r = 1; gfx_g = 0.88; gfx_b = 0.28;
    gfx_x = preset_x + 12; gfx_y = preset_y + 12;
    gfx_drawnumber(preset_row + 1, 0); gfx_drawstr("  //  ");
    preset_valid[preset_row] ? gfx_drawstr(preset_names + preset_row) : gfx_drawstr("EMPTY CHARM");
    preset_row += 1;
  );

  name_x = 145; name_y = 680; name_w = 560;
  name_hover = mouse_x >= name_x && mouse_x < name_x + name_w
               && mouse_y >= name_y && mouse_y < name_y + 38;
  offer_help(name_hover, "PRESET NAME",
    "Click to select the name; typing replaces it. Delete erases it.");
  left_pressed && name_hover ? (
    sanitize_preset_name();
    strcpy(#preset_name_before_edit, #preset_name_input);
    preset_editing_name = 1;
    preset_name_select_all = 1;
    preset_edit_just_focused = 1;
    button_consumed = 1;
  );
  left_pressed && preset_editing_name && !name_hover ? (
    preset_editing_name = 0;
    preset_name_select_all = 0;
    preset_edit_just_focused = 0;
  );
  gfx_r = preset_editing_name ? (preset_name_select_all ? 0.34 : 0.18) : 0.025;
  gfx_g = preset_editing_name ? 0.62 : 0.22;
  gfx_b = 0.10; gfx_a = 1; gfx_rect(name_x, name_y, name_w, 38);
  gfx_setfont(6, "Silom", 11, 'b'); gfx_r = 1; gfx_g = 0.86; gfx_b = 0.22;
  gfx_x = name_x + 10; gfx_y = name_y + 11;
  preset_editing_name && preset_name_select_all ? gfx_drawstr("NAME [ALL]: ")
                                                  : gfx_drawstr("NAME: ");
  gfx_drawstr(#preset_name_input);
  preset_editing_name ? gfx_drawstr("_");

  save_x = 725; recall_x = 860; action_y = 680;
  save_hover = mouse_x >= save_x && mouse_x < save_x + 120 && mouse_y >= action_y && mouse_y < action_y + 38;
  recall_hover = mouse_x >= recall_x && mouse_x < recall_x + 150 && mouse_y >= action_y && mouse_y < action_y + 38;
  offer_help(save_hover, "SAVE LUCKY SLOT",
    "Stores this sound in the FX instance. Save the REAPER project for disk persistence.");
  offer_help(recall_hover, "RECALL LUCKY SLOT",
    "Loads the selected slot and its saved spectral route.");
  left_pressed && save_hover ? (
    store_user_preset(preset_selected);
    preset_editing_name = 0;
    preset_name_select_all = 0;
    preset_edit_just_focused = 0;
    button_consumed = 1;
  );
  left_pressed && recall_hover ? (
    recall_user_preset(preset_selected);
    preset_editing_name = 0;
    preset_name_select_all = 0;
    preset_edit_just_focused = 0;
    button_consumed = 1;
  );
  gfx_r = save_hover ? 0.18 : 0.04; gfx_g = save_hover ? 0.90 : 0.50; gfx_b = 0.22; gfx_rect(save_x, action_y, 120, 38);
  gfx_r = recall_hover ? 0.40 : 0.14; gfx_g = recall_hover ? 0.56 : 0.28; gfx_b = recall_hover ? 1.0 : 0.68; gfx_rect(recall_x, action_y, 150, 38);
  gfx_setfont(6, "Silom", 11, 'b'); gfx_r = 1; gfx_g = 0.88; gfx_b = 0.28;
  gfx_x = save_x + 26; gfx_y = action_y + 11; gfx_drawstr("SAVE");
  gfx_x = recall_x + 28; gfx_y = action_y + 11; gfx_drawstr("RECALL");
  gfx_x = 145; gfx_y = 735;
  preset_save_notice_frames > 0 ? (
    gfx_r = 0.22; gfx_g = 1.00; gfx_b = 0.62;
    gfx_drawstr("SLOT ");
    gfx_drawnumber(preset_last_saved_slot + 1, 0);
    gfx_drawstr(" SAVED IN THIS INSTANCE  //  SAVE THE REAPER PROJECT TO KEEP IT");
    preset_save_notice_frames -= 1;
  ) : (
    gfx_drawstr("CLICK NAME: TYPE REPLACES  //  DELETE ERASES  //  ENTER ACCEPTS  //  SAVE");
  );

  preset_editing_name ? (
    key = gfx_getchar();
    key_count = 0;
    while (key > 0 && key_count < 64 && preset_editing_name) (
      !preset_edit_just_focused ? (
        key == 1 ? preset_name_select_all = 1
        : (key == 8 || key == 127 || key == 6579564) ? (
            preset_name_select_all ? (
              strcpy(#preset_name_input, "");
              preset_name_select_all = 0;
            ) : (
              name_length = sanitize_preset_name();
              name_length > 0 ? set_preset_name_length(name_length - 1);
            );
          )
        : key == 13 ? (
            preset_editing_name = 0;
            preset_name_select_all = 0;
          )
        : key == 27 ? (
            strcpy(#preset_name_input, #preset_name_before_edit);
            preset_editing_name = 0;
            preset_name_select_all = 0;
          )
        : key >= 32 && key <= 126 ? (
            preset_name_select_all ? (
              strcpy(#preset_name_input, "");
              preset_name_select_all = 0;
            );
            name_length = sanitize_preset_name();
            name_length < preset_name_max_length ? (
              str_setchar(#preset_name_input, name_length, key);
            );
          );
      );
      key_count += 1;
      key = preset_editing_name ? gfx_getchar() : 0;
    );
    preset_edit_just_focused = 0;
  );
  );

  gfx_r = 0.002; gfx_g = 0.018; gfx_b = 0.008; gfx_a = 0.94;
  gfx_rect(0, gfx_h - 28, gfx_w, 28);
  draw_shamrock(25, gfx_h - 20, 7);
  gfx_setfont(4, "Silom", 10, 'b');
  gfx_r = 1; gfx_g = 0.91; gfx_b = 0.38; gfx_a = 1;
  gfx_x = margin_left;
  gfx_y = gfx_h - 18;
  gfx_drawstr("L/R DRAG GRAPH   //   FFT ");
  gfx_drawnumber(fftsize, 0);
  gfx_drawstr("   //   ");
  gfx_drawnumber(fftsize / srate * 1000, 1);
  gfx_drawstr(" ms   //   UI 5.2.2   //   SAFE RND + HOVER HELP   //   ROUTE ");
  slider92 >= 0.5 ? gfx_drawstr("GATE > FILTER")
                   : gfx_drawstr("FILTER > GATE");
  gfx_drawstr("   //   DRAG TABS TO REORDER");

  // Paint help over every page, graph, and footer element.
  draw_help_bubble();
  last_mouse_y = mouse_y;
  last_mouse_down = mouse_down;
  last_left_down = left_down;
  last_right_down = right_down;
